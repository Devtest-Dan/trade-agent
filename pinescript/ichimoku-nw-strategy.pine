//
// Ichimoku Kinko Hyo (Nadaraya–Watson) — Strategy
// -----------------------------------------------
// Trades the NWE-Ichimoku indicator (see ichimoku-nw.pine) with a
// timeframe-adaptive entry filter:
//   • ≤ H1 timeframes:  3-line filter (TK cross + price/cloud + future cloud + Chikou)
//   • ≥ H4 timeframes:  2-line filter (TK cross + price/cloud)
// Exits: opposite TK cross OR price closes through Kijun against position.
// Stops: implicit via Kijun-close exit (no fixed-tick SL).
//
// Rational Quadratic Kernel reused from jdehorty (MPL 2.0).

//@version=6
strategy(
     title             = 'Ichimoku-NW Strategy',
     shorttitle        = 'Ichimoku-NW Strat',
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 5,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.05,
     slippage          = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_bars_back     = 500)

// ─────────────────── Ichimoku & Kernel Inputs ───────────────────
int   tenkanLen = input.int(9,   'Tenkan length', minval=2, group='Ichimoku Settings')
int   kijunLen  = input.int(26,  'Kijun length',  minval=2, group='Ichimoku Settings')
int   spanBLen  = input.int(52,  'Span B length', minval=2, group='Ichimoku Settings')
int   disp      = input.int(26,  'Displacement',  minval=1, group='Ichimoku Settings')

float r   = input.float(8.0, 'Relative Weighting (r)', step=0.25, minval=0.25, group='Kernel Settings')
int   x_0 = input.int(25,    'Start Regression at Bar (x_0)', minval=0, group='Kernel Settings')

// Volatility bands around Kijun (extreme-move detector)
int   atrLength = input.int(20,  'ATR length',         minval=2, group='Bands')
float bandK     = input.float(2.3, 'Band multiplier (k)', minval=0.5, step=0.1, group='Bands',
     tooltip='Bands = Kijun ± k × ATR. Used by the optional band-extreme exit. Higher k = wider bands, fewer extreme-move exits.')

// ─────────────────── Strategy Inputs ───────────────────
bool   tradeLongs  = input.bool(true,  'Trade longs',  group='Strategy')
bool   tradeShorts = input.bool(true,  'Trade shorts', group='Strategy')

// Timeframe override — usually keep "Auto", but allows manual testing.
string tfMode = input.string('Auto (TF-based)', 'Filter mode',
     options=['Auto (TF-based)', 'Force 3-line', 'Force 2-line'], group='Strategy',
     tooltip='Auto picks 3-line for ≤H1 and 2-line for ≥H4. Override here to test the alternative on any chart.')

// Exit toggles
bool exitOnTkCross = input.bool(true,  'Exit on opposite TK cross', group='Exits')
bool exitOnKijun   = input.bool(true,  'Exit on Kijun close-through', group='Exits',
     tooltip='Closes the trade when price closes below Kijun (longs) or above Kijun (shorts). Acts as a soft stop.')
bool exitOnBand    = input.bool(false, 'Exit on band extreme', group='Exits',
     tooltip='Take profit when close > upper band (longs) or close < lower band (shorts). Best on mean-reverting / spike-prone instruments. Cuts winners on strong trends — off by default.')

// Date range filter — for testing specific historical periods.
bool useDateFilter = input.bool(false, 'Use date range', group='Backtest Window')
int  startYear     = input.int(2020, 'Start year',  minval=1970, group='Backtest Window')
int  endYear       = input.int(2030, 'End year',    minval=1970, group='Backtest Window')

// ─────────────────── Kernel ───────────────────
kernel_regression(series float _src, simple int _h) =>
    int   lookback = math.max(1 + x_0, math.round(5.0 * _h))
    float h2  = float(_h) * float(_h)
    float num = 0.0
    float den = 0.0
    for i = 0 to lookback
        float y = _src[i]
        if not na(y)
            float i2 = float(i) * float(i)
            float w  = math.pow(1.0 + i2 / (h2 * 2.0 * r), -r)
            num += y * w
            den += w
    den == 0.0 ? na : num / den

nw_mid(simple int _h) =>
    (kernel_regression(high, _h) + kernel_regression(low, _h)) / 2.0

// ─────────────────── Ichimoku lines ───────────────────
float tenkan = nw_mid(tenkanLen)
float kijun  = nw_mid(kijunLen)
float spanA  = (tenkan + kijun) / 2.0
float spanB  = nw_mid(spanBLen)

// ─────────────────── Volatility bands ───────────────────
float atrVal    = ta.atr(atrLength)
float upperBand = kijun + bandK * atrVal
float lowerBand = kijun - bandK * atrVal

// ─────────────────── Timeframe detection ───────────────────
// H1 = 3600 seconds. Anything ≤ 3600 uses 3-line filter; anything > 3600 uses 2-line.
int  tfSeconds = timeframe.in_seconds()
bool useThreeLine = switch tfMode
    'Force 3-line' => true
    'Force 2-line' => false
    => tfSeconds <= 3600   // Auto

string filterModeStr = useThreeLine ? '3-line filter (TK + cloud + future cloud + Chikou)' : '2-line filter (TK + cloud)'

// ─────────────────── Entry filters ───────────────────
// All conditions evaluated at bar close.

// 1. TK cross trigger
bool bullCross = ta.crossover(tenkan, kijun)
bool bearCross = ta.crossunder(tenkan, kijun)

// 2. Price vs current visible cloud (the kumo at the current bar was projected
//    from disp bars ago, so we look back by disp to read what's overhead now).
float topCloudNow    = math.max(spanA[disp], spanB[disp])
float bottomCloudNow = math.min(spanA[disp], spanB[disp])
bool  aboveCloud     = not na(topCloudNow)    and close > topCloudNow
bool  belowCloud     = not na(bottomCloudNow) and close < bottomCloudNow

// 3. Future cloud bias (spanA vs spanB at the current bar = cloud projected disp ahead)
bool bullFutureCloud = spanA > spanB
bool bearFutureCloud = spanA < spanB

// 4. Chikou clear of past candles (close[0] vs high/low[disp])
bool chikouClearLong  = not na(high[disp]) and close > high[disp]
bool chikouClearShort = not na(low[disp])  and close < low[disp]

// Compose entries per filter mode
bool longEntry = useThreeLine
     ? (bullCross and aboveCloud and bullFutureCloud and chikouClearLong)
     : (bullCross and aboveCloud)
bool shortEntry = useThreeLine
     ? (bearCross and belowCloud and bearFutureCloud and chikouClearShort)
     : (bearCross and belowCloud)

// ─────────────────── Exit conditions ───────────────────
bool longExit  = (exitOnTkCross and bearCross) or (exitOnKijun and close < kijun) or (exitOnBand and close > upperBand)
bool shortExit = (exitOnTkCross and bullCross) or (exitOnKijun and close > kijun) or (exitOnBand and close < lowerBand)

// ─────────────────── Backtest window ───────────────────
bool inWindow = not useDateFilter or (year >= startYear and year <= endYear)

// ─────────────────── Strategy execution ───────────────────
if inWindow
    if tradeLongs and longEntry
        strategy.entry('Long', strategy.long)
    if tradeShorts and shortEntry
        strategy.entry('Short', strategy.short)
    if longExit
        strategy.close('Long', comment='Exit Long')
    if shortExit
        strategy.close('Short', comment='Exit Short')

// ─────────────────── Plots (mirror the indicator) ───────────────────
plot(tenkan, 'Tenkan', color=color.new(#2962FF, 0), linewidth=2)
plot(kijun,  'Kijun',  color=color.new(#B71C1C, 0), linewidth=2)

pA = plot(spanA, 'Span A', offset=disp, color=color.new(#26A69A, 30), linewidth=1)
pB = plot(spanB, 'Span B', offset=disp, color=color.new(#EF5350, 30), linewidth=1)
fill(pA, pB, color = spanA > spanB ? color.new(#26A69A, 80) : color.new(#EF5350, 80), title='Kumo')

plot(close, 'Chikou', color=color.new(#43A047, 0), offset=-disp, linewidth=1)

// Volatility bands — drawn so you can see when band exits trigger
plot(upperBand, 'Upper Band', color=color.new(#FFA726, 0), linewidth=1)
plot(lowerBand, 'Lower Band', color=color.new(#FFA726, 0), linewidth=1)

// Regime tint
bgcolor(aboveCloud ? color.new(#26A69A, 92) : na, title='Above cloud')
bgcolor(belowCloud ? color.new(#EF5350, 92) : na, title='Below cloud')

// TK markers (visual reference; entry markers come from strategy.entry automatically)
plotshape(bullCross, title='TK bull cross', style=shape.triangleup,   location=location.belowbar, color=color.new(#26A69A, 0), size=size.tiny)
plotshape(bearCross, title='TK bear cross', style=shape.triangledown, location=location.abovebar, color=color.new(#EF5350, 0), size=size.tiny)

// ─────────────────── Mode info table ───────────────────
// Tiny top-right table showing which filter mode is active on this chart.
var table modeTable = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(modeTable, 0, 0, 'Ichimoku-NW Strategy', text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(modeTable, 0, 1, filterModeStr,           text_color=color.white, bgcolor=color.new(color.black, 50), text_size=size.small)

// ─────────────────── Alerts ───────────────────
alertcondition(bullCross, title='TK Bullish Cross', message='Ichimoku-NW Strategy: {{ticker}} ({{interval}}) Tenkan crossed above Kijun ▲')
alertcondition(bearCross, title='TK Bearish Cross', message='Ichimoku-NW Strategy: {{ticker}} ({{interval}}) Tenkan crossed below Kijun ▼')

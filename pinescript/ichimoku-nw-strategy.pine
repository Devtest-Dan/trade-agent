//
// Ichimoku Kinko Hyo (Nadaraya–Watson) — Strategy
// -----------------------------------------------
// Trades the NWE-Ichimoku indicator (see ichimoku-nw.pine) with a
// timeframe-adaptive entry filter:
//   • ≤ H1 timeframes:  3-line filter (TK cross + price/cloud + future cloud + Chikou)
//   • ≥ H4 timeframes:  2-line filter (TK cross + price/cloud)
// Exits: opposite TK cross OR price closes through Kijun against position OR
// (optional) price closes outside the Kernel Bollinger Band against position.
//
// Kernel Bollinger Band uses a kernel-smoothed close (RQ or Gaussian) as basis
// and ± mult × stddev for the bands. Approach adapted from sammie123567858's
// "Kernel Bollinger Band" (MPL 2.0). RQ kernel reused from jdehorty (MPL 2.0).

//@version=6
strategy(
     title             = 'Ichimoku-NW Strategy',
     shorttitle        = 'Ichi-NW.S',
     overlay           = true,
     pyramiding        = 0,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 5,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.05,
     slippage          = 1,
     calc_on_every_tick = false,
     process_orders_on_close = true,
     max_bars_back     = 500)

// ─────────────────── Inputs: Ichimoku ───────────────────
int   tenkanLen = input.int(9,   'Tenkan length', minval=2, group='Ichimoku Settings')
int   kijunLen  = input.int(26,  'Kijun length',  minval=2, group='Ichimoku Settings')
int   spanBLen  = input.int(52,  'Span B length', minval=2, group='Ichimoku Settings')
int   disp      = input.int(26,  'Displacement',  minval=1, group='Ichimoku Settings')

float r   = input.float(8.0, 'Relative Weighting (r)', step=0.25, minval=0.25, group='Ichimoku Kernel')
int   x_0 = input.int(25,    'Start Regression at Bar (x_0)', minval=0, group='Ichimoku Kernel')

// ─────────────────── Inputs: Kernel Bollinger Band ───────────────────
string bbKernelType = input.string('Rational Quadratic', 'Kernel Type', options=['Rational Quadratic', 'Gaussian'], group='Kernel BB — Basis')
float  bbWeight     = input.float(8.0, 'Rel Weight (RQ only)', minval=0.0, maxval=50.0, step=0.2, group='Kernel BB — Basis')
int    bbLookback   = input.int(20, 'Lookback',         minval=2, maxval=500, group='Kernel BB — Basis')
int    bbRegStart   = input.int(25, 'Regression Start', minval=2, maxval=400, group='Kernel BB — Basis')
bool   bbSmooth     = input.bool(true, 'Smooth basis',  group='Kernel BB — Basis', inline='smooth')
int    bbSmoothPer  = input.int(4, '', minval=2, maxval=200, group='Kernel BB — Basis', inline='smooth')

int    bbLength = input.int(20,  'StdDev Length',     minval=1, group='Kernel BB — Bands')
float  bbMult   = input.float(2.0, 'StdDev Multiplier', minval=0.001, maxval=50.0, group='Kernel BB — Bands')
float  bbSrc    = input.source(close, 'StdDev Source', group='Kernel BB — Bands')

// ─────────────────── Inputs: Strategy ───────────────────
bool   tradeLongs  = input.bool(true,  'Trade longs',  group='Strategy')
bool   tradeShorts = input.bool(true,  'Trade shorts', group='Strategy')

string tfMode = input.string('Auto (TF-based)', 'Filter mode',
     options=['Auto (TF-based)', 'Force 3-line', 'Force 2-line'], group='Strategy',
     tooltip='Auto picks 3-line for ≤H1 and 2-line for ≥H4. Override here to test the alternative on any chart.')

bool exitOnTkCross = input.bool(true,  'Exit on opposite TK cross', group='Exits')
bool exitOnKijun   = input.bool(true,  'Exit on Kijun close-through', group='Exits',
     tooltip='Closes the trade when price closes below Kijun (longs) or above Kijun (shorts). Acts as a soft stop.')
bool exitOnBand    = input.bool(false, 'Exit on Kernel BB extreme (intrabar)', group='Exits',
     tooltip='Places a standing limit order at the upper band (longs) / lower band (shorts). Fills the instant price ticks through the band, mid-bar. Best on mean-reverting / spike-prone instruments. Cuts winners on strong trends — off by default. Trades without a band touch still exit on TK or Kijun at bar close.')

bool useDateFilter = input.bool(false, 'Use date range', group='Backtest Window')
int  startYear     = input.int(2020, 'Start year',  minval=1970, group='Backtest Window')
int  endYear       = input.int(2030, 'End year',    minval=1970, group='Backtest Window')

// ─────────────────── Kernel functions ───────────────────
kernel_regression_rq(series float _src, simple int _h, simple float _r, simple int _x0) =>
    int   lookback = math.max(1 + _x0, math.round(5.0 * _h))
    float h2  = float(_h) * float(_h)
    float num = 0.0
    float den = 0.0
    for i = 0 to lookback
        float y = _src[i]
        if not na(y)
            float i2 = float(i) * float(i)
            float w  = math.pow(1.0 + i2 / (h2 * 2.0 * _r), -_r)
            num += y * w
            den += w
    den == 0.0 ? na : num / den

kernel_regression_gauss(series float _src, simple int _h, simple int _x0) =>
    int   lookback = math.max(1 + _x0, math.round(5.0 * _h))
    float h2  = float(_h) * float(_h)
    float num = 0.0
    float den = 0.0
    for i = 0 to lookback
        float y = _src[i]
        if not na(y)
            float i2 = float(i) * float(i)
            float w  = math.exp(-i2 / (2.0 * h2))
            num += y * w
            den += w
    den == 0.0 ? na : num / den

nw_mid(simple int _h) =>
    (kernel_regression_rq(high, _h, r, x_0) + kernel_regression_rq(low, _h, r, x_0)) / 2.0

// ─────────────────── Ichimoku lines ───────────────────
float tenkan = nw_mid(tenkanLen)
float kijun  = nw_mid(kijunLen)
float spanA  = (tenkan + kijun) / 2.0
float spanB  = nw_mid(spanBLen)

// ─────────────────── Kernel Bollinger Band ───────────────────
float bbBasisRaw = bbKernelType == 'Rational Quadratic'
     ? kernel_regression_rq(close, bbLookback, bbWeight, bbRegStart)
     : kernel_regression_gauss(close, bbLookback, bbRegStart)
float bbBasis   = bbSmooth ? ta.sma(bbBasisRaw, bbSmoothPer) : bbBasisRaw
float bbDev     = bbMult * ta.stdev(bbSrc, bbLength)
float upperBand = bbBasis + bbDev
float lowerBand = bbBasis - bbDev

// ─────────────────── Timeframe detection ───────────────────
int  tfSeconds = timeframe.in_seconds()
bool useThreeLine = switch tfMode
    'Force 3-line' => true
    'Force 2-line' => false
    => tfSeconds <= 3600

string filterModeStr = useThreeLine ? '3-line filter (TK + cloud + future cloud + Chikou)' : '2-line filter (TK + cloud)'

// ─────────────────── Entry filters ───────────────────
bool bullCross = ta.crossover(tenkan, kijun)
bool bearCross = ta.crossunder(tenkan, kijun)

float topCloudNow    = math.max(spanA[disp], spanB[disp])
float bottomCloudNow = math.min(spanA[disp], spanB[disp])
bool  aboveCloud     = not na(topCloudNow)    and close > topCloudNow
bool  belowCloud     = not na(bottomCloudNow) and close < bottomCloudNow

bool bullFutureCloud = spanA > spanB
bool bearFutureCloud = spanA < spanB

bool chikouClearLong  = not na(high[disp]) and close > high[disp]
bool chikouClearShort = not na(low[disp])  and close < low[disp]

bool longEntry = useThreeLine
     ? (bullCross and aboveCloud and bullFutureCloud and chikouClearLong)
     : (bullCross and aboveCloud)
bool shortEntry = useThreeLine
     ? (bearCross and belowCloud and bearFutureCloud and chikouClearShort)
     : (bearCross and belowCloud)

// ─────────────────── Exit conditions ───────────────────
// Two exit channels:
//
//   1. Close-based exits (TK cross, Kijun close-through) — fire at bar close
//      via strategy.close, which is a market order. With process_orders_on_close=true
//      these fill at the same bar's close price.
//
//   2. Intrabar band exit (optional) — registered as a strategy.exit limit
//      order at the band level. Fills the moment price ticks through the band
//      during the next bar, regardless of where the bar eventually closes.
//      The limit price for bar N+1 is the band value computed at bar N's close
//      (one bar of lag in the band level, but the fill itself is intrabar).
bool longCloseExit  = (exitOnTkCross and bearCross) or (exitOnKijun and close < kijun)
bool shortCloseExit = (exitOnTkCross and bullCross) or (exitOnKijun and close > kijun)

// ─────────────────── Backtest window ───────────────────
bool inWindow = not useDateFilter or (year >= startYear and year <= endYear)

// ─────────────────── Strategy execution ───────────────────
// Entries are gated by the backtest window. Exits run regardless so positions
// can never get stranded if the date filter expires mid-trade.
if inWindow
    if tradeLongs and longEntry
        strategy.entry('Long', strategy.long)
    if tradeShorts and shortEntry
        strategy.entry('Short', strategy.short)

// Close-based exits (TK cross / Kijun break) — bar close, market order
if longCloseExit
    strategy.close('Long', comment='Exit Long (TK/Kijun)')
if shortCloseExit
    strategy.close('Short', comment='Exit Short (TK/Kijun)')

// Intrabar band exits — limit orders updated each bar to follow the moving
// bands. strategy.exit on an id is replaced on each call, so the limit price
// always reflects the latest band value. No-ops when there's no matching
// open position.
if exitOnBand
    strategy.exit('Band Exit Long',  from_entry='Long',  limit=upperBand, comment_profit='Exit Long (BB)')
    strategy.exit('Band Exit Short', from_entry='Short', limit=lowerBand, comment_profit='Exit Short (BB)')

// ─────────────────── Plots: Ichimoku ───────────────────
plot(tenkan, 'Tenkan', color=color.new(#2962FF, 0), linewidth=2)
plot(kijun,  'Kijun',  color=color.new(#B71C1C, 0), linewidth=2)

pA = plot(spanA, 'Span A', offset=disp, color=color.new(#26A69A, 30), linewidth=1)
pB = plot(spanB, 'Span B', offset=disp, color=color.new(#EF5350, 30), linewidth=1)
fill(pA, pB, color = spanA > spanB ? color.new(#26A69A, 80) : color.new(#EF5350, 80), title='Kumo')

plot(close, 'Chikou', color=color.new(#43A047, 0), offset=-disp, linewidth=1)

// ─────────────────── Plots: Kernel Bollinger Band ───────────────────
bool basisRising = ta.rising(bbBasis, 1)
color basisColor = basisRising ? #542772 : #df4774
plot(bbBasis, 'BB Basis', color=basisColor, linewidth=2)
pUpper = plot(upperBand, 'BB Upper', color=color.new(#FFA726, 0), linewidth=1)
pLower = plot(lowerBand, 'BB Lower', color=color.new(#FFA726, 0), linewidth=1)
fill(pUpper, pLower, color=color.new(#FFA726, 85), title='BB Fill')

// Regime tint
bgcolor(aboveCloud ? color.new(#26A69A, 92) : na, title='Above cloud')
bgcolor(belowCloud ? color.new(#EF5350, 92) : na, title='Below cloud')

// TK markers (visual reference; entry markers come from strategy.entry automatically)
plotshape(bullCross, title='TK bull cross', style=shape.triangleup,   location=location.belowbar, color=color.new(#26A69A, 0), size=size.tiny)
plotshape(bearCross, title='TK bear cross', style=shape.triangledown, location=location.abovebar, color=color.new(#EF5350, 0), size=size.tiny)

// ─────────────────── Mode info table ───────────────────
var table modeTable = table.new(position.top_right, 1, 2, border_width=1)
if barstate.islast
    table.cell(modeTable, 0, 0, 'Ichimoku-NW Strategy', text_color=color.white, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(modeTable, 0, 1, filterModeStr,           text_color=color.white, bgcolor=color.new(color.black, 50), text_size=size.small)

// ─────────────────── Alerts ───────────────────
alertcondition(bullCross, title='TK Bullish Cross', message='Ichimoku-NW Strategy: {{ticker}} ({{interval}}) Tenkan crossed above Kijun ▲')
alertcondition(bearCross, title='TK Bearish Cross', message='Ichimoku-NW Strategy: {{ticker}} ({{interval}}) Tenkan crossed below Kijun ▼')

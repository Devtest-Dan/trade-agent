i_kao_leg_width = input.int(1, "KAO swing leg width", minval = 1, maxval = 4, group = "Swings")
i_show_bos      = input.bool(true, "Show BOS", group = "BOS & CHOCH")
i_show_choch    = input.bool(true, "Show CHOCH", group = "BOS & CHOCH")
i_show_pd       = input.bool(true, "Show Premium/Discount", group = "Zones")
i_show_ote      = input.bool(true, "Show OTE Zone", group = "Zones")
i_show_eq       = input.bool(true, "Show Equilibrium Line", group = "Zones")
i_show_liq      = input.bool(true, "Show Equal Highs/Lows", group = "Liquidity")
i_show_sweeps   = input.bool(true, "Show Liquidity Sweeps", group = "Liquidity")
i_eq_atr_mult   = input.float(0.1, "EQ Threshold (ATR mult)", minval = 0.01, maxval = 0.5, step = 0.01, group = "Liquidity")
i_eq_min_touches = input.int(2, "Min Touches for EQ Level", minval = 2, maxval = 5, group = "Liquidity")

//@version=6
strategy("SMC KAO Resumption Strategy v1.0",
  overlay           = true,
  pyramiding        = 0,
  default_qty_type  = strategy.percent_of_equity,
  default_qty_value = 1,
  commission_type   = strategy.commission.percent,
  commission_value  = 0.04,
  slippage          = 1,
  calc_on_every_tick = false)

// ============================================================
// KAO STRUCTURE  (ported verbatim from KAO_v1.7 indicator)
// ============================================================

// ── Inputs ───────────────────────────────────────────────────
string InpMode        = input.string("BOS & CHOCH",  "Mode",            options = ["BOS & CHOCH", "BOS", "CHOCH"],           group = "BOS & CHOCH")
bool   InpShowBull    = input.bool  (true,            "Show Bullish",                                                          group = "BOS & CHOCH")
bool   InpShowBear    = input.bool  (true,            "Show Bearish",                                                          group = "BOS & CHOCH")
string InpBreakMode   = input.string("Wick", "Break Confirmation", options = ["Close", "Wick"], group = "Structure", tooltip = "Close = candle body must close beyond level. Wick = high/low touching counts as break")
int    InpSwingLen    = input.int   (10,              "Swing Detection Lookback",  minval = 2,                                  group = "Swings")
bool   InpShowSwing   = input.bool  (true,            "Show Swing Points",                                                      group = "Swings")
bool   InpShowIHL     = input.bool  (true,            "Show Internal High/Low",                                                 group = "Swings")
bool   InpShowOB      = input.bool  (true,            "Show Order Blocks",                                                      group = "Order Blocks")
string InpOBSource    = input.string("Wick",          "OB Source",       options = ["Wick", "Body"],                           group = "Order Blocks")
int    InpOBMitigation = input.int  (0,               "Mitigation Level",minval = 0, maxval = 2,                               group = "Order Blocks")
bool   InpShowFVG     = input.bool  (true,            "Show FVG",                                                               group = "Fair Value Gaps")
bool   InpFVGAuto     = input.bool  (true,            "Auto Threshold",                                                         group = "Fair Value Gaps")
float  InpFVGThresh   = input.float (0.0,             "Threshold",       minval = 0.0,                                         group = "Fair Value Gaps")
bool   InpShowLiq     = input.bool  (true,            "Show Liquidity",                                                         group = "Liquidity")
int    InpLiqLen      = input.int   (20,              "Liquidity Lookback", minval = 2,                                         group = "Liquidity")
color  InpBullCol     = input.color (color.new(#2962ff, 0), "Bullish Color",                                                   group = "Colors")
color  InpBearCol     = input.color (color.new(#f23645, 0), "Bearish Color",                                                   group = "Colors")

// ── Swing Detection ──────────────────────────────────────────
float phVal = ta.pivothigh(InpSwingLen, InpSwingLen)
float plVal = ta.pivotlow (InpSwingLen, InpSwingLen)

var float topY    = na,  var int topX    = na,  var int topDir  = na
var float btmY    = na,  var int btmX    = na,  var int btmDir  = na
var float topYTmp = na,  var int topXTmp = na
var float btmYTmp = na,  var int btmXTmp = na

if not na(phVal)
    topYTmp := phVal
    topXTmp := bar_index[InpSwingLen]
if not na(plVal)
    btmYTmp := plVal
    btmXTmp := bar_index[InpSwingLen]

// ── Structure Break ──────────────────────────────────────────
var int   structDir     = 0
var float brkLvl        = na
var int   brkBar        = na
var bool  isBOS         = false
var bool  isCHOCH       = false

bool breakUp   = InpBreakMode == "Close" ? close > topYTmp : high  > topYTmp
bool breakDown = InpBreakMode == "Close" ? close < btmYTmp : low   < btmYTmp

if breakUp and not na(topYTmp) and bar_index != topXTmp
    isBOS   := structDir ==  1
    isCHOCH := structDir == -1
    topY    := topYTmp
    topX    := topXTmp
    topDir  :=  1
    brkLvl  := topYTmp
    brkBar  := bar_index
    structDir :=  1
if breakDown and not na(btmYTmp) and bar_index != btmXTmp
    isBOS   := structDir == -1
    isCHOCH := structDir ==  1
    btmY    := btmYTmp
    btmX    := btmXTmp
    btmDir  := -1
    brkLvl  := btmYTmp
    brkBar  := bar_index
    structDir := -1

// ── Order Block Detection ────────────────────────────────────
int   MaxOBs  = 5
type OBType
    float top
    float btm
    int   dir
    int   left
    bool  active

var OBType[] obArray = array.new<OBType>()

addOB(float top, float btm, int dir, int left) =>
    ob = OBType.new(top, btm, dir, left, true)
    array.unshift(obArray, ob)
    if array.size(obArray) > MaxOBs
        array.pop(obArray)

if isBOS or isCHOCH
    if structDir == 1
        float obTop = InpOBSource == "Wick" ? high[1] : math.max(open[1], close[1])
        float obBtm = InpOBSource == "Wick" ? low[1]  : math.min(open[1], close[1])
        addOB(obTop, obBtm, 1, bar_index - 1)
    else
        float obTop = InpOBSource == "Wick" ? high[1] : math.max(open[1], close[1])
        float obBtm = InpOBSource == "Wick" ? low[1]  : math.min(open[1], close[1])
        addOB(obTop, obBtm, -1, bar_index - 1)

for ob in obArray
    if ob.active
        mitigated = InpOBMitigation == 0 ? (ob.dir ==  1 ? low  <= ob.btm : high >= ob.top) : InpOBMitigation == 1 ? (ob.dir ==  1 ? close <= ob.btm : close >= ob.top) : (ob.dir ==  1 ? close <= ob.top : close >= ob.btm)
        if mitigated
            ob.active := false

// ── FVG Detection ────────────────────────────────────────────
float fvgThresh = InpFVGAuto ? ta.atr(50) * 0.5 : InpFVGThresh

type FVGType
    float top
    float btm
    int   dir
    int   left
    bool  active

var FVGType[] fvgArray = array.new<FVGType>()

bullFVG = low > high[2] and (low - high[2]) >= fvgThresh
bearFVG = high < low[2] and (low[2] - high) >= fvgThresh

if bullFVG
    fvg = FVGType.new(low, high[2], 1, bar_index - 1, true)
    array.unshift(fvgArray, fvg)
    if array.size(fvgArray) > 10
        array.pop(fvgArray)
if bearFVG
    fvg = FVGType.new(low[2], high, -1, bar_index - 1, true)
    array.unshift(fvgArray, fvg)
    if array.size(fvgArray) > 10
        array.pop(fvgArray)

for fvg in fvgArray
    if fvg.active
        if fvg.dir == 1 and low <= fvg.btm
            fvg.active := false
        if fvg.dir == -1 and high >= fvg.top
            fvg.active := false

// ── Liquidity Detection ──────────────────────────────────────
float liqHigh = ta.highest(high, InpLiqLen)[1]
float liqLow  = ta.lowest (low,  InpLiqLen)[1]

bool sweepHigh = high >= liqHigh and high[1] < liqHigh
bool sweepLow  = low  <= liqLow  and low [1] > liqLow

// ── Drawings ─────────────────────────────────────────────────
// BOS / CHOCH lines
if (isBOS and InpMode != "CHOCH") or (isCHOCH and InpMode != "BOS")
    bool isBull = structDir == 1
    if (isBull and InpShowBull) or (not isBull and InpShowBear)
        col   = isBull ? InpBullCol : InpBearCol
        lbl   = isBOS ? "BOS" : "CHOCH"
        line.new(brkBar, brkLvl, bar_index, brkLvl, color = col, width = 1)
        label.new(bar_index, brkLvl, lbl, color = color.new(col, 80), textcolor = col, style = label.style_label_left, size = size.tiny)

// Swing points
if InpShowSwing
    if not na(phVal)
        label.new(topXTmp, topYTmp, "H", color = color.new(InpBullCol, 80), textcolor = InpBullCol, style = label.style_label_down, size = size.tiny)
    if not na(plVal)
        label.new(btmXTmp, btmYTmp, "L", color = color.new(InpBearCol, 80), textcolor = InpBearCol, style = label.style_label_up,   size = size.tiny)

// Internal high/low
if InpShowIHL
    if not na(phVal)
        line.new(topXTmp, topYTmp, bar_index, topYTmp, color = color.new(InpBullCol, 70), style = line.style_dashed, width = 1)
    if not na(plVal)
        line.new(btmXTmp, btmYTmp, bar_index, btmYTmp, color = color.new(InpBearCol, 70), style = line.style_dashed, width = 1)

// Order Blocks
if InpShowOB
    for ob in obArray
        if ob.active
            box.new(ob.left, ob.top, bar_index, ob.btm,
              border_color = ob.dir == 1 ? color.new(InpBullCol, 60) : color.new(InpBearCol, 60),
              bgcolor      = ob.dir == 1 ? color.new(InpBullCol, 85) : color.new(InpBearCol, 85))

// FVGs
if InpShowFVG
    for fvg in fvgArray
        if fvg.active
            box.new(fvg.left, fvg.top, bar_index, fvg.btm,
              border_color = fvg.dir == 1 ? color.new(InpBullCol, 70) : color.new(InpBearCol, 70),
              bgcolor      = fvg.dir == 1 ? color.new(InpBullCol, 90) : color.new(InpBearCol, 90))

// Liquidity
if InpShowLiq
    if sweepHigh
        label.new(bar_index, high, "Liq Sweep ▲", color = color.new(InpBullCol, 80), textcolor = InpBullCol, style = label.style_label_down, size = size.tiny)
    if sweepLow
        label.new(bar_index, low,  "Liq Sweep ▼", color = color.new(InpBearCol, 80), textcolor = InpBearCol, style = label.style_label_up,   size = size.tiny)

// ============================================================
// KERNEL BOLLINGER BANDS  (ported verbatim from KBB indicator)
// ============================================================

// ── KBB Inputs ───────────────────────────────────────────────
int    kbb_h         = input.int   (8,      "Lookback Window (h)",    minval = 1,                                group = "KBB Bands")
float  kbb_r_fast    = input.float (8.0,    "Relative Weighting — Fast (r)", minval = 0.0, step = 0.25,          group = "KBB Fast Kernel Settings")
float  kbb_x_fast    = input.float (25.0,   "Start Regression at Bar — Fast (x₀)", minval = 0.0, step = 1.0,    group = "KBB Fast Kernel Settings")
float  kbb_mult      = input.float (1.0,    "Band Multiplier",         minval = 0.1, step = 0.1,                 group = "KBB Bands")
bool   kbb_smooth    = input.bool  (true,   "Smooth Bands",                                                       group = "KBB Bands")
int    kbb_sm_len    = input.int   (5,      "Smoothing Length",        minval = 2,                                group = "KBB Bands")
bool   kbb_show_basis = input.bool (true,   "Show Basis",                                                         group = "KBB Bands")
bool   kbb_show_bands = input.bool (true,   "Show Upper/Lower Bands",                                             group = "KBB Bands")

// ── Rational Quadratic Kernel ─────────────────────────────────
rq_kernel(src, h, r, x0) =>
    float sum_w = 0.0
    float sum_wv = 0.0
    for i = 0 to h - 1
        float w = math.pow(1.0 + math.pow(i, 2) / (2.0 * r * math.pow(h, 2)), -r)
        sum_w  += w
        sum_wv += w * src[i]
    sum_wv / sum_w

// ── KBB Calculation ──────────────────────────────────────────
float kbb_basis_raw = rq_kernel(close, kbb_h, kbb_r_fast, kbb_x_fast)
float kbb_basis     = kbb_smooth ? ta.ema(kbb_basis_raw, kbb_sm_len) : kbb_basis_raw

float sum_sq = 0.0
for i = 0 to kbb_h - 1
    sum_sq += math.pow(close[i] - kbb_basis, 2)
float kbb_std    = math.sqrt(sum_sq / kbb_h)
float kbb_upper_raw = kbb_basis + kbb_mult * kbb_std
float kbb_lower_raw = kbb_basis - kbb_mult * kbb_std
float kbb_upper  = kbb_smooth ? ta.ema(kbb_upper_raw, kbb_sm_len) : kbb_upper_raw
float kbb_lower  = kbb_smooth ? ta.ema(kbb_lower_raw, kbb_sm_len) : kbb_lower_raw

// ── KBB Plots ────────────────────────────────────────────────
plot(kbb_show_basis ? kbb_basis : na, "KBB Basis", color = color.new(color.yellow, 30), linewidth = 1)
plot(kbb_show_bands ? kbb_upper : na, "KBB Upper", color = color.new(color.red,    40), linewidth = 1)
plot(kbb_show_bands ? kbb_lower : na, "KBB Lower", color = color.new(color.green,  40), linewidth = 1)

// ============================================================
// STATE MACHINE  (trendDir, legHigh/Low/Mid, armed, barsInTrend)
// ============================================================

// ── State Variables ──────────────────────────────────────────
var int   trendDir     = 0      // 1 = bull, -1 = bear, 0 = undefined
var float legHigh      = na     // highest high of current leg
var float legLow       = na     // lowest  low  of current leg
var float legMid       = na     // 50% midpoint  (legLow + legHigh) / 2
var bool  armed        = false  // true once price has visited discount/premium zone
var int   barsInTrend  = 0      // bars since last structure break

// ── CHoCH / BOS detection helpers ───────────────────────────
bool bullBreak = isCHOCH and structDir ==  1   // bearish → bullish CHoCH
bool bearBreak = isCHOCH and structDir == -1   // bullish → bearish CHoCH

// ── Trend Direction + Leg Boundaries ────────────────────────
if bullBreak
    trendDir    := 1
    legHigh     := ta.highest(high, InpSwingLen * 2)
    legLow      := ta.lowest (low,  InpSwingLen * 2)
    legMid      := (legHigh + legLow) / 2.0
    armed       := false
    barsInTrend := 0

if bearBreak
    trendDir    := -1
    legHigh     := ta.highest(high, InpSwingLen * 2)
    legLow      := ta.lowest (low,  InpSwingLen * 2)
    legMid      := (legHigh + legLow) / 2.0
    armed       := false
    barsInTrend := 0

barsInTrend := trendDir != 0 ? barsInTrend + 1 : 0

// ── Arming logic ─────────────────────────────────────────────
// Bull trend: arm when price visits discount zone (below legMid)
// Bear trend: arm when price visits premium zone (above legMid)
if trendDir == 1 and not armed
    if low < legMid
        armed := true
if trendDir == -1 and not armed
    if high > legMid
        armed := true

// ── Data Window labels (for visual verification in Task 8) ──
plotchar(trendDir,    "trendDir",    "", location.top, size = size.tiny, display = display.data_window)
plotchar(legHigh,     "legHigh",     "", location.top, size = size.tiny, display = display.data_window)
plotchar(legLow,      "legLow",      "", location.top, size = size.tiny, display = display.data_window)
plotchar(legMid,      "legMid",      "", location.top, size = size.tiny, display = display.data_window)
plotchar(armed ? 1 : 0, "armed",    "", location.top, size = size.tiny, display = display.data_window)
plotchar(barsInTrend, "barsInTrend","", location.top, size = size.tiny, display = display.data_window)

// ============================================================
// STRATEGY INPUTS  (direction filter, SL buffer, risk %)
// ============================================================
string inputDirection   = input.string("Both",  "Direction",                          options = ["Both", "Long only", "Short only"], group = "Strategy")
int    inputMinBarsTrend = input.int(5,          "Min bars in new trend before entry", minval = 1, maxval = 100, group = "Strategy")
float  inputSLBuffer     = input.float(0.0,      "SL buffer (price units)",            minval = 0.0, group = "Strategy")
float  inputRiskPct      = input.float(1.0,      "Risk % per trade",            minval = 0.1, maxval = 5.0, step = 0.1, group = "Strategy")

// Re-arm logic (only re-arms while flat)
inputReArmExtreme = input.bool(true, "Re-arm on new HH/LL extreme", group = "Strategy")
inputReArmBasis   = input.bool(true, "Re-arm on basis touch",       group = "Strategy")

bool inputShowLeg   = input.bool(true, "Show legHigh/legLow lines",       group = "Visuals")
bool inputShowMid   = input.bool(true, "Show legMid (50%) line",          group = "Visuals")
bool inputShowZone  = input.bool(true, "Show discount/premium zone box",  group = "Visuals")
bool inputShowMarks = input.bool(true, "Show entry/exit markers",         group = "Visuals")

var float lastLegHigh = na
var float lastLegLow  = na
bool newExtreme       = false
if trendDir == 1 and not na(legHigh) and (na(lastLegHigh) or legHigh > lastLegHigh)
    newExtreme    := true
    lastLegHigh   := legHigh
if trendDir == -1 and not na(legLow) and (na(lastLegLow) or legLow < lastLegLow)
    newExtreme    := true
    lastLegLow    := legLow

bool basisTouch = not na(kbb_basis) and math.abs(close - kbb_basis) / kbb_basis < 0.001

if strategy.position_size == 0
    if inputReArmExtreme and newExtreme
        armed := false
    if inputReArmBasis and basisTouch
        armed := false

// ============================================================
// ENTRY CONDITIONS
// ============================================================

// ── KAO Resumption Entry Conditions ─────────────────────────
// Long: bull trend, armed, price back above legMid, bearish KAO candle confirmed
bool longCondBase = trendDir    ==  1
     and armed
     and close     >  legMid
     and barsInTrend >= inputMinBarsTrend
     and (inputDirection == "Both" or inputDirection == "Long only")

// Bearish-to-bullish KAO candle: opens below, closes above (momentum shift)
bool kaoLong = close  > open
     and open  < legMid
     and close > legMid

// Short: bear trend, armed, price back below legMid, bullish KAO candle confirmed
bool shortCondBase = trendDir   == -1
     and armed
     and close    <  legMid
     and barsInTrend >= inputMinBarsTrend
     and (inputDirection == "Both" or inputDirection == "Short only")

// Bullish-to-bearish KAO candle: opens above, closes below (momentum shift)
bool kaoShort = close  < open
     and open  > legMid
     and close < legMid

// Final entry signals — also require KBB containment
bool longCond  = longCondBase
     and kaoLong
     and close    > kbb_lower
     and close    < kbb_upper
     and close    > open

bool shortCond = shortCondBase
     and kaoShort
     and close    > kbb_lower
     and close    < kbb_upper
     and close    < open
     and not na(kbb_upper)

// ============================================================
// EXIT LOGIC
// ============================================================
// ── Exit 1: Frozen initial SL (set at entry, never widened) ──
// ── Exit 2: Structural trail (legHigh / legLow)             ──
// ── Exit 3: Opposite CHoCH exits immediately                 ──

var float frozenSL = na

// Track the SL per position type
if longCond and strategy.position_size == 0
    frozenSL := legLow - inputSLBuffer
if shortCond and strategy.position_size == 0
    frozenSL := legHigh + inputSLBuffer

// Structural trailing stop
float trailSL = strategy.position_size > 0 ? legLow  - inputSLBuffer : strategy.position_size < 0 ? legHigh + inputSLBuffer : na

// Use the more protective of frozen vs trail
float activeSL = strategy.position_size > 0 ? math.max(frozenSL, trailSL) : strategy.position_size < 0 ? math.min(frozenSL, trailSL) : na

// Opposite CHoCH exit condition
bool exitLongOnCHOCH  = strategy.position_size > 0 and bearBreak
bool exitShortOnCHOCH = strategy.position_size < 0 and bullBreak

// Exit execution
if exitLongOnCHOCH
    strategy.close("Long",  comment = "CHoCH exit")
if exitShortOnCHOCH
    strategy.close("Short", comment = "CHoCH exit")

if strategy.position_size > 0 and not na(activeSL)
    strategy.exit("Long SL/Trail", from_entry = "Long",  stop = activeSL)
if strategy.position_size < 0 and not na(activeSL)
    strategy.exit("Short SL/Trail", from_entry = "Short", stop = activeSL)

// ============================================================
// POSITION SIZING
// ============================================================
// Risk-based sizing: risk inputRiskPct% of equity per trade
// Lot size = (equity * riskPct) / (entry - SL) in price units

float equityRisk   = strategy.equity * (inputRiskPct / 100.0)

// Entry SL distances (in price units, always positive)
float longSLDist   = longCond  and not na(legLow)  ? math.abs(close - (legLow  - inputSLBuffer)) : na
float shortSLDist  = shortCond and not na(legHigh) ? math.abs(close - (legHigh + inputSLBuffer)) : na

// Quantity in contracts (1 contract = 1 price unit of risk)
float longQty  = not na(longSLDist)  and longSLDist  > 0 ? equityRisk / longSLDist  : na
float shortQty = not na(shortSLDist) and shortSLDist > 0 ? equityRisk / shortSLDist : na

// ── strategy.entry wiring ────────────────────────────────────
if longCond and not na(longQty)
    strategy.entry("Long",  strategy.long,  qty = longQty)
if shortCond and not na(shortQty)
    strategy.entry("Short", strategy.short, qty = shortQty)

// ── Data window: expose SL + qty for verification ────────────
plotchar(activeSL,  "activeSL",  "", location.top, size = size.tiny, display = display.data_window)
plotchar(longQty,   "longQty",   "", location.top, size = size.tiny, display = display.data_window)
plotchar(shortQty,  "shortQty",  "", location.top, size = size.tiny, display = display.data_window)

// ── KBB plots (kept for overlay reference) ───────────────────
plot(kbb_upper, "kbb_upper", color = color.new(color.red,   70), linewidth = 1, display = display.data_window)
plot(kbb_lower, "kbb_lower", color = color.new(color.green, 70), linewidth = 1, display = display.data_window)

// ============================================================
// ALERTS
// ============================================================

// 1. Long entry alert
alertcondition(longCond,  "Long Entry",  message = "LONG {{ticker}} {{interval}} @ {{close}}")

// 2. Short entry alert
alertcondition(shortCond, "Short Entry", message = "SHORT {{ticker}} {{interval}} @ {{close}}")

// 3. CHoCH exit — long position closed by opposite CHoCH
alertcondition(exitLongOnCHOCH,  "Exit Long (CHoCH)",  message = "EXIT LONG {{ticker}} {{interval}} @ {{close}}")

// 4. CHoCH exit — short position closed by opposite CHoCH
alertcondition(exitShortOnCHOCH, "Exit Short (CHoCH)", message = "EXIT SHORT {{ticker}} {{interval}} @ {{close}}")

// 5. Any position closed (SL/trail or CHoCH)
bool justClosedLong  = strategy.position_size == 0 and strategy.position_size[1] > 0
bool justClosedShort = strategy.position_size == 0 and strategy.position_size[1] < 0
alertcondition(justClosedLong or justClosedShort, "Position closed", message = "EXIT {{ticker}} {{interval}} @ {{close}}")

// =========================================================
// VISUAL LAYER — leg lines, zone bgcolor, entry/exit markers
// =========================================================
plot(inputShowLeg and not na(legHigh) ? legHigh : na, "Leg High", color = color.new(color.green, 50), linewidth = 1, style = plot.style_linebr)
plot(inputShowLeg and not na(legLow)  ? legLow  : na, "Leg Low",  color = color.new(color.red,   50), linewidth = 1, style = plot.style_linebr)
plot(inputShowMid and not na(legMid)  ? legMid  : na, "Leg Mid",  color = color.new(color.gray,  30), linewidth = 1, style = plot.style_linebr)

// Discount / Premium zone (translucent bgcolor inside the relevant half of the leg)
color zoneColor   = trendDir ==  1 ? color.new(color.green, 92) : trendDir == -1 ? color.new(color.red, 92) : na
float zoneTop     = trendDir ==  1 ? legMid  : legHigh
float zoneBottom  = trendDir ==  1 ? legLow  : legMid
bgcolor(inputShowZone and trendDir != 0 and not na(zoneTop) and not na(zoneBottom) and close >= zoneBottom and close <= zoneTop ? zoneColor : na, title = "Discount/Premium Zone")

// Entry / exit markers (gated by inputShowMarks)
plotshape(inputShowMarks and longCond,                            title = "Long Entry",  location = location.belowbar, style = shape.triangleup,   color = color.new(color.lime,   0), size = size.small, text = "L")
plotshape(inputShowMarks and shortCond,                           title = "Short Entry", location = location.abovebar, style = shape.triangledown, color = color.new(color.red,    0), size = size.small, text = "S")
plotshape(inputShowMarks and (justClosedLong or justClosedShort), title = "Exit",        location = location.absolute, style = shape.xcross,       color = color.new(color.yellow, 0), size = size.tiny)

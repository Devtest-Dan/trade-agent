i_show_mitigated_ob = input.bool(false, "Show Mitigated OBs", group = "Order Blocks", tooltip = "Show OBs that price has touched but not broken through")
i_show_breaker_ob   = input.bool(true, "Show Breaker OBs", group = "Order Blocks", tooltip = "When an OB is broken, it flips role: bull OB becomes Breaker Resistance, bear OB becomes Breaker Support")
i_max_visible_ob    = input.int(10, "Max Visible OBs", minval = 1, maxval = 30, group = "Order Blocks", tooltip = "Show N closest OBs to current price, per direction (e.g. 10 = up to 10 bullish + 10 bearish)")
i_ob_disp_body_pct  = input.float(0.5, "Displacement Min Body %", minval = 0.1, maxval = 0.9, step = 0.05, group = "Order Blocks", tooltip = "Minimum body-to-range ratio for displacement candles")
i_ob_imm_mit_pct    = input.float(0.3, "Immediate Mitigation %", minval = 0.0, maxval = 1.0, step = 0.05, group = "Order Blocks", tooltip = "After OB forms, check if price already overlapped the zone between OB candle and BOS bar. If penetration >= this % of zone depth, OB is immediately mitigated. 0 = disabled.")
i_show_fvg          = input.bool(true, "Show Fair Value Gaps", group = "Fair Value Gaps")
i_show_bull_fvg     = input.bool(true, "Show Bullish FVGs", group = "Fair Value Gaps")
i_show_bear_fvg     = input.bool(true, "Show Bearish FVGs", group = "Fair Value Gaps")
i_show_filled_fvg   = input.bool(false, "Show Filled FVGs", group = "Fair Value Gaps", tooltip = "Show FVGs that have been filled past the threshold")
i_fvg_fill_pct      = input.float(0.5, "Fill Threshold", minval = 0.1, maxval = 1.0, step = 0.05, group = "Fair Value Gaps", tooltip = "Percentage of gap that must be filled to mark as filled (0.5 = 50%)")
i_max_visible_fvg   = input.int(10, "Max Visible FVGs", minval = 1, maxval = 30, group = "Fair Value Gaps", tooltip = "Show N closest FVGs to current price, per direction (e.g. 10 = up to 10 bullish + 10 bearish)")
i_fvg_min_atr_mult  = input.float(0.0, "Min Gap Size (ATR mult)", minval = 0.0, maxval = 2.0, step = 0.1, group = "Fair Value Gaps", tooltip = "Minimum gap size as ATR multiple. 0 = no filter.")
i_div_kao_reg    = input.bool(false, "Show Regular Divergence", group = "Divergence", tooltip = "Regular bull + bear divergence on the KAO oscillator (price makes new extreme, oscillator does not).")
i_div_kao_hid    = input.bool(false, "Show Hidden Divergence",  group = "Divergence", tooltip = "Hidden bull + bear divergence on the KAO oscillator (oscillator makes new extreme, price does not — trend-continuation signal).")
i_col_div_reg    = input.color(#ff00f7, "Regular Div Color",    group = "Divergence")

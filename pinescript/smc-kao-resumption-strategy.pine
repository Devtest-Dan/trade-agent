i_col_choch_bear = input.color(#ef4444, "CHOCH Bearish", group = "Colors")
i_col_premium    = input.color(#ef4444, "Premium Zone", group = "Colors")
i_col_discount   = input.color(#22c55e, "Discount Zone", group = "Colors")
i_col_ote        = input.color(#f59e0b, "OTE Zone", group = "Colors")
i_col_eq_line    = input.color(#06b6d4, "Equilibrium Line", group = "Colors")
i_col_bsl        = input.color(#ef4444, "BSL (Equal Highs)", group = "Colors")
i_col_ssl        = input.color(#22c55e, "SSL (Equal Lows)", group = "Colors")
i_col_ob_bull       = input.color(#22c55e, "Bullish OB", group = "Colors")
i_col_ob_bear       = input.color(#ef4444, "Bearish OB", group = "Colors")
i_col_ob_mitigated  = input.color(#6b7280, "Mitigated OB", group = "Colors")
i_col_breaker_resist = input.color(#a855f7, "Breaker Resistance", group = "Colors")
i_col_breaker_support = input.color(#06b6d4, "Breaker Support", group = "Colors")
i_col_fvg_bull      = input.color(#3b82f6, "Bullish FVG", group = "Colors")
i_col_fvg_bear      = input.color(#f97316, "Bearish FVG", group = "Colors")
i_col_fvg_filled    = input.color(#6b7280, "Filled FVG", group = "Colors")
i_max_swing_labels = input.int(300, "Max Swing Labels", minval = 50, maxval = 490, group = "Performance")
i_max_bos_objects  = input.int(80, "Max BOS Lines/Labels", minval = 10, maxval = 200, group = "Performance")
i_max_choch_objects = input.int(40, "Max CHOCH Lines/Labels", minval = 10, maxval = 100, group = "Performance")
i_max_liq_objects  = input.int(30, "Max Liquidity Lines/Labels", minval = 10, maxval = 100, group = "Performance")
i_liq_max_lookback = input.int(4500, "Liquidity Line Max Lookback (bars)", minval = 100, maxval = 4900, group = "Performance", tooltip = "How far back an EQH / EQL line is allowed to start from the current bar. Pine restricts xloc.bar_index drawings to within max_bars_back (5000 here) of the current bar — Ultimate plans get a wider effective window, free plans get less. Default 4500 leaves a 500-bar safety margin. Lower this if you still hit 'x1 too far' errors; raise it (after also raising max_bars_back in the indicator() header) for longer EQH/EQL lines on Ultimate.")
i_max_sweep_labels = input.int(30, "Max Sweep Labels", minval = 10, maxval = 100, group = "Performance")
i_max_swings       = input.int(200, "Max Stored Swings", minval = 50, maxval = 500, group = "Performance")
i_max_stored_ob     = input.int(100, "Max Stored OBs", minval = 20, maxval = 300, group = "Performance")
i_max_stored_fvg    = input.int(200, "Max Stored FVGs", minval = 50, maxval = 500, group = "Performance")
i_debug_ob          = input.bool(false, "Debug OB Mitigation", group = "Performance", tooltip = "Enable Pine Logs for OB mitigation debugging")

int SWING_HIGH       =  1
int SWING_LOW        = -1
int CLS_UNCLASSIFIED =  0
int CLS_MAJOR        =  1
int CLS_INTERNAL     = -1
int TREND_BULLISH    =  1
int TREND_BEARISH    = -1
int TREND_UNDEFINED  =  0

type SwingPoint
    int    swing_type  = 0
    float  price       = na
    int    bar_idx     = -1
    int    cls         = 0
    bool   broken      = false
    int    broken_bar  = -1
    label  lbl         = na

type LiquidityPool
    int    pool_type   = 0
    float  level       = na
    int    start_bar   = -1
    bool   swept       = false
    int    swept_bar   = -1
    line   pool_line   = na
    label  pool_label  = na

type OBData
    int    direction   = 0
    float  top         = na
    float  bottom      = na
    int    ob_bar      = -1
    int    source      = 0
    string state       = "active"
    float  bos_level   = na
    bool   pullback_confirmed = false
    int    breaker_bar = -1
    bool   swing_after_breaker = false
    bool   was_breaker = false
    box    ob_box      = na
    label  ob_label    = na

type FVGData
    int    direction   = 0
    float  top         = na
    float  bottom      = na
    int    fvg_bar     = -1
    float  fill_pct    = 0.0
    bool   filled      = false
    bool   broken      = false
    box    fvg_box     = na
    label  fvg_label   = na

type State
    int    trend             = 0
    bool   initialized       = false
    float  strong_low        = na
    float  strong_high       = na
    int    strong_low_bar    = -1
    int    strong_high_bar   = -1
    int    strong_low_idx    = -1
    int    strong_high_idx   = -1
    float  ref_high          = na
    float  ref_low           = na
    int    ref_high_bar      = -1
    int    ref_low_bar       = -1
    bool   pending_bull_bos      = false
    int    pending_bull_bos_bar  = -1
    bool   pending_bear_bos      = false
    int    pending_bear_bos_bar  = -1
    bool   choch_ref_pending = false
    int    choch_break_bar   = -1
    float  ote_top           = na
    float  ote_bottom        = na
    float  equilibrium       = na
    float  range_high        = na
    float  range_low         = na
    line   strong_low_line   = na
    line   strong_high_line  = na
    box    premium_box       = na
    box    discount_box      = na
    line   eq_line           = na
    box    ote_box           = na
    label  ote_label         = na
    bool   alert_bull_bos    = false
    bool   alert_bear_bos    = false
    bool   alert_bull_choch  = false
    bool   alert_bear_choch  = false
    bool   alert_bsl_sweep   = false
    bool   alert_ssl_sweep   = false
    bool   alert_ob_bull      = false
    bool   alert_ob_bear      = false
    bool   alert_ob_mitigated = false
    bool   alert_fvg_bull     = false
    bool   alert_fvg_bear     = false
    bool   alert_fvg_filled   = false
    int    last_internal_sh_bar   = -1
    float  last_internal_sh_price = na
    int    last_internal_sl_bar   = -1
    float  last_internal_sl_price = na
    int    last_any_sh_bar        = -1
    int    last_any_sl_bar        = -1
    int    last_bos_bar      = -1
    int    last_choch_bar    = -1

var State st = State.new()
var array<SwingPoint> swings = array.new<SwingPoint>()
var array<label> managed_swing_labels  = array.new<label>()
var array<line>  managed_bos_lines     = array.new<line>()
var array<label> managed_bos_labels    = array.new<label>()
var array<line>  managed_choch_lines   = array.new<line>()
var array<label> managed_choch_labels  = array.new<label>()
var array<line>  managed_liq_lines     = array.new<line>()
var array<label> managed_liq_labels    = array.new<label>()
var array<label> managed_sweep_labels  = array.new<label>()
var array<LiquidityPool> liq_pools = array.new<LiquidityPool>()
var array<OBData> all_obs = array.new<OBData>()
var array<FVGData> all_fvgs = array.new<FVGData>()

addManagedLabel(array<label> arr, label lbl, int maxCount) =>
    arr.push(lbl)
    if arr.size() > maxCount
        label.delete(arr.shift())

addManagedLine(array<line> arr, line ln, int maxCount) =>
    arr.push(ln)
    if arr.size() > maxCount
        line.delete(arr.shift())

addSwing(int swType, float swPrice, int swBar) =>
    int result = -1
    int count = swings.size()
    if count > 0
        SwingPoint lastSw = swings.get(count - 1)
        if lastSw.swing_type == swType
            if swType == SWING_HIGH
                if swPrice >= lastSw.price
                    bool priceChanged = swPrice != lastSw.price
                    lastSw.price := swPrice
                    lastSw.bar_idx := swBar
                    if priceChanged
                        lastSw.cls := CLS_UNCLASSIFIED
                        lastSw.broken := false
                        lastSw.broken_bar := -1
                    result := count - 1
            else
                if swPrice <= lastSw.price
                    bool priceChanged = swPrice != lastSw.price
                    lastSw.price := swPrice
                    lastSw.bar_idx := swBar
                    if priceChanged
                        lastSw.cls := CLS_UNCLASSIFIED
                        lastSw.broken := false
                        lastSw.broken_bar := -1
                    result := count - 1
        else
            int searchDepth = math.min(count, 14)
            int searchStart = count - searchDepth
            bool found = false
            for s = count - 1 to searchStart
                SwingPoint swS = swings.get(s)
                if swS.bar_idx == swBar and swS.swing_type == swType
                    if swType == SWING_HIGH and swPrice >= swS.price
                        bool pc = swPrice != swS.price
                        swS.price := swPrice
                        if pc
                            swS.cls := CLS_UNCLASSIFIED
                            swS.broken := false
                            swS.broken_bar := -1
                        result := s
                        found := true
                        break
                    else if swType == SWING_LOW and swPrice <= swS.price
                        bool pc = swPrice != swS.price
                        swS.price := swPrice
                        if pc
                            swS.cls := CLS_UNCLASSIFIED
                            swS.broken := false
                            swS.broken_bar := -1
                        result := s
                        found := true
                        break
                    else
                        result := s
                        found := true
                        break
            if not found
                result := -2
    else
        result := -2
    if result == -2
        SwingPoint newSw = SwingPoint.new(swType, swPrice, swBar, CLS_UNCLASSIFIED, false, -1)
        swings.push(newSw)
        if swings.size() > i_max_swings
            swings.shift()
            if st.strong_low_idx > 0
                st.strong_low_idx -= 1
            else if st.strong_low_idx == 0
                st.strong_low_idx := -1
            if st.strong_high_idx > 0
                st.strong_high_idx -= 1
            else if st.strong_high_idx == 0
                st.strong_high_idx := -1
        result := swings.size() - 1
    result

createSwingLabel(int swBar, float swPrice, int swType, int cls, int trendCtx) =>
    label result = na
    bool isMajor = cls == CLS_MAJOR
    bool isInternal = cls == CLS_INTERNAL or cls == CLS_UNCLASSIFIED
    int useTrend = trendCtx != 0 ? trendCtx : st.trend
    bool shouldShow = true
    if isMajor and not i_show_major
        shouldShow := false
    if isInternal
        shouldShow := false
    if shouldShow
        string txt = ""
        color clr = i_col_internal
        string sz = size.tiny
        if isMajor
            sz := size.small
            if swType == SWING_HIGH
                if useTrend == TREND_BULLISH
                    txt := "HH"
                    clr := i_col_bull_major
                else if useTrend == TREND_BEARISH
                    txt := "LH"
                    clr := i_col_bear_major
                else
                    txt := "H"
            else
                if useTrend == TREND_BULLISH
                    txt := "HL"
                    clr := i_col_hl
                else if useTrend == TREND_BEARISH
                    txt := "LL"
                    clr := i_col_bear_major
                else
                    txt := "L"
        else
            txt := swType == SWING_HIGH ? "iH" : "iL"
        string lblStyle = swType == SWING_HIGH ? label.style_label_down : label.style_label_up
        result := label.new(swBar, swPrice, txt, xloc.bar_index, yloc.price,
             color.new(color.black, 100), lblStyle, clr, sz, text.align_center)
        addManagedLabel(managed_swing_labels, result, i_max_swing_labels)
    result

relabelSwing(SwingPoint sw, int cls, int trendCtx) =>
    if not na(sw.lbl)
        label.delete(sw.lbl)
        sw.lbl := na
    sw.cls := cls
    sw.lbl := createSwingLabel(sw.bar_idx, sw.price, sw.swing_type, cls, trendCtx)

findLowestSwingLowBetween(int barStart, int barEnd) =>
    int candidate = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.bar_idx <= barStart
            break
        if sw.bar_idx >= barEnd
            continue
        if sw.swing_type == SWING_LOW
            if candidate == -1 or sw.price < swings.get(candidate).price
                candidate := i
    candidate

findHighestSwingHighBetween(int barStart, int barEnd) =>
    int candidate = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.bar_idx <= barStart
            break
        if sw.bar_idx >= barEnd
            continue
        if sw.swing_type == SWING_HIGH
            if candidate == -1 or sw.price > swings.get(candidate).price
                candidate := i
    candidate

findLastSwingHighBefore(int bar) =>
    int result = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.swing_type == SWING_HIGH and sw.bar_idx < bar
            result := i
            break
    result

findLastSwingLowBefore(int bar) =>
    int result = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.swing_type == SWING_LOW and sw.bar_idx < bar
            result := i
            break
    result

findLowestBarLowBetween(int barStart, int barEnd) =>
    int bestBar = -1
    float bestPrice = na
    if barEnd > barStart + 1
        for j = barStart + 1 to barEnd - 1
            int offset = bar_index - j
            if offset >= 0
                float barLow = low[offset]
                if na(bestPrice) or barLow < bestPrice
                    bestPrice := barLow
                    bestBar := j
    [bestBar, bestPrice]

findHighestBarHighBetween(int barStart, int barEnd) =>
    int bestBar = -1
    float bestPrice = na
    if barEnd > barStart + 1
        for j = barStart + 1 to barEnd - 1
            int offset = bar_index - j
            if offset >= 0
                float barHigh = high[offset]
                if na(bestPrice) or barHigh > bestPrice
                    bestPrice := barHigh
                    bestBar := j
    [bestBar, bestPrice]

findSwingAtBar(int targetBar, int swType) =>
    int result = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.bar_idx == targetBar and sw.swing_type == swType
            result := i
            break
        if sw.bar_idx < targetBar
            break
    result

checkBreakAbove(float level, float closePrice, float highPrice) =>
    if na(level)
        false
    else
        i_break_mode == "Close" ? closePrice > level : highPrice > level

checkBreakBelow(float level, float closePrice, float lowPrice) =>
    if na(level)
        false
    else
        i_break_mode == "Close" ? closePrice < level : lowPrice < level

tryInitialize() =>
    bool success = false
    int count = swings.size()
    if count >= 4
        for start = 0 to count - 4
            if success
                break
            int s1 = start
            int s2 = start + 1
            int s3 = start + 2
            int s4 = start + 3
            SwingPoint sw1 = swings.get(s1)
            SwingPoint sw2 = swings.get(s2)
            SwingPoint sw3 = swings.get(s3)
            SwingPoint sw4 = swings.get(s4)
            if sw1.swing_type == SWING_LOW and sw2.swing_type == SWING_HIGH and sw3.swing_type == SWING_LOW and sw4.swing_type == SWING_HIGH
                if sw4.price > sw2.price and sw3.price > sw1.price
                    st.trend := TREND_BULLISH
                    st.strong_low := sw3.price
                    st.strong_low_bar := sw3.bar_idx
                    st.strong_low_idx := s3
                    st.ref_high := sw4.price
                    st.ref_high_bar := sw4.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true
                else if sw4.price < sw2.price and sw3.price < sw1.price
                    st.trend := TREND_BEARISH
                    st.strong_high := sw2.price
                    st.strong_high_bar := sw2.bar_idx
                    st.strong_high_idx := s2
                    st.ref_low := sw4.price
                    st.ref_low_bar := sw4.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true
            else if sw1.swing_type == SWING_HIGH and sw2.swing_type == SWING_LOW and sw3.swing_type == SWING_HIGH and sw4.swing_type == SWING_LOW
                if sw3.price > sw1.price and sw4.price > sw2.price
                    st.trend := TREND_BULLISH
                    st.strong_low := sw4.price
                    st.strong_low_bar := sw4.bar_idx
                    st.strong_low_idx := s4
                    st.ref_high := sw3.price
                    st.ref_high_bar := sw3.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true
                else if sw3.price < sw1.price and sw4.price < sw2.price
                    st.trend := TREND_BEARISH
                    st.strong_high := sw1.price
                    st.strong_high_bar := sw1.bar_idx
                    st.strong_high_idx := s1
                    st.ref_low := sw4.price
                    st.ref_low_bar := sw4.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true
    if not success and count >= 8
        SwingPoint firstSw = swings.get(0)
        SwingPoint lastSw = swings.get(count - 1)
        if lastSw.price > firstSw.price
            st.trend := TREND_BULLISH
            int slIdx = findLastSwingLowBefore(lastSw.bar_idx + 1)
            int shIdx = findLastSwingHighBefore(lastSw.bar_idx + 1)
            if slIdx >= 0
                st.strong_low := swings.get(slIdx).price
                st.strong_low_bar := swings.get(slIdx).bar_idx
                st.strong_low_idx := slIdx
            if shIdx >= 0
                st.ref_high := swings.get(shIdx).price
                st.ref_high_bar := swings.get(shIdx).bar_idx
        else
            st.trend := TREND_BEARISH
            int shIdx = findLastSwingHighBefore(lastSw.bar_idx + 1)
            int slIdx = findLastSwingLowBefore(lastSw.bar_idx + 1)
            if shIdx >= 0
                st.strong_high := swings.get(shIdx).price
                st.strong_high_bar := swings.get(shIdx).bar_idx
                st.strong_high_idx := shIdx
            if slIdx >= 0
                st.ref_low := swings.get(slIdx).price
                st.ref_low_bar := swings.get(slIdx).bar_idx
        for k = 0 to count - 1
            SwingPoint swK = swings.get(k)
            swK.cls := CLS_MAJOR
        success := true
    success

drawBOSLine(int barFrom, float priceLevel, int barTo, bool isBullish) =>
    if i_show_bos and barFrom >= 0 and barTo >= 0
        color clr = isBullish ? i_col_bos_bull : i_col_bos_bear
        line ln = line.new(barFrom, priceLevel, barTo, priceLevel, xloc.bar_index, extend.none, clr, line.style_dashed, 1)
        addManagedLine(managed_bos_lines, ln, i_max_bos_objects)
        int midBar = math.round((barFrom + barTo) / 2)
        label lbl = label.new(midBar, priceLevel, "BOS", xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.tiny, text.align_center)
        addManagedLabel(managed_bos_labels, lbl, i_max_bos_objects)

drawCHOCHLine(int barFrom, float priceLevel, int barTo, bool newTrendBullish) =>
    if i_show_choch and barFrom >= 0 and barTo >= 0
        color clr = newTrendBullish ? i_col_choch_bull : i_col_choch_bear
        line ln = line.new(barFrom, priceLevel, barTo, priceLevel, xloc.bar_index, extend.none, clr, line.style_solid, 2)
        addManagedLine(managed_choch_lines, ln, i_max_choch_objects)
        int midBar = math.round((barFrom + barTo) / 2)
        label lbl = label.new(midBar, priceLevel, "CHoCH", xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.small, text.align_center)
        addManagedLabel(managed_choch_labels, lbl, i_max_choch_objects)

drawStrongLevel(bool isLow, int barFrom, float price) =>
    if i_show_strong and not na(price) and barFrom >= 0
        color clr = isLow ? i_col_hl : i_col_bear_major
        if isLow
            if not na(st.strong_low_line)
                line.delete(st.strong_low_line)
            st.strong_low_line := line.new(barFrom, price, bar_index, price, xloc.bar_index, extend.right, clr, line.style_dotted, 1)
        else
            if not na(st.strong_high_line)
                line.delete(st.strong_high_line)
            st.strong_high_line := line.new(barFrom, price, bar_index, price, xloc.bar_index, extend.right, clr, line.style_dotted, 1)

updateZones() =>
    if not na(st.premium_box)
        box.delete(st.premium_box)
        st.premium_box := na
    if not na(st.discount_box)
        box.delete(st.discount_box)
        st.discount_box := na
    if not na(st.eq_line)
        line.delete(st.eq_line)
        st.eq_line := na
    int rangeStartBar = -1
    if st.trend == TREND_BULLISH
        st.range_high := st.ref_high
        st.range_low := st.strong_low
        rangeStartBar := st.strong_low_bar
    else if st.trend == TREND_BEARISH
        st.range_high := st.strong_high
        st.range_low := st.ref_low
        rangeStartBar := st.strong_high_bar
    if not na(st.range_high) and not na(st.range_low) and rangeStartBar >= 0
        st.equilibrium := (st.range_high + st.range_low) / 2.0
        if i_show_pd
            st.premium_box := box.new(rangeStartBar, st.range_high, bar_index, st.equilibrium, color(na), 0, line.style_solid, extend.none, xloc.bar_index, color.new(i_col_premium, 93))
            st.discount_box := box.new(rangeStartBar, st.equilibrium, bar_index, st.range_low, color(na), 0, line.style_solid, extend.none, xloc.bar_index, color.new(i_col_discount, 93))
        if i_show_eq
            st.eq_line := line.new(rangeStartBar, st.equilibrium, bar_index, st.equilibrium, xloc.bar_index, extend.right, i_col_eq_line, line.style_dashed, 1)

updateOTE(bool isBullish) =>
    if not na(st.ote_box)
        box.delete(st.ote_box)
        st.ote_box := na
    if not na(st.ote_label)
        label.delete(st.ote_label)
        st.ote_label := na
    if i_show_ote
        float swHigh = na
        float swLow = na
        int oteStart = -1
        if isBullish
            swLow := st.strong_low
            swHigh := st.ref_high
            oteStart := st.strong_low_bar
        else
            swHigh := st.strong_high
            swLow := st.ref_low
            oteStart := st.strong_high_bar
        if not na(swHigh) and not na(swLow) and oteStart >= 0
            float rng = swHigh - swLow
            if rng > 0
                if isBullish
                    st.ote_top := swHigh - rng * 0.618
                    st.ote_bottom := swHigh - rng * 0.786
                else
                    st.ote_top := swLow + rng * 0.786
                    st.ote_bottom := swLow + rng * 0.618
                st.ote_box := box.new(oteStart, st.ote_top, bar_index, st.ote_bottom, i_col_ote, 1, line.style_solid, extend.none, xloc.bar_index, color.new(i_col_ote, 90))
                int midBar = math.round((oteStart + bar_index) / 2)
                float midPrice = (st.ote_top + st.ote_bottom) / 2.0
                st.ote_label := label.new(midBar, midPrice, "OTE", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_ote, size.small, text.align_center)

clearOTE() =>
    if not na(st.ote_box)
        box.delete(st.ote_box)
        st.ote_box := na
    if not na(st.ote_label)
        label.delete(st.ote_label)
        st.ote_label := na
    st.ote_top := na
    st.ote_bottom := na

hasFVGBetween(int fromBar, int toBar, bool isBullish) =>
    bool result = false
    if toBar >= fromBar
        for j = fromBar to toBar
            int off0 = bar_index - j
            int off2 = bar_index - (j + 2)
            if off0 >= 0 and off2 >= 0 and off0 < bar_index and off2 < bar_index
                if isBullish
                    if low[off2] > high[off0]
                        result := true
                        break
                else
                    if high[off2] < low[off0]
                        result := true
                        break
    result

obExistsAtBar(int barIdx) =>
    bool found = false
    if all_obs.size() > 0
        for i = 0 to all_obs.size() - 1
            if all_obs.get(i).ob_bar == barIdx
                found := true
                break
    found

checkImmediateOBMitigation(OBData ob) =>
    bool mitigated = false
    if i_ob_imm_mit_pct > 0.0 and ob.state == "active"
        float zoneDepth = ob.top - ob.bottom
        if zoneDepth > 0
            float threshold = zoneDepth * i_ob_imm_mit_pct
            int startBar = ob.ob_bar + 4
            int endBar = bar_index
            if endBar > startBar
                for j = startBar to endBar
                    int offset = bar_index - j
                    if offset >= 0 and offset < bar_index
                        if ob.direction == 1
                            float candleLow = low[offset]
                            if candleLow <= ob.top
                                float penetration = ob.top - math.max(candleLow, ob.bottom)
                                if penetration >= threshold
                                    mitigated := true
                                    break
                        else
                            float candleHigh = high[offset]
                            if candleHigh >= ob.bottom
                                float penetration = math.min(candleHigh, ob.top) - ob.bottom
                                if penetration >= threshold
                                    mitigated := true
                                    break
        if mitigated
            ob.state := "tested"
            st.alert_ob_mitigated := true
            if i_debug_ob
                log.warning("OB bar={0} dir={1} → IMMEDIATELY MITIGATED (price overlapped zone before confirmation)", ob.ob_bar, ob.direction)
    true

createOB(int dir, float obTop, float obBottom, int obBar, int src, float bosLevel) =>
    if not obExistsAtBar(obBar)
        OBData ob = OBData.new(dir, obTop, obBottom, obBar, src, "active", bosLevel)
        all_obs.push(ob)
        if i_debug_ob
            log.info("NEW OB: bar={0} dir={1} src={2} top={3} bot={4} bos_level={5}", obBar, dir, src, obTop, obBottom, bosLevel)
        if all_obs.size() > i_max_stored_ob
            OBData old = all_obs.shift()
            if not na(old.ob_box)
                box.delete(old.ob_box)
            if not na(old.ob_label)
                label.delete(old.ob_label)
        if dir == 1
            st.alert_ob_bull := true
        else
            st.alert_ob_bear := true
        checkImmediateOBMitigation(ob)

detectBOSLinkedOB(bool isBullish, int breakBar, int src, int obBar, float obHigh, float obLow, float bosLevel) =>
    if i_show_ob and (i_ob_mode == "BOS/CHOCH" or i_ob_mode == "Both")
        if obBar >= 0 and not na(obHigh) and not na(obLow)
            if hasFVGBetween(obBar, breakBar, isBullish)
                if isBullish
                    createOB(1, obHigh, obLow, obBar, src, bosLevel)
                else
                    createOB(-1, obHigh, obLow, obBar, src, bosLevel)

detectStandaloneOBs() =>
    if i_show_ob and (i_ob_mode == "Displacement" or i_ob_mode == "Both")
        if bar_index > 4
            bool bullGap2 = high[2] < low[0] and high[2] < high[0]
            bool bullSweep2 = low[2] < low[1] and low[2] < low[3]
            if bullGap2 and bullSweep2
                int obBar2 = bar_index - 2
                createOB(1, high[2], low[2], obBar2, 3, na)
            bool bullGap3 = high[3] < low[0] and high[3] < high[0]
            bool bullSweep3 = low[3] < low[2] and low[3] < low[4]
            if bullGap3 and bullSweep3
                int obBar3 = bar_index - 3
                createOB(1, high[3], low[3], obBar3, 3, na)
            bool bearGap2 = low[2] > high[0] and low[2] > low[0]
            bool bearSweep2 = high[2] > high[1] and high[2] > high[3]
            if bearGap2 and bearSweep2
                int obBar2 = bar_index - 2
                createOB(-1, high[2], low[2], obBar2, 3, na)
            bool bearGap3 = low[3] > high[0] and low[3] > low[0]
            bool bearSweep3 = high[3] > high[2] and high[3] > high[4]
            if bearGap3 and bearSweep3
                int obBar3 = bar_index - 3
                createOB(-1, high[3], low[3], obBar3, 3, na)

detectFVGs() =>
    if i_show_fvg and bar_index > 3
        float atrVal = nz(ta.atr(14))
        float minGap = i_fvg_min_atr_mult > 0 ? atrVal * i_fvg_min_atr_mult : 0.0
        if low[0] > high[2]
            float gapSize = low[0] - high[2]
            if gapSize > minGap
                FVGData fvg = FVGData.new(1, low[0], high[2], bar_index - 1, 0.0, false, false)
                all_fvgs.push(fvg)
                if all_fvgs.size() > i_max_stored_fvg
                    FVGData old = all_fvgs.shift()
                    if not na(old.fvg_box)
                        box.delete(old.fvg_box)
                    if not na(old.fvg_label)
                        label.delete(old.fvg_label)
                st.alert_fvg_bull := true
        if high[0] < low[2]
            float gapSize = low[2] - high[0]
            if gapSize > minGap
                FVGData fvg = FVGData.new(-1, low[2], high[0], bar_index - 1, 0.0, false, false)
                all_fvgs.push(fvg)
                if all_fvgs.size() > i_max_stored_fvg
                    FVGData old = all_fvgs.shift()
                    if not na(old.fvg_box)
                        box.delete(old.fvg_box)
                    if not na(old.fvg_label)
                        label.delete(old.fvg_label)
                st.alert_fvg_bear := true

clearOBDrawing(OBData ob) =>
    if not na(ob.ob_box)
        box.delete(ob.ob_box)
        ob.ob_box := na
    if not na(ob.ob_label)
        label.delete(ob.ob_label)
        ob.ob_label := na
    true

updateOBMitigation() =>
    if all_obs.size() > 0
        for i = 0 to all_obs.size() - 1
            OBData ob = all_obs.get(i)
            if ob.state == "reversed"
                continue
            if ob.state == "breaker"
                if ob.direction == 1
                    if close > ob.top
                        ob.state := "reversed"
                        clearOBDrawing(ob)
                        continue
                else
                    if close < ob.bottom
                        ob.state := "reversed"
                        clearOBDrawing(ob)
                        continue
                if not ob.swing_after_breaker and ob.breaker_bar >= 0
                    if ob.direction == 1
                        if st.last_any_sl_bar > ob.breaker_bar
                            ob.swing_after_breaker := true
                    else
                        if st.last_any_sh_bar > ob.breaker_bar
                            ob.swing_after_breaker := true
                if ob.swing_after_breaker
                    if ob.direction == 1
                        if high >= ob.bottom and high <= ob.top
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                    else
                        if low <= ob.top and low >= ob.bottom
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                continue
            if ob.state == "active" or ob.state == "tested"
                bool broken = false
                if ob.direction == 1
                    broken := close < ob.bottom
                else
                    broken := close > ob.top
                if broken
                    if (ob.source == 1 or ob.source == 2) and not ob.was_breaker
                        ob.state := "breaker"
                        ob.breaker_bar := bar_index
                        ob.swing_after_breaker := false
                        ob.was_breaker := true
                        clearOBDrawing(ob)
                    else
                        ob.state := "reversed"
                        clearOBDrawing(ob)
                    st.alert_ob_mitigated := true
                    continue
            if ob.state == "active"
                if i_debug_ob and barstate.isconfirmed and ob.source != 3
                    log.info("OB bar={0} dir={1} src={2} top={3} bot={4} bos={5} pullback={6} | low={7} high={8} | iSH_bar={9} iSH_px={10}",
                         ob.ob_bar, ob.direction, ob.source,
                         ob.top, ob.bottom, ob.bos_level, ob.pullback_confirmed,
                         low, high, st.last_internal_sh_bar, st.last_internal_sh_price)
                if (ob.source == 1 or ob.source == 2) and not na(ob.bos_level) and not ob.pullback_confirmed
                    if ob.direction == 1
                        if st.last_internal_sh_bar > ob.ob_bar and not na(st.last_internal_sh_price)
                            if st.last_internal_sh_price < ob.bos_level
                                ob.pullback_confirmed := true
                                if i_debug_ob
                                    log.warning("OB bar={0} PULLBACK CONFIRMED: iSH={1} < bos={2}", ob.ob_bar, st.last_internal_sh_price, ob.bos_level)
                    else
                        if st.last_internal_sl_bar > ob.ob_bar and not na(st.last_internal_sl_price)
                            if st.last_internal_sl_price > ob.bos_level
                                ob.pullback_confirmed := true
                                if i_debug_ob
                                    log.warning("OB bar={0} PULLBACK CONFIRMED: iSL={1} > bos={2}", ob.ob_bar, st.last_internal_sl_price, ob.bos_level)
                if ob.pullback_confirmed
                    if ob.direction == 1
                        if low <= ob.top and low >= ob.bottom
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                            if i_debug_ob
                                log.warning("OB bar={0} → TESTED via Path 1 (pullback)", ob.ob_bar)
                            continue
                    else
                        if high >= ob.bottom and high <= ob.top
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                            if i_debug_ob
                                log.warning("OB bar={0} → TESTED via Path 1 (pullback)", ob.ob_bar)
                            continue
                if ob.direction == 1
                    if low <= ob.top and low >= ob.bottom
                        ob.state := "tested"
                        st.alert_ob_mitigated := true
                        clearOBDrawing(ob)
                        if i_debug_ob
                            log.warning("OB bar={0} → TESTED via Path 2 (simple touch)", ob.ob_bar)
                else
                    if high >= ob.bottom and high <= ob.top
                        ob.state := "tested"
                        st.alert_ob_mitigated := true
                        clearOBDrawing(ob)
                        if i_debug_ob
                            log.warning("OB bar={0} → TESTED via Path 2 (simple touch)", ob.ob_bar)

updateFVGMitigation() =>
    if all_fvgs.size() > 0
        for i = 0 to all_fvgs.size() - 1
            FVGData fvg = all_fvgs.get(i)
            if not fvg.broken
                float gapSize = fvg.top - fvg.bottom
                if gapSize > 0
                    if fvg.direction == 1
                        if low < fvg.top
                            float fillDepth = fvg.top - math.max(low, fvg.bottom)
                            float pct = fillDepth / gapSize
                            if pct > fvg.fill_pct
                                fvg.fill_pct := pct
                            if fvg.fill_pct >= i_fvg_fill_pct and not fvg.filled
                                fvg.filled := true
                                st.alert_fvg_filled := true
                        if close < fvg.bottom
                            fvg.broken := true
                    else
                        if high > fvg.bottom
                            float fillDepth = math.min(high, fvg.top) - fvg.bottom
                            float pct = fillDepth / gapSize
                            if pct > fvg.fill_pct
                                fvg.fill_pct := pct
                            if fvg.fill_pct >= i_fvg_fill_pct and not fvg.filled
                                fvg.filled := true
                                st.alert_fvg_filled := true
                        if close > fvg.top
                            fvg.broken := true

clearFVGDrawing(FVGData fvg) =>
    if not na(fvg.fvg_box)
        box.delete(fvg.fvg_box)
        fvg.fvg_box := na
    if not na(fvg.fvg_label)
        label.delete(fvg.fvg_label)
        fvg.fvg_label := na
    true

drawSingleOB(OBData ob, color clr) =>
    int leftBar = math.max(ob.ob_bar, bar_index - 4999)
    if na(ob.ob_box)
        ob.ob_box := box.new(leftBar, ob.top, bar_index, ob.bottom, clr, 1, line.style_solid, extend.none, xloc.bar_index, color.new(clr, 90))
        string srcTxt = ""
        if ob.state == "breaker"
            srcTxt := ob.direction == 1 ? "Breaker R" : "Breaker S"
        else if ob.state == "tested"
            string base = ob.source == 1 ? "OB (BOS)" : ob.source == 2 ? "OB (CHoCH)" : "OB (Disp)"
            srcTxt := base + " ✓"
        else
            srcTxt := ob.source == 1 ? "OB (BOS)" : ob.source == 2 ? "OB (CHoCH)" : "OB (Disp)"
        ob.ob_label := label.new(leftBar, (ob.top + ob.bottom) / 2.0, srcTxt, xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.tiny, text.align_left)
    else
        box.set_right(ob.ob_box, bar_index)
        box.set_bgcolor(ob.ob_box, color.new(clr, 90))
        box.set_border_color(ob.ob_box, clr)
        if not na(ob.ob_label)
            label.set_textcolor(ob.ob_label, clr)
    true

drawSingleFVG(FVGData fvg, color clr) =>
    int leftBar = math.max(fvg.fvg_bar, bar_index - 4999)
    if na(fvg.fvg_box)
        fvg.fvg_box := box.new(leftBar, fvg.top, bar_index, fvg.bottom, clr, 1, line.style_solid, extend.none, xloc.bar_index, color.new(clr, 90))
        fvg.fvg_label := label.new(leftBar, (fvg.top + fvg.bottom) / 2.0, "FVG", xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.tiny, text.align_left)
    else
        box.set_right(fvg.fvg_box, bar_index)
        box.set_bgcolor(fvg.fvg_box, color.new(clr, 90))
        box.set_border_color(fvg.fvg_box, clr)
        if not na(fvg.fvg_label)
            label.set_textcolor(fvg.fvg_label, clr)
    true

isInVisibleSet(array<int> visible, int idx) =>
    bool found = false
    if visible.size() > 0
        for v = 0 to visible.size() - 1
            if visible.get(v) == idx
                found := true
                break
    found

selectNClosest(array<int> indices, array<float> distances, int maxN) =>
    array<int> result = array.new<int>()
    if indices.size() > 0
        array<float> dCopy = distances.copy()
        for n = 0 to math.min(maxN, indices.size()) - 1
            float minDist = 1e18
            int minIdx = -1
            for j = 0 to indices.size() - 1
                if dCopy.get(j) < minDist
                    minDist := dCopy.get(j)
                    minIdx := j
            if minIdx >= 0
                result.push(indices.get(minIdx))
                dCopy.set(minIdx, 1e18)
    result

drawProximityOBs() =>
    if all_obs.size() > 0
        if not i_show_ob
            for i = 0 to all_obs.size() - 1
                clearOBDrawing(all_obs.get(i))
        else
            array<int> bullActiveIdx = array.new<int>()
            array<float> bullActiveDist = array.new<float>()
            array<int> bullSecondIdx = array.new<int>()
            array<float> bullSecondDist = array.new<float>()
            array<int> bearActiveIdx = array.new<int>()
            array<float> bearActiveDist = array.new<float>()
            array<int> bearSecondIdx = array.new<int>()
            array<float> bearSecondDist = array.new<float>()
            for i = 0 to all_obs.size() - 1
                OBData ob = all_obs.get(i)
                bool eligible = true
                bool isSecondary = false
                if ob.state == "reversed"
                    eligible := false
                else if ob.state == "breaker"
                    if not i_show_breaker_ob
                        eligible := false
                    if eligible
                        isSecondary := true
                else if ob.state == "tested"
                    if not i_show_mitigated_ob
                        eligible := false
                    if eligible
                        isSecondary := true
                else
                    if ob.direction == 1 and not i_show_bull_ob
                        eligible := false
                    if eligible and ob.direction == -1 and not i_show_bear_ob
                        eligible := false
                if not eligible
                    clearOBDrawing(ob)
                else
                    float mid = (ob.top + ob.bottom) / 2.0
                    float dist = math.abs(close - mid)
                    if ob.direction == 1
                        if isSecondary
                            bullSecondIdx.push(i)
                            bullSecondDist.push(dist)
                        else
                            bullActiveIdx.push(i)
                            bullActiveDist.push(dist)
                    else
                        if isSecondary
                            bearSecondIdx.push(i)
                            bearSecondDist.push(dist)
                        else
                            bearActiveIdx.push(i)
                            bearActiveDist.push(dist)
            array<int> bullVisible = selectNClosest(bullActiveIdx, bullActiveDist, i_max_visible_ob)
            int bullRemaining = i_max_visible_ob - bullVisible.size()
            if bullRemaining > 0 and bullSecondIdx.size() > 0
                array<int> bsv = selectNClosest(bullSecondIdx, bullSecondDist, bullRemaining)
                if bsv.size() > 0
                    for s = 0 to bsv.size() - 1
                        bullVisible.push(bsv.get(s))
            array<int> bearVisible = selectNClosest(bearActiveIdx, bearActiveDist, i_max_visible_ob)
            int bearRemaining = i_max_visible_ob - bearVisible.size()
            if bearRemaining > 0 and bearSecondIdx.size() > 0
                array<int> bsv2 = selectNClosest(bearSecondIdx, bearSecondDist, bearRemaining)
                if bsv2.size() > 0
                    for s = 0 to bsv2.size() - 1
                        bearVisible.push(bsv2.get(s))
            array<int> visible = array.new<int>()
            if bullVisible.size() > 0
                for s = 0 to bullVisible.size() - 1
                    visible.push(bullVisible.get(s))
            if bearVisible.size() > 0
                for s = 0 to bearVisible.size() - 1
                    visible.push(bearVisible.get(s))
            for i = 0 to all_obs.size() - 1
                OBData ob = all_obs.get(i)
                if isInVisibleSet(visible, i)
                    color clr = i_col_ob_bull
                    if ob.state == "breaker"
                        clr := ob.direction == 1 ? i_col_breaker_resist : i_col_breaker_support
                    else if ob.state == "tested"
                        clr := i_col_ob_mitigated
                    else
                        clr := ob.direction == 1 ? i_col_ob_bull : i_col_ob_bear
                    drawSingleOB(ob, clr)
                else
                    clearOBDrawing(ob)
    true

drawProximityFVGs() =>
    if all_fvgs.size() > 0
        if not i_show_fvg
            for i = 0 to all_fvgs.size() - 1
                clearFVGDrawing(all_fvgs.get(i))
        else
            array<int> bullIdx = array.new<int>()
            array<float> bullDist = array.new<float>()
            array<int> bearIdx = array.new<int>()
            array<float> bearDist = array.new<float>()
            for i = 0 to all_fvgs.size() - 1
                FVGData fvg = all_fvgs.get(i)
                bool eligible = true
                if fvg.broken
                    eligible := false
                if eligible and fvg.filled and not i_show_filled_fvg
                    eligible := false
                if eligible and fvg.direction == 1 and not i_show_bull_fvg
                    eligible := false
                if eligible and fvg.direction == -1 and not i_show_bear_fvg
                    eligible := false
                if not eligible
                    clearFVGDrawing(fvg)
                else
                    float mid = (fvg.top + fvg.bottom) / 2.0
                    float dist = math.abs(close - mid)
                    if fvg.direction == 1
                        bullIdx.push(i)
                        bullDist.push(dist)
                    else
                        bearIdx.push(i)
                        bearDist.push(dist)
            array<int> bullVisible = selectNClosest(bullIdx, bullDist, i_max_visible_fvg)
            array<int> bearVisible = selectNClosest(bearIdx, bearDist, i_max_visible_fvg)
            array<int> visible = array.new<int>()
            if bullVisible.size() > 0
                for s = 0 to bullVisible.size() - 1
                    visible.push(bullVisible.get(s))
            if bearVisible.size() > 0
                for s = 0 to bearVisible.size() - 1
                    visible.push(bearVisible.get(s))
            for i = 0 to all_fvgs.size() - 1
                FVGData fvg = all_fvgs.get(i)
                if isInVisibleSet(visible, i)
                    color clr = fvg.filled ? i_col_fvg_filled : (fvg.direction == 1 ? i_col_fvg_bull : i_col_fvg_bear)
                    drawSingleFVG(fvg, clr)
                else
                    clearFVGDrawing(fvg)
    true

fireBullishBOS(int breakBar) =>
    drawBOSLine(st.ref_high_bar, st.ref_high, breakBar, true)
    st.pending_bull_bos := true
    st.pending_bull_bos_bar := breakBar
    [hlBar, hlPrice] = findLowestBarLowBetween(st.ref_high_bar, breakBar)
    if hlBar >= 0 and not na(hlPrice)
        st.strong_low := hlPrice
        st.strong_low_bar := hlBar
        int hlSwIdx = findSwingAtBar(hlBar, SWING_LOW)
        st.strong_low_idx := hlSwIdx
        if hlSwIdx >= 0
            SwingPoint hlSw = swings.get(hlSwIdx)
            if hlSw.cls != CLS_MAJOR
                relabelSwing(hlSw, CLS_MAJOR, 0)
        else
            createSwingLabel(hlBar, hlPrice, SWING_LOW, CLS_MAJOR, 0)
        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
    updateZones()
    updateOTE(true)
    int hlOff = hlBar >= 0 ? bar_index - hlBar : -1
    float hlTop = hlOff >= 0 ? high[hlOff] : na
    detectBOSLinkedOB(true, breakBar, 1, hlBar, hlTop, hlPrice, st.ref_high)
    st.alert_bull_bos := true

fireBearishBOS(int breakBar) =>
    drawBOSLine(st.ref_low_bar, st.ref_low, breakBar, false)
    st.pending_bear_bos := true
    st.pending_bear_bos_bar := breakBar
    [lhBar, lhPrice] = findHighestBarHighBetween(st.ref_low_bar, breakBar)
    if lhBar >= 0 and not na(lhPrice)
        st.strong_high := lhPrice
        st.strong_high_bar := lhBar
        int lhSwIdx = findSwingAtBar(lhBar, SWING_HIGH)
        st.strong_high_idx := lhSwIdx
        if lhSwIdx >= 0
            SwingPoint lhSw = swings.get(lhSwIdx)
            if lhSw.cls != CLS_MAJOR
                relabelSwing(lhSw, CLS_MAJOR, 0)
        else
            createSwingLabel(lhBar, lhPrice, SWING_HIGH, CLS_MAJOR, 0)
        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
    updateZones()
    updateOTE(false)
    int lhOff = lhBar >= 0 ? bar_index - lhBar : -1
    float lhBottom = lhOff >= 0 ? low[lhOff] : na
    detectBOSLinkedOB(false, breakBar, 1, lhBar, lhPrice, lhBottom, st.ref_low)
    st.alert_bear_bos := true

processBearishCHOCH(int breakBar) =>
    drawCHOCHLine(st.strong_low_bar, st.strong_low, breakBar, false)
    st.trend := TREND_BEARISH
    if not na(st.ref_high)
        st.strong_high := st.ref_high
        st.strong_high_bar := st.ref_high_bar
        st.strong_high_idx := -1
        for k = swings.size() - 1 to 0
            SwingPoint sw = swings.get(k)
            if sw.swing_type == SWING_HIGH and sw.bar_idx == st.ref_high_bar
                st.strong_high_idx := k
                sw.cls := CLS_MAJOR
                break
        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
    else
        int newShIdx = findLastSwingHighBefore(breakBar)
        if newShIdx >= 0
            SwingPoint sw = swings.get(newShIdx)
            sw.cls := CLS_MAJOR
            st.strong_high := sw.price
            st.strong_high_bar := sw.bar_idx
            st.strong_high_idx := newShIdx
            drawStrongLevel(false, st.strong_high_bar, st.strong_high)
    int newSlIdx = findLastSwingLowBefore(breakBar + 1)
    if newSlIdx >= 0
        SwingPoint sw = swings.get(newSlIdx)
        st.ref_low := sw.price
        st.ref_low_bar := sw.bar_idx
        if sw.cls != CLS_MAJOR
            relabelSwing(sw, CLS_MAJOR, 0)
    if st.pending_bull_bos and st.ref_high_bar >= 0
        int actualHh = findHighestSwingHighBetween(st.ref_high_bar, breakBar + 1)
        int hhBar = actualHh >= 0 ? swings.get(actualHh).bar_idx : breakBar
        [betterHlBar, betterHlPrice] = findLowestBarLowBetween(st.ref_high_bar, hhBar + 1)
        if betterHlBar >= 0 and not na(betterHlPrice) and (na(st.strong_low) or betterHlPrice < st.strong_low)
            st.strong_low := betterHlPrice
            st.strong_low_bar := betterHlBar
            int betterHlSwIdx = findSwingAtBar(betterHlBar, SWING_LOW)
            st.strong_low_idx := betterHlSwIdx
            if betterHlSwIdx >= 0
                SwingPoint hlSw = swings.get(betterHlSwIdx)
                if hlSw.cls != CLS_MAJOR
                    relabelSwing(hlSw, CLS_MAJOR, TREND_BULLISH)
            else
                createSwingLabel(betterHlBar, betterHlPrice, SWING_LOW, CLS_MAJOR, TREND_BULLISH)
        if actualHh >= 0
            SwingPoint hhSw = swings.get(actualHh)
            if hhSw.cls != CLS_MAJOR
                relabelSwing(hhSw, CLS_MAJOR, TREND_BULLISH)
            if hhSw.price > st.strong_high or na(st.strong_high)
                st.strong_high := hhSw.price
                st.strong_high_bar := hhSw.bar_idx
                st.strong_high_idx := actualHh
                drawStrongLevel(false, st.strong_high_bar, st.strong_high)
    [chochLhBar, chochLhHigh] = findHighestBarHighBetween(st.strong_low_bar, breakBar)
    int chochLhOff = chochLhBar >= 0 ? bar_index - chochLhBar : -1
    float chochLhLow = chochLhOff >= 0 ? low[chochLhOff] : na
    float chochBosLevel = st.strong_low
    st.strong_low := na
    st.strong_low_bar := -1
    st.strong_low_idx := -1
    st.ref_high := na
    st.ref_high_bar := -1
    if not na(st.strong_low_line)
        line.delete(st.strong_low_line)
        st.strong_low_line := na
    st.pending_bull_bos := false
    st.pending_bull_bos_bar := -1
    st.choch_ref_pending := true
    st.choch_break_bar := breakBar
    clearOTE()
    updateZones()
    detectBOSLinkedOB(false, breakBar, 2, chochLhBar, chochLhHigh, chochLhLow, chochBosLevel)
    st.alert_bear_choch := true

processBullishCHOCH(int breakBar) =>
    drawCHOCHLine(st.strong_high_bar, st.strong_high, breakBar, true)
    st.trend := TREND_BULLISH
    if not na(st.ref_low)
        st.strong_low := st.ref_low
        st.strong_low_bar := st.ref_low_bar
        st.strong_low_idx := -1
        for k = swings.size() - 1 to 0
            SwingPoint sw = swings.get(k)
            if sw.swing_type == SWING_LOW and sw.bar_idx == st.ref_low_bar
                st.strong_low_idx := k
                sw.cls := CLS_MAJOR
                break
        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
    else
        int newSlIdx = findLastSwingLowBefore(breakBar)
        if newSlIdx >= 0
            SwingPoint sw = swings.get(newSlIdx)
            sw.cls := CLS_MAJOR
            st.strong_low := sw.price
            st.strong_low_bar := sw.bar_idx
            st.strong_low_idx := newSlIdx
            drawStrongLevel(true, st.strong_low_bar, st.strong_low)
    int newShIdx = findLastSwingHighBefore(breakBar + 1)
    if newShIdx >= 0
        SwingPoint sw = swings.get(newShIdx)
        st.ref_high := sw.price
        st.ref_high_bar := sw.bar_idx
        if sw.cls != CLS_MAJOR
            relabelSwing(sw, CLS_MAJOR, 0)
    if st.pending_bear_bos and st.ref_low_bar >= 0
        int actualLl = findLowestSwingLowBetween(st.ref_low_bar, breakBar + 1)
        int llBar = actualLl >= 0 ? swings.get(actualLl).bar_idx : breakBar
        [betterLhBar, betterLhPrice] = findHighestBarHighBetween(st.ref_low_bar, llBar + 1)
        if betterLhBar >= 0 and not na(betterLhPrice) and (na(st.strong_high) or betterLhPrice > st.strong_high)
            st.strong_high := betterLhPrice
            st.strong_high_bar := betterLhBar
            int betterLhSwIdx = findSwingAtBar(betterLhBar, SWING_HIGH)
            st.strong_high_idx := betterLhSwIdx
            if betterLhSwIdx >= 0
                SwingPoint lhSw = swings.get(betterLhSwIdx)
                if lhSw.cls != CLS_MAJOR
                    relabelSwing(lhSw, CLS_MAJOR, TREND_BEARISH)
            else
                createSwingLabel(betterLhBar, betterLhPrice, SWING_HIGH, CLS_MAJOR, TREND_BEARISH)
        if actualLl >= 0
            SwingPoint llSw = swings.get(actualLl)
            if llSw.cls != CLS_MAJOR
                relabelSwing(llSw, CLS_MAJOR, TREND_BEARISH)
            if llSw.price < st.strong_low or na(st.strong_low)
                st.strong_low := llSw.price
                st.strong_low_bar := llSw.bar_idx
                st.strong_low_idx := actualLl
                drawStrongLevel(true, st.strong_low_bar, st.strong_low)
    [chochHlBar, chochHlLow] = findLowestBarLowBetween(st.strong_high_bar, breakBar)
    int chochHlOff = chochHlBar >= 0 ? bar_index - chochHlBar : -1
    float chochHlHigh = chochHlOff >= 0 ? high[chochHlOff] : na
    float chochBosLevel = st.strong_high
    st.strong_high := na
    st.strong_high_bar := -1
    st.strong_high_idx := -1
    st.ref_low := na
    st.ref_low_bar := -1
    if not na(st.strong_high_line)
        line.delete(st.strong_high_line)
        st.strong_high_line := na
    st.pending_bear_bos := false
    st.pending_bear_bos_bar := -1
    st.choch_ref_pending := true
    st.choch_break_bar := breakBar
    clearOTE()
    updateZones()
    detectBOSLinkedOB(true, breakBar, 2, chochHlBar, chochHlHigh, chochHlLow, chochBosLevel)
    st.alert_bull_choch := true

processSwingInStateMachine(int swingIdx, int currentBar) =>
    if st.initialized and swingIdx >= 0 and swingIdx < swings.size()
        SwingPoint sw = swings.get(swingIdx)
        int swType = sw.swing_type
        int swBar = sw.bar_idx
        bool chochHandled = false
        if st.choch_ref_pending
            if st.trend == TREND_BULLISH and swType == SWING_HIGH
                st.ref_high := sw.price
                st.ref_high_bar := sw.bar_idx
                sw.cls := CLS_INTERNAL
                st.choch_ref_pending := false
                st.choch_break_bar := -1
                st.pending_bull_bos := false
                st.pending_bull_bos_bar := -1
                updateZones()
                chochHandled := true
            else if st.trend == TREND_BEARISH and swType == SWING_LOW
                st.ref_low := sw.price
                st.ref_low_bar := sw.bar_idx
                sw.cls := CLS_INTERNAL
                st.choch_ref_pending := false
                st.choch_break_bar := -1
                st.pending_bear_bos := false
                st.pending_bear_bos_bar := -1
                updateZones()
                chochHandled := true
            else if st.trend == TREND_BEARISH and swType == SWING_HIGH and not na(st.strong_high) and sw.price > st.strong_high
                sw.cls := CLS_MAJOR
                int prevStrongHighBar = st.strong_high_bar
                st.strong_high := sw.price
                st.strong_high_bar := sw.bar_idx
                st.strong_high_idx := swingIdx
                drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                relabelSwing(sw, CLS_MAJOR, TREND_BULLISH)
                [lateHlBar, lateHlPrice] = findLowestBarLowBetween(prevStrongHighBar, sw.bar_idx)
                if lateHlBar >= 0 and not na(lateHlPrice)
                    int lateHlSwIdx = findSwingAtBar(lateHlBar, SWING_LOW)
                    if lateHlSwIdx >= 0
                        SwingPoint hlSw = swings.get(lateHlSwIdx)
                        if hlSw.cls != CLS_MAJOR
                            relabelSwing(hlSw, CLS_MAJOR, TREND_BULLISH)
                    else
                        createSwingLabel(lateHlBar, lateHlPrice, SWING_LOW, CLS_MAJOR, TREND_BULLISH)
                chochHandled := true
            else if st.trend == TREND_BULLISH and swType == SWING_LOW and not na(st.strong_low) and sw.price < st.strong_low
                sw.cls := CLS_MAJOR
                int prevStrongLowBar = st.strong_low_bar
                st.strong_low := sw.price
                st.strong_low_bar := sw.bar_idx
                st.strong_low_idx := swingIdx
                drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                relabelSwing(sw, CLS_MAJOR, TREND_BEARISH)
                [lateLhBar, lateLhPrice] = findHighestBarHighBetween(prevStrongLowBar, sw.bar_idx)
                if lateLhBar >= 0 and not na(lateLhPrice)
                    int lateLhSwIdx = findSwingAtBar(lateLhBar, SWING_HIGH)
                    if lateLhSwIdx >= 0
                        SwingPoint lhSw = swings.get(lateLhSwIdx)
                        if lhSw.cls != CLS_MAJOR
                            relabelSwing(lhSw, CLS_MAJOR, TREND_BEARISH)
                    else
                        createSwingLabel(lateLhBar, lateLhPrice, SWING_HIGH, CLS_MAJOR, TREND_BEARISH)
                chochHandled := true
        if not chochHandled
            if st.trend == TREND_BULLISH
                if swType == SWING_HIGH
                    if not na(st.ref_high) and sw.price > st.ref_high
                        if not st.pending_bull_bos
                            int brk = -1
                            for j = st.ref_high_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakAbove(st.ref_high, close[offset], high[offset])
                                    brk := j
                                    break
                            if brk < 0
                                brk := swBar
                            fireBullishBOS(brk)
                        sw.cls := CLS_MAJOR
                        [hlBar, hlPrice] = findLowestBarLowBetween(st.ref_high_bar, swBar)
                        if hlBar >= 0 and not na(hlPrice)
                            st.strong_low := hlPrice
                            st.strong_low_bar := hlBar
                            int hlSwIdx = findSwingAtBar(hlBar, SWING_LOW)
                            st.strong_low_idx := hlSwIdx
                            if hlSwIdx >= 0
                                SwingPoint hlSw = swings.get(hlSwIdx)
                                if hlSw.cls != CLS_MAJOR
                                    relabelSwing(hlSw, CLS_MAJOR, 0)
                            else
                                createSwingLabel(hlBar, hlPrice, SWING_LOW, CLS_MAJOR, 0)
                            drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                        st.ref_high := sw.price
                        st.ref_high_bar := swBar
                        st.pending_bull_bos := false
                        st.pending_bull_bos_bar := -1
                        updateZones()
                        updateOTE(true)
                        if st.ref_high_bar + 1 <= currentBar
                            for j = st.ref_high_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakAbove(st.ref_high, close[offset], high[offset])
                                    fireBullishBOS(j)
                                    break
                        sw.cls := CLS_MAJOR
                    else
                        sw.cls := CLS_INTERNAL
                else
                    sw.cls := CLS_INTERNAL
            else if st.trend == TREND_BEARISH
                if swType == SWING_LOW
                    if not na(st.ref_low) and sw.price < st.ref_low
                        if not st.pending_bear_bos
                            int brk = -1
                            for j = st.ref_low_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakBelow(st.ref_low, close[offset], low[offset])
                                    brk := j
                                    break
                            if brk < 0
                                brk := swBar
                            fireBearishBOS(brk)
                        sw.cls := CLS_MAJOR
                        [lhBar, lhPrice] = findHighestBarHighBetween(st.ref_low_bar, swBar)
                        if lhBar >= 0 and not na(lhPrice)
                            st.strong_high := lhPrice
                            st.strong_high_bar := lhBar
                            int lhSwIdx = findSwingAtBar(lhBar, SWING_HIGH)
                            st.strong_high_idx := lhSwIdx
                            if lhSwIdx >= 0
                                SwingPoint lhSw = swings.get(lhSwIdx)
                                if lhSw.cls != CLS_MAJOR
                                    relabelSwing(lhSw, CLS_MAJOR, 0)
                            else
                                createSwingLabel(lhBar, lhPrice, SWING_HIGH, CLS_MAJOR, 0)
                            drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                        st.ref_low := sw.price
                        st.ref_low_bar := swBar
                        st.pending_bear_bos := false
                        st.pending_bear_bos_bar := -1
                        updateZones()
                        updateOTE(false)
                        if st.ref_low_bar + 1 <= currentBar
                            for j = st.ref_low_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakBelow(st.ref_low, close[offset], low[offset])
                                    fireBearishBOS(j)
                                    break
                        sw.cls := CLS_MAJOR
                    else
                        sw.cls := CLS_INTERNAL
                else
                    sw.cls := CLS_INTERNAL
            else
                sw.cls := CLS_INTERNAL

scanLiquidityPools(bool doScan) =>
    float atrVal = ta.atr(14)
    if i_show_liq and not na(atrVal) and doScan
        float eqThreshold = atrVal * i_eq_atr_mult
        if liq_pools.size() > 0
            for i = 0 to liq_pools.size() - 1
                LiquidityPool pool = liq_pools.get(i)
                if not na(pool.pool_line)
                    line.delete(pool.pool_line)
                if not na(pool.pool_label)
                    label.delete(pool.pool_label)
            liq_pools.clear()
        int count = swings.size()
        for i = count - 1 to 0
            SwingPoint swI = swings.get(i)
            if swI.swing_type == SWING_HIGH
                bool alreadyInPool = false
                if liq_pools.size() > 0
                    for p = 0 to liq_pools.size() - 1
                        LiquidityPool existingPool = liq_pools.get(p)
                        if existingPool.pool_type == SWING_HIGH and math.abs(swI.price - existingPool.level) <= eqThreshold
                            alreadyInPool := true
                            break
                if not alreadyInPool
                    int touchCount = 0
                    float priceSum = 0.0
                    int firstBar = swI.bar_idx
                    for j = 0 to count - 1
                        SwingPoint swJ = swings.get(j)
                        if swJ.swing_type == SWING_HIGH and math.abs(swI.price - swJ.price) <= eqThreshold
                            touchCount += 1
                            priceSum += swJ.price
                            if swJ.bar_idx < firstBar
                                firstBar := swJ.bar_idx
                    if touchCount >= i_eq_min_touches
                        float level = priceSum / touchCount
                        int drawStart = math.max(firstBar, bar_index - i_liq_max_lookback)
                        line pLine = line.new(drawStart, level, bar_index, level, xloc.bar_index, extend.right, i_col_bsl, line.style_dashed, 1)
                        label pLabel = label.new(drawStart, level, "EQH", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_bsl, size.tiny, text.align_center)
                        addManagedLine(managed_liq_lines, pLine, i_max_liq_objects)
                        addManagedLabel(managed_liq_labels, pLabel, i_max_liq_objects)
                        liq_pools.push(LiquidityPool.new(SWING_HIGH, level, firstBar, false, -1, pLine, pLabel))
        for i = count - 1 to 0
            SwingPoint swI = swings.get(i)
            if swI.swing_type == SWING_LOW
                bool alreadyInPool = false
                if liq_pools.size() > 0
                    for p = 0 to liq_pools.size() - 1
                        LiquidityPool existingPool = liq_pools.get(p)
                        if existingPool.pool_type == SWING_LOW and math.abs(swI.price - existingPool.level) <= eqThreshold
                            alreadyInPool := true
                            break
                if not alreadyInPool
                    int touchCount = 0
                    float priceSum = 0.0
                    int firstBar = swI.bar_idx
                    for j = 0 to count - 1
                        SwingPoint swJ = swings.get(j)
                        if swJ.swing_type == SWING_LOW and math.abs(swI.price - swJ.price) <= eqThreshold
                            touchCount += 1
                            priceSum += swJ.price
                            if swJ.bar_idx < firstBar
                                firstBar := swJ.bar_idx
                    if touchCount >= i_eq_min_touches
                        float level = priceSum / touchCount
                        int drawStart = math.max(firstBar, bar_index - i_liq_max_lookback)
                        line pLine = line.new(drawStart, level, bar_index, level, xloc.bar_index, extend.right, i_col_ssl, line.style_dashed, 1)
                        label pLabel = label.new(drawStart, level, "EQL", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_ssl, size.tiny, text.align_center)
                        addManagedLine(managed_liq_lines, pLine, i_max_liq_objects)
                        addManagedLabel(managed_liq_labels, pLabel, i_max_liq_objects)
                        liq_pools.push(LiquidityPool.new(SWING_LOW, level, firstBar, false, -1, pLine, pLabel))

checkLiquiditySweeps() =>
    if i_show_sweeps and liq_pools.size() > 0
        for p = 0 to liq_pools.size() - 1
            LiquidityPool pool = liq_pools.get(p)
            if not pool.swept
                if pool.pool_type == SWING_HIGH
                    if high > pool.level and close < pool.level
                        pool.swept := true
                        pool.swept_bar := bar_index
                        label sweepLbl = label.new(bar_index, high + nz(ta.atr(14)) * 0.3, "v", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_bsl, size.small, text.align_center)
                        addManagedLabel(managed_sweep_labels, sweepLbl, i_max_sweep_labels)
                        st.alert_bsl_sweep := true
                else
                    if low < pool.level and close > pool.level
                        pool.swept := true
                        pool.swept_bar := bar_index
                        label sweepLbl = label.new(bar_index, low - nz(ta.atr(14)) * 0.3, "^", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_ssl, size.small, text.align_center)
                        addManagedLabel(managed_sweep_labels, sweepLbl, i_max_sweep_labels)
                        st.alert_ssl_sweep := true

// Reset per-bar alert flags
st.alert_bull_bos := false
st.alert_bear_bos := false
st.alert_bull_choch := false
st.alert_bear_choch := false
st.alert_bsl_sweep := false
st.alert_ssl_sweep := false
st.alert_ob_bull := false
st.alert_ob_bear := false
st.alert_ob_mitigated := false
st.alert_fvg_bull := false
st.alert_fvg_bear := false
st.alert_fvg_filled := false

float kFast = kernels.rationalQuadratic(close, KAO_FAST_LOOKBACK, KAO_FAST_WEIGHT, KAO_FAST_REGSTART)
if KAO_FAST_SMOOTH
    kFast := ta.sma(kFast, KAO_FAST_SMOOTHLEN)
float kSlow = kernels.rationalQuadratic(close, KAO_SLOW_LOOKBACK, KAO_SLOW_WEIGHT, KAO_SLOW_REGSTART)
if KAO_SLOW_SMOOTH
    kSlow := ta.sma(kSlow, KAO_SLOW_SMOOTHLEN)
float osc = kFast - kSlow

var float kao_lowestVal  = na
var float kao_highestVal = na
var int   kao_lowestBar  = na
var int   kao_highestBar = na
var int   kao_negativeStart    = na
var int   kao_positiveStart    = na
var int   kao_uplineRange      = 0
var int   kao_dwnlineRange     = 0
var line  kao_upline           = na
var line  kao_dwnline          = na
var int   kao_uplinePrevHigh   = na
var int   kao_dwnlinePrevLow   = na

bool kao_bullishCross = osc > 0  and not na(osc[1]) and osc[1] <= 0
bool kao_bearishCross = osc < 0  and not na(osc[1]) and osc[1] >= 0

if osc < 0 and na(osc[1])
    kao_negativeStart := bar_index
    kao_lowestVal     := low
    kao_lowestBar     := bar_index
if osc > 0 and na(osc[1])
    kao_positiveStart := bar_index
    kao_highestVal    := high
    kao_highestBar    := bar_index

float ph = na
float pl = na
int   swingBar = -1

if kao_bullishCross
    if not na(kao_lowestVal)
        pl       := kao_lowestVal
        swingBar := kao_lowestBar
    kao_positiveStart := bar_index
    kao_highestVal    := high
    kao_highestBar    := bar_index
if kao_bearishCross
    if not na(kao_highestVal)
        ph       := kao_highestVal
        swingBar := kao_highestBar
    kao_negativeStart := bar_index
    kao_lowestVal     := low
    kao_lowestBar     := bar_index

if osc < 0 and not na(osc[1])
    if low <= kao_lowestVal or na(kao_lowestVal)
        kao_lowestVal := low
        kao_lowestBar := bar_index
if osc > 0 and not na(osc[1])
    if high >= kao_highestVal or na(kao_highestVal)
        kao_highestVal := high
        kao_highestBar := bar_index

if i_show_kao_legs
    if not na(kao_negativeStart) and not na(kao_positiveStart) and kao_negativeStart < kao_positiveStart
        if kao_negativeStart != kao_uplineRange
            kao_upline := line.new(kao_lowestBar, kao_lowestVal, kao_highestBar, kao_highestVal,
                                   color=i_kao_leg_color, width=i_kao_leg_width)
            kao_uplineRange    := kao_negativeStart
            kao_uplinePrevHigh := kao_highestBar
        else if kao_highestBar != kao_uplinePrevHigh
            kao_upline.set_x2(kao_highestBar)
            kao_upline.set_y2(kao_highestVal)
            kao_uplinePrevHigh := kao_highestBar
    if not na(kao_negativeStart) and not na(kao_positiveStart) and kao_positiveStart < kao_negativeStart
        if kao_positiveStart != kao_dwnlineRange
            kao_dwnline := line.new(kao_highestBar, kao_highestVal, kao_lowestBar, kao_lowestVal,
                                    color=i_kao_leg_color, width=i_kao_leg_width)
            kao_dwnlineRange   := kao_positiveStart
            kao_dwnlinePrevLow := kao_lowestBar
        else if kao_lowestBar != kao_dwnlinePrevLow
            kao_dwnline.set_x2(kao_lowestBar)
            kao_dwnline.set_y2(kao_lowestVal)
            kao_dwnlinePrevLow := kao_lowestBar

var int divCurrLow     = 0
var int divCurrHigh    = 0
var int divPrevLow     = 0
var int divPrevLowHigh = 0
var int divPrevHigh    = 0
var int divPrevHighLow = 0

int klbPrev = kao_lowestBar[1]
int khbPrev = kao_highestBar[1]

if not na(kao_lowestBar) and not na(kao_highestBar)
    divCurrLow  := kao_lowestBar
    divCurrHigh := kao_highestBar
    if kao_lowestBar >= kao_highestBar and not na(klbPrev) and divPrevLow != klbPrev and divPrevLowHigh != kao_highestBar
        divPrevLow     := klbPrev
        divPrevLowHigh := kao_highestBar
    if kao_highestBar >= kao_lowestBar and not na(khbPrev) and divPrevHigh != khbPrev and divPrevHighLow != kao_lowestBar
        divPrevHigh     := khbPrev
        divPrevHighLow  := kao_lowestBar

findLowestOsc(int startBar, int endOffset) =>
    float result = na
    int endBar = bar_index - endOffset
    int lo = math.min(startBar, endBar)
    int hi = math.max(startBar, endBar)
    if hi >= lo
        for j = lo to hi
            int offset = bar_index - j
            if offset >= 0
                float v = osc[offset]
                if not na(v) and (na(result) or v < result)
                    result := v
    result

findHighestOsc(int startBar, int endOffset) =>
    float result = na
    int endBar = bar_index - endOffset
    int lo = math.min(startBar, endBar)
    int hi = math.max(startBar, endBar)
    if hi >= lo
        for j = lo to hi
            int offset = bar_index - j
            if offset >= 0
                float v = osc[offset]
                if not na(v) and (na(result) or v > result)
                    result := v
    result

isKernelBullDiv(int currHighBar, int prevHighBar, int currLowBar, int prevLowBar, color regColor, color hidColor, bool isHidden) =>
    int prevHigh = bar_index - prevHighBar
    int currHigh = bar_index - currHighBar
    int prevLow  = bar_index - prevLowBar
    int currLow  = bar_index - currLowBar
    bool isDivergence = false
    var int rangeStart = bar_index
    if not na(osc[1]) and osc[1] > 0 and osc < 0
        rangeStart := bar_index
    var line hidLine = na
    var int  hidLineStart = 0
    var line regLine = na
    var int  regLineStart = 0
    float lowest1 = findLowestOsc(currHighBar, prevLow)
    float lowest2 = findLowestOsc(rangeStart,  0)
    if low[currLow] < low[prevLow] and currLowBar >= currHighBar and not isHidden
        if lowest1 < lowest2
            isDivergence := true
            if prevLowBar == regLineStart
                line.delete(regLine)
            regLine := line.new(time[prevLow], low[prevLow], time[currLow], low[currLow], color = regColor, xloc = xloc.bar_time, width = 1)
            regLineStart := prevLowBar
    if low[currLow] > low[prevLow] and currLowBar >= currHighBar and isHidden
        if lowest1 > lowest2
            isDivergence := true
            if prevLowBar == hidLineStart
                line.delete(hidLine)
            hidLine := line.new(time[prevLow], low[prevLow], time[currLow], low[currLow], color = hidColor, xloc = xloc.bar_time, width = 1)
            hidLineStart := prevLowBar
    isDivergence

isKernelBearDiv(int currHighBar, int prevHighBar, int currLowBar, int prevLowBar, color regColor, color hidColor, bool isHidden) =>
    int prevHigh = bar_index - prevHighBar
    int currHigh = bar_index - currHighBar
    int prevLow  = bar_index - prevLowBar
    int currLow  = bar_index - currLowBar
    bool isDivergence = false
    var line hidLine = na
    var int  hidLineStart = 0
    var line regLine = na
    var int  regLineStart = 0
    var int rangeStart = bar_index
    if not na(osc[1]) and osc[1] < 0 and osc > 0
        rangeStart := bar_index
    float highest1 = findHighestOsc(currLowBar, prevHigh)
    float highest2 = findHighestOsc(rangeStart, 0)
    if high[currHigh] > high[prevHigh] and currLowBar < currHighBar and not isHidden
        if highest1 > highest2
            isDivergence := true
            if prevHighBar == regLineStart
                line.delete(regLine)
            regLine := line.new(time[prevHigh], high[prevHigh], time[currHigh], high[currHigh], color = regColor, xloc = xloc.bar_time, width = 1)
            regLineStart := prevHighBar
    if high[currHigh] < high[prevHigh] and currLowBar < currHighBar and isHidden
        if highest1 < highest2
            isDivergence := true
            if prevHighBar == hidLineStart
                line.delete(hidLine)
            hidLine := line.new(time[prevHigh], high[prevHigh], time[currHigh], high[currHigh], color = hidColor, xloc = xloc.bar_time, width = 1)
            hidLineStart := prevHighBar
    isDivergence

if st.initialized
    if st.trend == TREND_BULLISH and not na(st.strong_low)
        if checkBreakBelow(st.strong_low, close, low) and bar_index != st.last_choch_bar
            st.last_choch_bar := bar_index
            processBearishCHOCH(bar_index)
    if st.trend == TREND_BEARISH and not na(st.strong_high)
        if checkBreakAbove(st.strong_high, close, high) and bar_index != st.last_choch_bar
            st.last_choch_bar := bar_index
            processBullishCHOCH(bar_index)
    if st.trend == TREND_BULLISH and not na(st.ref_high) and not st.pending_bull_bos and not st.choch_ref_pending
        if checkBreakAbove(st.ref_high, close, high) and bar_index != st.last_bos_bar
            st.last_bos_bar := bar_index
            fireBullishBOS(bar_index)
    if st.trend == TREND_BEARISH and not na(st.ref_low) and not st.pending_bear_bos and not st.choch_ref_pending
        if checkBreakBelow(st.ref_low, close, low) and bar_index != st.last_bos_bar
            st.last_bos_bar := bar_index
            fireBearishBOS(bar_index)

bool newSwingAdded = false

if not na(ph)
    int swIdx = addSwing(SWING_HIGH, ph, swingBar)
    if swIdx >= 0 and swIdx < swings.size()
        SwingPoint sw = swings.get(swIdx)
        if sw.cls == CLS_UNCLASSIFIED
            if not st.initialized
                if tryInitialize()
                    st.initialized := true
                    for k = 0 to swings.size() - 1
                        SwingPoint initSw = swings.get(k)
                        initSw.lbl := createSwingLabel(initSw.bar_idx, initSw.price, initSw.swing_type, initSw.cls, 0)
                    if not na(st.strong_low)
                        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                    if not na(st.strong_high)
                        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                    updateZones()
            else
                processSwingInStateMachine(swIdx, bar_index)
                if na(sw.lbl)
                    relabelSwing(sw, sw.cls, 0)
                if sw.cls == CLS_INTERNAL
                    st.last_internal_sh_bar := sw.bar_idx
                    st.last_internal_sh_price := sw.price
                if sw.cls == CLS_INTERNAL or sw.cls == CLS_MAJOR
                    st.last_any_sh_bar := sw.bar_idx
        newSwingAdded := true

if not na(pl)
    int swIdx = addSwing(SWING_LOW, pl, swingBar)
    if swIdx >= 0 and swIdx < swings.size()
        SwingPoint sw = swings.get(swIdx)
        if sw.cls == CLS_UNCLASSIFIED
            if not st.initialized
                if tryInitialize()
                    st.initialized := true
                    for k = 0 to swings.size() - 1
                        SwingPoint initSw = swings.get(k)
                        initSw.lbl := createSwingLabel(initSw.bar_idx, initSw.price, initSw.swing_type, initSw.cls, 0)
                    if not na(st.strong_low)
                        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                    if not na(st.strong_high)
                        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                    updateZones()
            else
                processSwingInStateMachine(swIdx, bar_index)
                if na(sw.lbl)
                    relabelSwing(sw, sw.cls, 0)
                if sw.cls == CLS_INTERNAL
                    st.last_internal_sl_bar := sw.bar_idx
                    st.last_internal_sl_price := sw.price
                if sw.cls == CLS_INTERNAL or sw.cls == CLS_MAJOR
                    st.last_any_sl_bar := sw.bar_idx
        newSwingAdded := true

detectStandaloneOBs()
detectFVGs()
updateOBMitigation()
updateFVGMitigation()
drawProximityOBs()
drawProximityFVGs()

scanLiquidityPools(newSwingAdded)
checkLiquiditySweeps()

if not na(st.premium_box)
    box.set_right(st.premium_box, bar_index)
if not na(st.discount_box)
    box.set_right(st.discount_box, bar_index)
if not na(st.ote_box)
    box.set_right(st.ote_box, bar_index)
if not na(st.eq_line)
    line.set_x2(st.eq_line, bar_index)
if not na(st.strong_low_line)
    line.set_x2(st.strong_low_line, bar_index)
if not na(st.strong_high_line)
    line.set_x2(st.strong_high_line, bar_index)

bool divReady = divPrevLow > 0 and divPrevHigh > 0 and divCurrLow > 0 and divCurrHigh > 0

if i_debug_div and barstate.isconfirmed
    log.info("DIV bar={0} divCurrLow={1} divPrevLow={2} divCurrHigh={3} divPrevHigh={4} divReady={5} osc={6,number,#.######}",
         bar_index, divCurrLow, divPrevLow, divCurrHigh, divPrevHigh, divReady, osc)

if i_div_kao_reg and divReady
    isKernelBearDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, false)
    isKernelBullDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, false)

if i_div_kao_hid and divReady
    isKernelBearDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, true)
    isKernelBullDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, true)

bgcolor(st.trend == TREND_BULLISH ? color.new(color.green, 96) : st.trend == TREND_BEARISH ? color.new(color.red, 96) : na)

if st.alert_bull_bos and barstate.isconfirmed
    alert("Bullish BOS on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_bear_bos and barstate.isconfirmed
    alert("Bearish BOS on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_bull_choch and barstate.isconfirmed
    alert("Bullish CHoCH on " + syminfo.ticker + " — potential reversal to bullish", alert.freq_once_per_bar_close)
if st.alert_bear_choch and barstate.isconfirmed
    alert("Bearish CHoCH on " + syminfo.ticker + " — potential reversal to bearish", alert.freq_once_per_bar_close)
if st.alert_bsl_sweep and barstate.isconfirmed
    alert("BSL Sweep on " + syminfo.ticker + " — buy-side liquidity swept", alert.freq_once_per_bar_close)
if st.alert_ssl_sweep and barstate.isconfirmed
    alert("SSL Sweep on " + syminfo.ticker + " — sell-side liquidity swept", alert.freq_once_per_bar_close)
if st.alert_ob_bull and barstate.isconfirmed
    alert("Bullish Order Block on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_ob_bear and barstate.isconfirmed
    alert("Bearish Order Block on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_ob_mitigated and barstate.isconfirmed
    alert("Order Block mitigated on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_fvg_bull and barstate.isconfirmed
    alert("Bullish FVG on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_fvg_bear and barstate.isconfirmed
    alert("Bearish FVG on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_fvg_filled and barstate.isconfirmed
    alert("FVG filled on " + syminfo.ticker, alert.freq_once_per_bar_close)

plot(st.trend, "Trend", display = display.none)
plot(st.strong_low, "Strong Low", display = display.none)
plot(st.strong_high, "Strong High", display = display.none)
plot(st.ref_high, "Ref High", display = display.none)
plot(st.ref_low, "Ref Low", display = display.none)
plot(st.equilibrium, "Equilibrium", display = display.none)
plot(st.ote_top, "OTE Top", display = display.none)
plot(st.ote_bottom, "OTE Bottom", display = display.none)
plot(not na(st.equilibrium) ? (close > st.equilibrium ? 1 : -1) : 0, "Zone", display = display.none)
plot(all_obs.size(), "Active OB Count", display = display.none)
plot(all_fvgs.size(), "Active FVG Count", display = display.none)

// =========================================================
// PORTED SECTION 4: Kernel Bollinger Band
// =========================================================
string kbb_kernelFastType         = input.string("Rational Quadratic", "KBB Kernel Type", options = ["Rational Quadratic", "Gaussian"], group = "KBB Fast Kernel Settings")
float  kbb_kernelFastWeight       = input.float(8, "KBB Rel Weight", 0, 50, step = 0.2, group = "KBB Fast Kernel Settings")
int    kbb_kernelFastLookback     = input.int(20, "KBB Lookback", 2, 500, group = "KBB Fast Kernel Settings")
int    kbb_kernelFastRegressionStart = input.int(25, "KBB Regression Start", 2, 400, group = "KBB Fast Kernel Settings")
bool   kbb_kernelFastSmooth       = input.bool(true, "KBB Smooth Line", inline = "KBBSmooth", group = "KBB Fast Kernel Settings")
int    kbb_kernelFastSmoothPeriod = input.int(4, "", 2, 200, inline = "KBBSmooth", group = "KBB Fast Kernel Settings")
int    kbb_length                 = input.int(20, minval = 1, title = "KBB Length", group = "KBB Bands")
float  kbb_src                    = input(close, title = "KBB Source", group = "KBB Bands")
float  kbb_mult                   = input.float(2.0, minval = 0.001, maxval = 50, title = "KBB StdDev", group = "KBB Bands")
int    kbb_offset                 = input.int(0, "KBB Offset", minval = -500, maxval = 500, group = "KBB Bands")

float kernelFast = switch kbb_kernelFastType
    "Rational Quadratic" => kernels.rationalQuadratic(close, kbb_kernelFastLookback, kbb_kernelFastWeight, kbb_kernelFastRegressionStart)
    "Gaussian"           => kernels.gaussian(close, kbb_kernelFastLookback, kbb_kernelFastRegressionStart)

if kbb_kernelFastSmooth
    kernelFast := ta.sma(kernelFast, kbb_kernelFastSmoothPeriod)

float kbb_basis = kernelFast
float kbb_dev   = kbb_mult * ta.stdev(kbb_src, kbb_length)
float kbb_upper = kbb_basis + kbb_dev
float kbb_lower = kbb_basis - kbb_dev

plot(kbb_basis, "kbb_basis", color = color.new(color.orange, 0), offset = kbb_offset)
plot(kbb_upper, "kbb_upper", color = color.new(color.aqua,   0), offset = kbb_offset)
plot(kbb_lower, "kbb_lower", color = color.new(color.aqua,   0), offset = kbb_offset)

// =========================================================
// STATE MACHINE — trend, leg extremes, re-entry gate
// =========================================================
// KAO variables used:
//   st.alert_bull_choch  — bullish CHoCH event (bool, true on bar of confirmation)
//                          set inside processBullishCHOCH(), reset each bar at line ~2194
//   st.alert_bear_choch  — bearish CHoCH event
//                          set inside processBearishCHOCH(), reset each bar at line ~2194
//   st.ref_high          — confirmed pivot high price (last HH in bull trend, BOS reference)
//   st.ref_low           — confirmed pivot low price (last LL in bear trend, BOS reference)
// Note: no KAO function modifications needed — flags are accessible at script scope via st.*

var int   trendDir    = 0           // +1 bull, -1 bear, 0 none
var float legHigh     = na
var float legLow      = na
var int   barsInTrend = 0
var bool  armed       = false       // re-entry gate

// Running tracker for the most recent confirmed pivots (KAO's ph/pl fire only
// on the bar a swing confirms; we persist the last value here so the impulse
// leg can anchor on the swing that predates the CHoCH).
var float lastConfirmedLow  = na
var float lastConfirmedHigh = na
if not na(pl)
    lastConfirmedLow  := pl
if not na(ph)
    lastConfirmedHigh := ph

// Detect major CHoCH events from KAO ported code
bool chochUp   = st.alert_bull_choch
bool chochDown = st.alert_bear_choch

// Trend flip: opposite-direction major CHoCH resets the leg.
// Anchor the IMPULSE ORIGIN side on the prior confirmed pivot (the swing low
// that the bullish impulse rallied from, or the swing high the bearish impulse
// fell from). The other side seeds at the CHoCH bar and ratchets in the trend
// direction.
if chochUp and trendDir != 1
    trendDir    := 1
    legHigh     := high
    legLow      := nz(lastConfirmedLow, low)
    barsInTrend := 0
    armed       := true
else if chochDown and trendDir != -1
    trendDir    := -1
    legHigh     := nz(lastConfirmedHigh, high)
    legLow      := low
    barsInTrend := 0
    armed       := true
else if trendDir != 0
    legHigh     := math.max(nz(legHigh, high), high)
    legLow      := math.min(nz(legLow, low), low)
    barsInTrend := barsInTrend + 1

float legMid = (legHigh + legLow) / 2.0

string inputDirection    = input.string("Both",  "Direction",                          options = ["Both", "Long only", "Short only"], group = "Strategy")
int    inputMinBarsTrend = input.int(5,          "Min bars in new trend before entry", minval = 1, maxval = 100, group = "Strategy")
float  inputSLBuffer     = input.float(0.0,      "SL buffer (price units)",            minval = 0.0, group = "Strategy")
float  inputRiskPct      = input.float(1.0,      "Risk % per trade",            minval = 0.1, maxval = 5.0, step = 0.1, group = "Strategy")

bool   inputShowLeg      = input.bool(true,  "Show legHigh/legLow lines",        group = "Visuals")
bool   inputShowMid      = input.bool(true,  "Show legMid (50%) line",           group = "Visuals")
bool   inputShowZone     = input.bool(true,  "Show discount/premium zone box",   group = "Visuals")
bool   inputShowMarks    = input.bool(true,  "Show entry/exit markers",          group = "Visuals")

// Re-arm logic (only re-arms while flat)
inputReArmExtreme = input.bool(true, "Re-arm on new HH/LL extreme", group = "Strategy")
inputReArmBasis   = input.bool(true, "Re-arm on basis touch",       group = "Strategy")

var float lastLegHigh = na
var float lastLegLow  = na
bool newExtreme       = false
if trendDir == 1 and not na(legHigh) and (na(lastLegHigh) or legHigh > lastLegHigh)
    newExtreme   := true
    lastLegHigh  := legHigh
if trendDir == -1 and not na(legLow) and (na(lastLegLow) or legLow < lastLegLow)
    newExtreme   := true
    lastLegLow   := legLow

bool basisTouch =
     (trendDir == 1  and low  <= kbb_basis) or
     (trendDir == -1 and high >= kbb_basis)

if strategy.position_size == 0 and not armed
    if (inputReArmExtreme and newExtreme) or (inputReArmBasis and basisTouch)
        armed := true

// Diagnostic plots (data window only)
plot(trendDir,    "trendDir",    color = na, display = display.data_window)
plot(legHigh,     "legHigh",     color = na, display = display.data_window)
plot(legLow,      "legLow",      color = na, display = display.data_window)
plot(legMid,      "legMid",      color = na, display = display.data_window)
plot(armed ? 1 : 0, "armed",     color = na, display = display.data_window)
plot(barsInTrend, "barsInTrend", color = na, display = display.data_window)

// Entry logic — Task 9
// Exit logic — Task 11
// Position sizing — Task 12
// =========================================================
// ENTRY TRIGGERS
// =========================================================
bool allowLong  = inputDirection != "Short only"
bool allowShort = inputDirection != "Long only"

bool longCond =
     allowLong
     and trendDir == 1
     and armed
     and barsInTrend >= inputMinBarsTrend
     and low      < legMid
     and low      < kbb_lower
     and close    > kbb_lower
     and close    > open
     and not na(kbb_lower)

bool shortCond =
     allowShort
     and trendDir == -1
     and armed
     and barsInTrend >= inputMinBarsTrend
     and high     > legMid
     and high     > kbb_upper
     and close    < kbb_upper
     and close    < open
     and not na(kbb_upper)

// (entry signal plotshapes moved to gated visual layer block at end)

// =========================================================
// EXIT LOGIC -- frozen SL + structural trail + opposite-CHoCH force-close
// =========================================================
//
// KAO pivot-confirmation source (Task 11 findings):
//   KAO replaces ta.pivothigh/ta.pivotlow with zero-cross detection.
//   On every bar, ph and pl are local floats (SWING DETECTION section):
//     not na(ph) -> swing HIGH confirmed (KAO bearish cross; ph = bull leg peak)
//     not na(pl) -> swing LOW confirmed  (KAO bullish cross; pl = bear leg trough)
//   Same variables fed into processSwingInStateMachine() -- pivot timing
//   is identical to the structural engine. No ta.pivothigh fallback needed.
//
// Trail ratchet: longs trail up when confirmed swing LOW > entryPrice.
// Shorts trail down when confirmed swing HIGH < entryPrice.

// State captured at entry (populated in Task 12 entry execution block)
var float entryPrice = na
var float frozenSL   = na
var float trailSL    = na
var int   entryDir   = 0

// KAO pivot-confirmation flags and prices (from KAO zero-cross locals above)
bool  isConfirmedPivotLow  = not na(pl)
bool  isConfirmedPivotHigh = not na(ph)
float confirmedPivotLow    = pl
float confirmedPivotHigh   = ph

// Ratchet the trail on each new qualifying confirmed pivot
if strategy.position_size > 0 and isConfirmedPivotLow and confirmedPivotLow > entryPrice
    trailSL := math.max(nz(trailSL, frozenSL), confirmedPivotLow - inputSLBuffer)
if strategy.position_size < 0 and isConfirmedPivotHigh and confirmedPivotHigh < entryPrice
    trailSL := math.min(nz(trailSL, frozenSL), confirmedPivotHigh + inputSLBuffer)

// Re-register stop order each bar with the latest trail
if strategy.position_size > 0
    strategy.exit(id = "Long SL/Trail", from_entry = "Long", stop = nz(trailSL, frozenSL), comment = "STOP")
if strategy.position_size < 0
    strategy.exit(id = "Short SL/Trail", from_entry = "Short", stop = nz(trailSL, frozenSL), comment = "STOP")

// Opposite-direction CHoCH force-close
bool exitByCHoCH =
     (strategy.position_size > 0 and st.alert_bear_choch) or
     (strategy.position_size < 0 and st.alert_bull_choch)
if exitByCHoCH
    strategy.close_all(comment = "CHOCH")

// Reset entry-state when flat
if strategy.position_size == 0 and strategy.position_size[1] != 0
    entryPrice := na
    frozenSL   := na
    trailSL    := na
    entryDir   := 0

// =========================================================
// ENTRY EXECUTION — position sizing + strategy.entry
// =========================================================
if longCond
    float initialSL = legLow - inputSLBuffer
    float riskDist  = math.abs(close - initialSL)
    float qty       = riskDist > 0 ? (strategy.equity * inputRiskPct / 100.0) / riskDist : 0.0
    if qty > 0
        strategy.entry(id = "Long", direction = strategy.long, qty = qty, comment = "L_DISC_KBB")
        entryPrice := close
        frozenSL   := initialSL
        trailSL    := initialSL
        entryDir   := 1
        armed      := false

if shortCond
    float initialSL = legHigh + inputSLBuffer
    float riskDist  = math.abs(initialSL - close)
    float qty       = riskDist > 0 ? (strategy.equity * inputRiskPct / 100.0) / riskDist : 0.0
    if qty > 0
        strategy.entry(id = "Short", direction = strategy.short, qty = qty, comment = "S_PREM_KBB")
        entryPrice := close
        frozenSL   := initialSL
        trailSL    := initialSL
        entryDir   := -1
        armed      := false
// =========================================================
// ALERTS — 5 conditions, all fire on bar close
// =========================================================
alertcondition(longCond,           "Long entry signal",  message = "LONG entry {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortCond,          "Short entry signal", message = "SHORT entry {{ticker}} {{interval}} @ {{close}}")
alertcondition(st.alert_bull_choch,"CHoCH bull",         message = "CHoCH BULL {{ticker}} {{interval}} @ {{close}}")
alertcondition(st.alert_bear_choch,"CHoCH bear",         message = "CHoCH BEAR {{ticker}} {{interval}} @ {{close}}")

bool justClosedLong  = strategy.position_size == 0 and strategy.position_size[1] > 0
bool justClosedShort = strategy.position_size == 0 and strategy.position_size[1] < 0
alertcondition(justClosedLong or justClosedShort, "Position closed", message = "EXIT {{ticker}} {{interval}} @ {{close}}")
// =========================================================
// VISUAL LAYER — leg lines, zone bgcolor, gated entry/exit markers
// =========================================================
plot(inputShowLeg and not na(legHigh) ? legHigh : na, "Leg High", color = color.new(color.green, 50), linewidth = 1, style = plot.style_linebr)
plot(inputShowLeg and not na(legLow)  ? legLow  : na, "Leg Low",  color = color.new(color.red,   50), linewidth = 1, style = plot.style_linebr)
plot(inputShowMid and not na(legMid)  ? legMid  : na, "Leg Mid",  color = color.new(color.gray,  30), linewidth = 1, style = plot.style_linebr)

color zoneColor  = trendDir ==  1 ? color.new(color.green, 92) : trendDir == -1 ? color.new(color.red, 92) : na
float zoneTop    = trendDir ==  1 ? legMid  : legHigh
float zoneBottom = trendDir ==  1 ? legLow  : legMid
bgcolor(inputShowZone and trendDir != 0 and not na(zoneTop) and not na(zoneBottom) and close >= zoneBottom and close <= zoneTop ? zoneColor : na, title = "Discount/Premium Zone")

plotshape(inputShowMarks and longCond,                            title = "Long Entry",  location = location.belowbar, style = shape.triangleup,   color = color.new(color.lime,   0), size = size.small, text = "L")
plotshape(inputShowMarks and shortCond,                           title = "Short Entry", location = location.abovebar, style = shape.triangledown, color = color.new(color.red,    0), size = size.small, text = "S")
plotshape(inputShowMarks and (justClosedLong or justClosedShort), title = "Exit",        location = location.absolute, style = shape.xcross,       color = color.new(color.yellow, 0), size = size.tiny)
//@version=6
strategy("SMC KAO Resumption Strategy v1.0",
     overlay                 = true,
     pyramiding              = 1,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     initial_capital         = 10000,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0,
     max_bars_back           = 5000,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 500)

// =========================================================
// PORTED SECTION: SMC KAO v1.7 — Full body (inputs + structure + visuals)
// (verbatim from SMC_Structure_OBFVG_KAO; only the indicator() declaration
//  was replaced with strategy() above.)
// =========================================================

import jdehorty/KernelFunctions/2 as kernels

// ═══ HARDCODED KAO PARAMETERS (match Kernel AO Divergence defaults) ═══
KAO_FAST_WEIGHT     = 8.0
KAO_FAST_LOOKBACK   = 5
KAO_FAST_REGSTART   = 25
KAO_FAST_SMOOTH     = false
KAO_FAST_SMOOTHLEN  = 4

KAO_SLOW_WEIGHT     = 3.0
KAO_SLOW_LOOKBACK   = 34
KAO_SLOW_REGSTART   = 120
KAO_SLOW_SMOOTH     = false
KAO_SLOW_SMOOTHLEN  = 40

// ═══════════════════════════════════════════════════════════════════
// ═══ INPUTS                                                     ═══
// ═══════════════════════════════════════════════════════════════════
// User-adjustable settings. These control how the indicator behaves
// and what is displayed on the chart.

// ── Structure Settings ──
// Note: the `Swing Length` input (used in the original zigzag-based SMC) has been
// removed in this KAO fork — swings are now sourced from the Kernel AO Oscillator
// directly, no pivot-confirmation lookback to configure.
i_break_mode    = input.string("Wick", "Break Confirmation", options = ["Close", "Wick"], group = "Structure", tooltip = "Close = candle body must close beyond level. Wick = high/low touching counts as break")

// ── Display: Swings ──
// Note: `Show Internal Swings` removed — KAO produces one swing per leg, no Internal class.
i_show_major    = input.bool(true, "Show Major Swings", group = "Swings")
i_show_strong   = input.bool(true, "Show Strong High/Low Level", group = "Swings")
// Show the KAO swing-leg zigzag lines on the price chart (visual reference)
i_show_kao_legs = input.bool(true, "Show KAO swing legs", group = "Swings")
i_kao_leg_color = input.color(#05a7cb, "KAO swing leg color", group = "Swings")
i_kao_leg_width = input.int(1, "KAO swing leg width", minval = 1, maxval = 4, group = "Swings")

// ── Display: BOS & CHOCH ──
i_show_bos      = input.bool(true, "Show BOS", group = "BOS & CHOCH")
i_show_choch    = input.bool(true, "Show CHOCH", group = "BOS & CHOCH")

// ── Display: Zones ──
i_show_pd       = input.bool(true, "Show Premium/Discount", group = "Zones")
i_show_ote      = input.bool(true, "Show OTE Zone", group = "Zones")
i_show_eq       = input.bool(true, "Show Equilibrium Line", group = "Zones")

// ── Display: Liquidity ──
i_show_liq      = input.bool(true, "Show Equal Highs/Lows", group = "Liquidity")
i_show_sweeps   = input.bool(true, "Show Liquidity Sweeps", group = "Liquidity")
i_eq_atr_mult   = input.float(0.1, "EQ Threshold (ATR mult)", minval = 0.01, maxval = 0.5, step = 0.01, group = "Liquidity")
i_eq_min_touches = input.int(2, "Min Touches for EQ Level", minval = 2, maxval = 5, group = "Liquidity")

// ── Order Blocks ──
i_show_ob           = input.bool(true, "Show Order Blocks", group = "Order Blocks")
i_show_bull_ob      = input.bool(true, "Show Bullish OBs", group = "Order Blocks")
i_show_bear_ob      = input.bool(true, "Show Bearish OBs", group = "Order Blocks")
i_ob_mode           = input.string("Both", "OB Detection Mode", options = ["BOS/CHOCH", "Displacement", "Both"], group = "Order Blocks", tooltip = "BOS/CHOCH = OBs at structural breaks. Displacement = 3-candle impulsive patterns. Both = all OBs.")
i_show_mitigated_ob = input.bool(false, "Show Mitigated OBs", group = "Order Blocks", tooltip = "Show OBs that price has touched but not broken through")
i_show_breaker_ob   = input.bool(true, "Show Breaker OBs", group = "Order Blocks", tooltip = "When an OB is broken, it flips role: bull OB becomes Breaker Resistance, bear OB becomes Breaker Support")
i_max_visible_ob    = input.int(10, "Max Visible OBs", minval = 1, maxval = 30, group = "Order Blocks", tooltip = "Show N closest OBs to current price, per direction (e.g. 10 = up to 10 bullish + 10 bearish)")
i_ob_disp_body_pct  = input.float(0.5, "Displacement Min Body %", minval = 0.1, maxval = 0.9, step = 0.05, group = "Order Blocks", tooltip = "Minimum body-to-range ratio for displacement candles")
i_ob_imm_mit_pct    = input.float(0.3, "Immediate Mitigation %", minval = 0.0, maxval = 1.0, step = 0.05, group = "Order Blocks", tooltip = "After OB forms, check if price already overlapped the zone between OB candle and BOS bar. If penetration >= this % of zone depth, OB is immediately mitigated. 0 = disabled.")

// ── Fair Value Gaps ──
i_show_fvg          = input.bool(true, "Show Fair Value Gaps", group = "Fair Value Gaps")
i_show_bull_fvg     = input.bool(true, "Show Bullish FVGs", group = "Fair Value Gaps")
i_show_bear_fvg     = input.bool(true, "Show Bearish FVGs", group = "Fair Value Gaps")
i_show_filled_fvg   = input.bool(false, "Show Filled FVGs", group = "Fair Value Gaps", tooltip = "Show FVGs that have been filled past the threshold")
i_fvg_fill_pct      = input.float(0.5, "Fill Threshold", minval = 0.1, maxval = 1.0, step = 0.05, group = "Fair Value Gaps", tooltip = "Percentage of gap that must be filled to mark as filled (0.5 = 50%)")
i_max_visible_fvg   = input.int(10, "Max Visible FVGs", minval = 1, maxval = 30, group = "Fair Value Gaps", tooltip = "Show N closest FVGs to current price, per direction (e.g. 10 = up to 10 bullish + 10 bearish)")
i_fvg_min_atr_mult  = input.float(0.0, "Min Gap Size (ATR mult)", minval = 0.0, maxval = 2.0, step = 0.1, group = "Fair Value Gaps", tooltip = "Minimum gap size as ATR multiple. 0 = no filter.")

// ── KAO Divergence ──
// In-file algorithm using the existing KAO running extremes (kao_lowestBar /
// kao_highestBar). No external library dependencies and no separate zigzag —
// reuses what the indicator already computes for market structure.
// Both toggles default to false; turn on as needed.
i_div_kao_reg    = input.bool(false, "Show Regular Divergence", group = "Divergence", tooltip = "Regular bull + bear divergence on the KAO oscillator (price makes new extreme, oscillator does not).")
i_div_kao_hid    = input.bool(false, "Show Hidden Divergence",  group = "Divergence", tooltip = "Hidden bull + bear divergence on the KAO oscillator (oscillator makes new extreme, price does not — trend-continuation signal).")
i_col_div_reg    = input.color(#ff00f7, "Regular Div Color",    group = "Divergence")
i_col_div_hid    = input.color(#b3007d, "Hidden Div Color",     group = "Divergence")
i_debug_div      = input.bool(false, "Debug Divergence (logs)",  group = "Divergence", tooltip = "When on, prints divCurr/divPrev tracking values on each confirmed bar to Pine Logs — useful for confirming the swing-pair detector is populating before claiming a chart is divergence-free.")

// ── Colors ──
i_col_bull_major = input.color(#22c55e, "Bullish Major", group = "Colors")
i_col_bear_major = input.color(#ef4444, "Bearish Major", group = "Colors")
i_col_hl         = input.color(#3b82f6, "HL (Bullish Major Low)", group = "Colors")
i_col_internal   = input.color(#64748b, "Internal Swings", group = "Colors")
i_col_bos_bull   = input.color(#22c55e, "BOS Bullish", group = "Colors")
i_col_bos_bear   = input.color(#ef4444, "BOS Bearish", group = "Colors")
i_col_choch_bull = input.color(#22c55e, "CHOCH Bullish", group = "Colors")
i_col_choch_bear = input.color(#ef4444, "CHOCH Bearish", group = "Colors")
i_col_premium    = input.color(#ef4444, "Premium Zone", group = "Colors")
i_col_discount   = input.color(#22c55e, "Discount Zone", group = "Colors")
i_col_ote        = input.color(#f59e0b, "OTE Zone", group = "Colors")
i_col_eq_line    = input.color(#06b6d4, "Equilibrium Line", group = "Colors")
i_col_bsl        = input.color(#ef4444, "BSL (Equal Highs)", group = "Colors")
i_col_ssl        = input.color(#22c55e, "SSL (Equal Lows)", group = "Colors")
i_col_ob_bull       = input.color(#22c55e, "Bullish OB", group = "Colors")
i_col_ob_bear       = input.color(#ef4444, "Bearish OB", group = "Colors")
i_col_ob_mitigated  = input.color(#6b7280, "Mitigated OB", group = "Colors")
i_col_breaker_resist = input.color(#a855f7, "Breaker Resistance", group = "Colors")
i_col_breaker_support = input.color(#06b6d4, "Breaker Support", group = "Colors")
i_col_fvg_bull      = input.color(#3b82f6, "Bullish FVG", group = "Colors")
i_col_fvg_bear      = input.color(#f97316, "Bearish FVG", group = "Colors")
i_col_fvg_filled    = input.color(#6b7280, "Filled FVG", group = "Colors")

// ── Performance ──
i_max_swing_labels = input.int(300, "Max Swing Labels", minval = 50, maxval = 490, group = "Performance")
i_max_bos_objects  = input.int(80, "Max BOS Lines/Labels", minval = 10, maxval = 200, group = "Performance")
i_max_choch_objects = input.int(40, "Max CHOCH Lines/Labels", minval = 10, maxval = 100, group = "Performance")
i_max_liq_objects  = input.int(30, "Max Liquidity Lines/Labels", minval = 10, maxval = 100, group = "Performance")
i_liq_max_lookback = input.int(4500, "Liquidity Line Max Lookback (bars)", minval = 100, maxval = 4900, group = "Performance", tooltip = "How far back an EQH / EQL line is allowed to start from the current bar. Pine restricts xloc.bar_index drawings to within max_bars_back (5000 here) of the current bar — Ultimate plans get a wider effective window, free plans get less. Default 4500 leaves a 500-bar safety margin. Lower this if you still hit 'x1 too far' errors; raise it (after also raising max_bars_back in the indicator() header) for longer EQH/EQL lines on Ultimate.")
i_max_sweep_labels = input.int(30, "Max Sweep Labels", minval = 10, maxval = 100, group = "Performance")
i_max_swings       = input.int(200, "Max Stored Swings", minval = 50, maxval = 500, group = "Performance")
i_max_stored_ob     = input.int(100, "Max Stored OBs", minval = 20, maxval = 300, group = "Performance")
i_max_stored_fvg    = input.int(200, "Max Stored FVGs", minval = 50, maxval = 500, group = "Performance")
i_debug_ob          = input.bool(false, "Debug OB Mitigation", group = "Performance", tooltip = "Enable Pine Logs for OB mitigation debugging")

// ═══════════════════════════════════════════════════════════════════
// ═══ CONSTANTS                                                  ═══
// ═══════════════════════════════════════════════════════════════════
// Named values used throughout the code instead of raw numbers.
// This makes the logic readable — e.g., "SWING_HIGH" instead of "1".

int SWING_HIGH       =  1    // A swing high (peak in price)
int SWING_LOW        = -1    // A swing low (valley in price)
int CLS_UNCLASSIFIED =  0    // Swing hasn't been classified yet
int CLS_MAJOR        =  1    // Major swing (defines the trend: HH, HL, LH, LL)
int CLS_INTERNAL     = -1    // Internal swing (minor pullback within the trend: iH, iL)
int TREND_BULLISH    =  1    // Market is trending up (making HH and HL)
int TREND_BEARISH    = -1    // Market is trending down (making LH and LL)
int TREND_UNDEFINED  =  0    // Not enough data to determine trend yet

// ═══════════════════════════════════════════════════════════════════
// ═══ USER-DEFINED TYPES (Data Structures)                       ═══
// ═══════════════════════════════════════════════════════════════════
// These are blueprints for organizing related data together.
// Think of them like forms with fields — each "SwingPoint" stores
// everything we need to know about one swing high or swing low.

// Represents one detected swing point (a peak or valley in price)
type SwingPoint
    int    swing_type  = 0     // Is this a swing high (+1) or swing low (-1)?
    float  price       = na    // The price level of this swing
    int    bar_idx     = -1    // Which bar on the chart this swing occurred at
    int    cls         = 0     // Classification: Major, Internal, or Unclassified
    bool   broken      = false // Has price broken through this swing's level?
    int    broken_bar  = -1    // Which bar broke through (if broken)
    label  lbl         = na    // The text label drawn on the chart (HH, HL, LH, LL, iH, iL)

// Represents an Equal High or Equal Low liquidity pool
type LiquidityPool
    int    pool_type   = 0     // High pool (BSL) or Low pool (SSL)
    float  level       = na    // The price level where multiple swings cluster
    int    start_bar   = -1    // Where the pool starts on the chart
    bool   swept       = false // Has price swept through this pool?
    int    swept_bar   = -1    // Which bar swept it
    line   pool_line   = na    // The dashed horizontal line on chart
    label  pool_label  = na    // The "EQH" or "EQL" label

// Represents an Order Block zone
// State machine: "active" → "tested" → "breaker" → "reversed"
//   active  = fresh OB, untouched
//   tested  = price returned to test the zone (mitigated)
//   breaker = OB broken through (Mode A only: flips role)
//   reversed = breaker itself broken again (final state)
type OBData
    int    direction   = 0       // +1 bullish, -1 bearish
    float  top         = na      // Upper boundary of OB zone
    float  bottom      = na      // Lower boundary of OB zone
    int    ob_bar      = -1      // Bar where OB candle is
    int    source      = 0       // 1=BOS, 2=CHOCH, 3=displacement
    string state       = "active" // "active", "tested", "breaker", "reversed"
    float  bos_level   = na      // BOS price level that created this OB (Mode A only)
    bool   pullback_confirmed = false // Internal high/low pullback condition met (Mode A only)
    int    breaker_bar = -1      // Bar when OB became a breaker (for swing-after-breaker check)
    bool   swing_after_breaker = false // Major/internal swing formed after breaker
    bool   was_breaker = false   // True if OB was ever a breaker (tested-from-breaker → reversed on next break)
    box    ob_box      = na      // Chart box drawing
    label  ob_label    = na      // "OB" label

// Represents a Fair Value Gap
type FVGData
    int    direction   = 0      // +1 bullish, -1 bearish
    float  top         = na     // Upper boundary of gap
    float  bottom      = na     // Lower boundary of gap
    int    fvg_bar     = -1     // Bar index of middle candle
    float  fill_pct    = 0.0    // How much of the gap has been filled (0-1)
    bool   filled      = false  // fill_pct >= threshold
    bool   broken      = false  // Price closed completely through
    box    fvg_box     = na     // Chart box drawing
    label  fvg_label   = na     // "FVG" label

// The "brain" of the indicator — tracks the current market state.
// All the indicator's memory lives here: what trend we're in, where
// the key levels are, what we're waiting for, etc.
type State
    // ── Current trend direction ──
    int    trend             = 0     // Bullish (+1), Bearish (-1), or Undefined (0)
    bool   initialized       = false // Has the indicator established its first trend?

    // ── Strong levels (the CHOCH trigger lines) ──
    // Strong Low: the HL that defines where CHOCH fires in a bull trend
    // Strong High: the LH that defines where CHOCH fires in a bear trend
    float  strong_low        = na
    float  strong_high       = na
    int    strong_low_bar    = -1    // Bar position of strong low
    int    strong_high_bar   = -1    // Bar position of strong high
    int    strong_low_idx    = -1    // Index in the swings array (-1 if not a swing)
    int    strong_high_idx   = -1    // Index in the swings array (-1 if not a swing)

    // ── Reference levels (the BOS trigger lines) ──
    // Ref High: the last HH — BOS fires when price breaks above this
    // Ref Low: the last LL — BOS fires when price breaks below this
    float  ref_high          = na
    float  ref_low           = na
    int    ref_high_bar      = -1
    int    ref_low_bar       = -1

    // ── Pending BOS state ──
    // When price breaks a reference level, BOS fires immediately. But the
    // actual HH/LL swing takes swing_length more bars to confirm. These
    // flags track that we're waiting for the swing to confirm.
    bool   pending_bull_bos      = false
    int    pending_bull_bos_bar  = -1
    bool   pending_bear_bos      = false
    int    pending_bear_bos_bar  = -1

    // ── CHOCH reference pending ──
    // After a CHOCH (trend change), we wait for the first swing in the
    // new trend direction to set the new reference level. Until then,
    // no BOS can fire in the new trend.
    bool   choch_ref_pending = false
    int    choch_break_bar   = -1

    // ── Zone levels (Premium/Discount/OTE) ──
    float  ote_top           = na
    float  ote_bottom        = na
    float  equilibrium       = na    // 50% midpoint of the range
    float  range_high        = na    // Top of the current structural range
    float  range_low         = na    // Bottom of the current structural range

    // ── Drawing objects (chart visuals managed by the state) ──
    line   strong_low_line   = na    // Dotted horizontal line for Strong Low
    line   strong_high_line  = na    // Dotted horizontal line for Strong High
    box    premium_box       = na    // Red transparent box (upper half of range)
    box    discount_box      = na    // Green transparent box (lower half of range)
    line   eq_line           = na    // Dashed line at equilibrium (50%)
    box    ote_box           = na    // Orange box between Fib 0.618 and 0.786
    label  ote_label         = na    // "OTE" text label

    // ── Alert flags (reset to false at the start of each bar) ──
    bool   alert_bull_bos    = false
    bool   alert_bear_bos    = false
    bool   alert_bull_choch  = false
    bool   alert_bear_choch  = false
    bool   alert_bsl_sweep   = false
    bool   alert_ssl_sweep   = false
    bool   alert_ob_bull      = false
    bool   alert_ob_bear      = false
    bool   alert_ob_mitigated = false
    bool   alert_fvg_bull     = false
    bool   alert_fvg_bear     = false
    bool   alert_fvg_filled   = false

    // ── Internal swing tracking (for OB pullback mitigation) ──
    int    last_internal_sh_bar   = -1   // Bar of most recent internal high
    float  last_internal_sh_price = na   // Price of most recent internal high
    int    last_internal_sl_bar   = -1   // Bar of most recent internal low
    float  last_internal_sl_price = na   // Price of most recent internal low
    int    last_any_sh_bar        = -1   // Bar of most recent major or internal high
    int    last_any_sl_bar        = -1   // Bar of most recent major or internal low

    // ── Re-fire guards (prevent duplicate alerts on the same bar) ──
    int    last_bos_bar      = -1
    int    last_choch_bar    = -1

// ═══════════════════════════════════════════════════════════════════
// ═══ PERSISTENT STATE                                           ═══
// ═══════════════════════════════════════════════════════════════════
// Variables declared with "var" keep their values across bars.
// Without "var", a variable resets to its initial value on every bar.
// This is how the indicator remembers the trend, swing history, etc.

var State st = State.new()                                       // The state machine (trend, levels, flags)
var array<SwingPoint> swings = array.new<SwingPoint>()           // History of all detected swings

// TradingView limits: max 500 labels, 500 lines, 500 boxes per script.
// These arrays track all drawing objects so we can delete the oldest ones
// when approaching the limit, preventing the indicator from crashing.
var array<label> managed_swing_labels  = array.new<label>()
var array<line>  managed_bos_lines     = array.new<line>()
var array<label> managed_bos_labels    = array.new<label>()
var array<line>  managed_choch_lines   = array.new<line>()
var array<label> managed_choch_labels  = array.new<label>()
var array<line>  managed_liq_lines     = array.new<line>()
var array<label> managed_liq_labels    = array.new<label>()
var array<label> managed_sweep_labels  = array.new<label>()

var array<LiquidityPool> liq_pools = array.new<LiquidityPool>()  // Active EQH/EQL liquidity pools

var array<OBData> all_obs = array.new<OBData>()
var array<FVGData> all_fvgs = array.new<FVGData>()

// ═══════════════════════════════════════════════════════════════════
// ═══ MANAGED DRAWING HELPERS                                    ═══
// ═══════════════════════════════════════════════════════════════════
// These helpers enforce TradingView's 500-object limits.
// When we create a new label or line, we add it to a tracking array.
// If the array exceeds the max count, the OLDEST object is deleted
// from the chart to make room. This prevents "too many objects" errors.

addManagedLabel(array<label> arr, label lbl, int maxCount) =>
    arr.push(lbl)
    if arr.size() > maxCount
        label.delete(arr.shift())

addManagedLine(array<line> arr, line ln, int maxCount) =>
    arr.push(ln)
    if arr.size() > maxCount
        line.delete(arr.shift())

// ═══════════════════════════════════════════════════════════════════
// ═══ SWING DETECTION                                            ═══
// ═══════════════════════════════════════════════════════════════════
// Manages the list of detected swings, enforcing two key rules:
//
// ALTERNATION RULE: Swings must alternate High-Low-High-Low. If two
//   highs appear in a row, we keep only the HIGHER one (the more
//   extreme). Same for two lows — keep only the LOWER one. This
//   ensures a clean zigzag pattern without consecutive same-type swings.
//
// RE-DETECTION GUARD: TradingView's pivot functions may re-report the
//   same swing on consecutive bars. If a swing at the same bar already
//   exists, we update it instead of creating a duplicate.

addSwing(int swType, float swPrice, int swBar) =>
    int result = -1
    int count = swings.size()

    if count > 0
        SwingPoint lastSw = swings.get(count - 1)
        if lastSw.swing_type == swType
            // Same type: keep the more extreme one
            if swType == SWING_HIGH
                if swPrice >= lastSw.price
                    bool priceChanged = swPrice != lastSw.price
                    lastSw.price := swPrice
                    lastSw.bar_idx := swBar
                    if priceChanged
                        lastSw.cls := CLS_UNCLASSIFIED
                        lastSw.broken := false
                        lastSw.broken_bar := -1
                    result := count - 1
                // else: discard (old was higher), result stays -1
            else
                if swPrice <= lastSw.price
                    bool priceChanged = swPrice != lastSw.price
                    lastSw.price := swPrice
                    lastSw.bar_idx := swBar
                    if priceChanged
                        lastSw.cls := CLS_UNCLASSIFIED
                        lastSw.broken := false
                        lastSw.broken_bar := -1
                    result := count - 1
                // else: discard (old was lower), result stays -1
        else
            // Different type: search recent entries for re-detection by bar_idx
            // (KAO fork: i_swing_length removed; using fixed depth of 14 — enough
            //  to look back across a few KAO legs for a same-type re-detection)
            int searchDepth = math.min(count, 14)
            int searchStart = count - searchDepth
            bool found = false
            for s = count - 1 to searchStart
                SwingPoint swS = swings.get(s)
                if swS.bar_idx == swBar and swS.swing_type == swType
                    if swType == SWING_HIGH and swPrice >= swS.price
                        bool pc = swPrice != swS.price
                        swS.price := swPrice
                        if pc
                            swS.cls := CLS_UNCLASSIFIED
                            swS.broken := false
                            swS.broken_bar := -1
                        result := s
                        found := true
                        break
                    else if swType == SWING_LOW and swPrice <= swS.price
                        bool pc = swPrice != swS.price
                        swS.price := swPrice
                        if pc
                            swS.cls := CLS_UNCLASSIFIED
                            swS.broken := false
                            swS.broken_bar := -1
                        result := s
                        found := true
                        break
                    else
                        result := s
                        found := true
                        break
            if not found
                result := -2  // Sentinel: needs append
    else
        result := -2

    if result == -2
        SwingPoint newSw = SwingPoint.new(swType, swPrice, swBar, CLS_UNCLASSIFIED, false, -1)
        swings.push(newSw)
        if swings.size() > i_max_swings
            swings.shift()
            if st.strong_low_idx > 0
                st.strong_low_idx -= 1
            else if st.strong_low_idx == 0
                st.strong_low_idx := -1
            if st.strong_high_idx > 0
                st.strong_high_idx -= 1
            else if st.strong_high_idx == 0
                st.strong_high_idx := -1
        result := swings.size() - 1

    result

// ═══════════════════════════════════════════════════════════════════
// ═══ SWING LABEL HELPERS                                        ═══
// ═══════════════════════════════════════════════════════════════════
// These create and manage the text labels on the chart (HH, HL, LH,
// LL, iH, iL). The label text depends on both the swing type (high
// vs low) and the trend context:
//   - Bullish trend + High = "HH" (Higher High, green)
//   - Bullish trend + Low  = "HL" (Higher Low, blue)
//   - Bearish trend + High = "LH" (Lower High, red)
//   - Bearish trend + Low  = "LL" (Lower Low, red)
//   - Internal swing       = "iH" or "iL" (grey, smaller text)
//
// trendCtx parameter: allows overriding the current trend for labeling.
// This is needed when a swing belongs to the OLD trend (e.g., after CHOCH,
// a late HH from the bull trend should still be labeled "HH", not "LH").
// Pass 0 to use the current trend.

createSwingLabel(int swBar, float swPrice, int swType, int cls, int trendCtx) =>
    label result = na
    bool isMajor = cls == CLS_MAJOR
    bool isInternal = cls == CLS_INTERNAL or cls == CLS_UNCLASSIFIED
    int useTrend = trendCtx != 0 ? trendCtx : st.trend

    bool shouldShow = true
    if isMajor and not i_show_major
        shouldShow := false
    if isInternal
        // KAO fork: Internal classification still happens for CHOCH-reference swings
        // (state-machine necessity) but we never draw Internal labels — Major only.
        shouldShow := false

    if shouldShow
        string txt = ""
        color clr = i_col_internal
        string sz = size.tiny

        if isMajor
            sz := size.small
            if swType == SWING_HIGH
                if useTrend == TREND_BULLISH
                    txt := "HH"
                    clr := i_col_bull_major
                else if useTrend == TREND_BEARISH
                    txt := "LH"
                    clr := i_col_bear_major
                else
                    txt := "H"
            else
                if useTrend == TREND_BULLISH
                    txt := "HL"
                    clr := i_col_hl
                else if useTrend == TREND_BEARISH
                    txt := "LL"
                    clr := i_col_bear_major
                else
                    txt := "L"
        else
            txt := swType == SWING_HIGH ? "iH" : "iL"

        string lblStyle = swType == SWING_HIGH ? label.style_label_down : label.style_label_up
        result := label.new(swBar, swPrice, txt, xloc.bar_index, yloc.price,
             color.new(color.black, 100), lblStyle, clr, sz, text.align_center)
        addManagedLabel(managed_swing_labels, result, i_max_swing_labels)
    result

// Reclassify a swing: delete old label, create new one with updated text.
// Used when a swing gets promoted from Internal to Major (e.g., when BOS confirms
// that a previously-internal low was actually the HL that defined the trend).
relabelSwing(SwingPoint sw, int cls, int trendCtx) =>
    if not na(sw.lbl)
        label.delete(sw.lbl)
        sw.lbl := na
    sw.cls := cls
    sw.lbl := createSwingLabel(sw.bar_idx, sw.price, sw.swing_type, cls, trendCtx)

// ═══════════════════════════════════════════════════════════════════
// ═══ SEARCH HELPERS                                             ═══
// ═══════════════════════════════════════════════════════════════════
// Functions to search through swing history and bar data to find
// specific swings or price extremes within a bar range.
//
// TWO TYPES OF SEARCH:
//   1. Swing-based search: looks only at detected swing points
//      (used for finding HH, LL, reference swings)
//   2. Bar-based search: scans EVERY bar's actual high/low price
//      (used for finding HL/LH — more accurate because the true
//       lowest low or highest high might not be a detected swing,
//       especially with small swing_length settings)

// Find the swing low with the lowest price between two bars
findLowestSwingLowBetween(int barStart, int barEnd) =>
    int candidate = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.bar_idx <= barStart
            break
        if sw.bar_idx >= barEnd
            continue
        if sw.swing_type == SWING_LOW
            if candidate == -1 or sw.price < swings.get(candidate).price
                candidate := i
    candidate

// Find highest-price swing high between two bars (exclusive both ends)
findHighestSwingHighBetween(int barStart, int barEnd) =>
    int candidate = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.bar_idx <= barStart
            break
        if sw.bar_idx >= barEnd
            continue
        if sw.swing_type == SWING_HIGH
            if candidate == -1 or sw.price > swings.get(candidate).price
                candidate := i
    candidate

// Find most recent swing high before a bar
findLastSwingHighBefore(int bar) =>
    int result = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.swing_type == SWING_HIGH and sw.bar_idx < bar
            result := i
            break
    result

// Find most recent swing low before a bar
findLastSwingLowBefore(int bar) =>
    int result = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.swing_type == SWING_LOW and sw.bar_idx < bar
            result := i
            break
    result

// BAR-BASED SEARCH: Find the bar with the absolute lowest low price
// between two bars. Unlike swing-based search, this checks EVERY bar,
// not just detected swings. This is important because with small
// swing_length (like 3), the true lowest bar might not be a swing point.
// Returns [barIndex, price].
findLowestBarLowBetween(int barStart, int barEnd) =>
    int bestBar = -1
    float bestPrice = na
    if barEnd > barStart + 1
        for j = barStart + 1 to barEnd - 1
            int offset = bar_index - j
            if offset >= 0
                float barLow = low[offset]
                if na(bestPrice) or barLow < bestPrice
                    bestPrice := barLow
                    bestBar := j
    [bestBar, bestPrice]

// BAR-BASED SEARCH: Find the bar with the absolute highest high price
// between two bars. Same concept as above but for highs.
findHighestBarHighBetween(int barStart, int barEnd) =>
    int bestBar = -1
    float bestPrice = na
    if barEnd > barStart + 1
        for j = barStart + 1 to barEnd - 1
            int offset = bar_index - j
            if offset >= 0
                float barHigh = high[offset]
                if na(bestPrice) or barHigh > bestPrice
                    bestPrice := barHigh
                    bestBar := j
    [bestBar, bestPrice]

// Check if a detected swing exists at a specific bar.
// Used after bar-based search: if the lowest low bar happens to have
// a swing point, we relabel it. If not, we create a standalone label.
findSwingAtBar(int targetBar, int swType) =>
    int result = -1
    for i = swings.size() - 1 to 0
        SwingPoint sw = swings.get(i)
        if sw.bar_idx == targetBar and sw.swing_type == swType
            result := i
            break
        if sw.bar_idx < targetBar
            break
    result

// ═══════════════════════════════════════════════════════════════════
// ═══ BREAK DETECTION                                            ═══
// ═══════════════════════════════════════════════════════════════════
// Checks whether price has broken above or below a given level.
// Two modes controlled by the "Break Confirmation" setting:
//   - "Close" mode: the candle body must CLOSE beyond the level
//     (more reliable, fewer false breaks)
//   - "Wick" mode: just touching the level with high/low counts
//     (more responsive, catches more breaks but some may be false)

checkBreakAbove(float level, float closePrice, float highPrice) =>
    if na(level)
        false
    else
        i_break_mode == "Close" ? closePrice > level : highPrice > level

checkBreakBelow(float level, float closePrice, float lowPrice) =>
    if na(level)
        false
    else
        i_break_mode == "Close" ? closePrice < level : lowPrice < level

// ═══════════════════════════════════════════════════════════════════
// ═══ INITIALIZATION                                             ═══
// ═══════════════════════════════════════════════════════════════════
// Before the indicator can classify swings, it needs to establish the
// initial trend direction. This requires at least 4 alternating swings
// that form a clear pattern:
//   - If we see Low → High → Higher Low → Higher High → bullish trend
//   - If we see High → Low → Lower High → Lower Low → bearish trend
// Once initialized, the state machine takes over classification.
// If no clear pattern is found after 8 swings, we fall back to
// comparing first and last swing prices to guess the direction.

tryInitialize() =>
    bool success = false
    int count = swings.size()

    if count >= 4
        for start = 0 to count - 4
            if success
                break
            int s1 = start
            int s2 = start + 1
            int s3 = start + 2
            int s4 = start + 3
            SwingPoint sw1 = swings.get(s1)
            SwingPoint sw2 = swings.get(s2)
            SwingPoint sw3 = swings.get(s3)
            SwingPoint sw4 = swings.get(s4)

            if sw1.swing_type == SWING_LOW and sw2.swing_type == SWING_HIGH and sw3.swing_type == SWING_LOW and sw4.swing_type == SWING_HIGH
                if sw4.price > sw2.price and sw3.price > sw1.price
                    st.trend := TREND_BULLISH
                    st.strong_low := sw3.price
                    st.strong_low_bar := sw3.bar_idx
                    st.strong_low_idx := s3
                    st.ref_high := sw4.price
                    st.ref_high_bar := sw4.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true
                else if sw4.price < sw2.price and sw3.price < sw1.price
                    st.trend := TREND_BEARISH
                    st.strong_high := sw2.price
                    st.strong_high_bar := sw2.bar_idx
                    st.strong_high_idx := s2
                    st.ref_low := sw4.price
                    st.ref_low_bar := sw4.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true

            else if sw1.swing_type == SWING_HIGH and sw2.swing_type == SWING_LOW and sw3.swing_type == SWING_HIGH and sw4.swing_type == SWING_LOW
                if sw3.price > sw1.price and sw4.price > sw2.price
                    st.trend := TREND_BULLISH
                    st.strong_low := sw4.price
                    st.strong_low_bar := sw4.bar_idx
                    st.strong_low_idx := s4
                    st.ref_high := sw3.price
                    st.ref_high_bar := sw3.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true
                else if sw3.price < sw1.price and sw4.price < sw2.price
                    st.trend := TREND_BEARISH
                    st.strong_high := sw1.price
                    st.strong_high_bar := sw1.bar_idx
                    st.strong_high_idx := s1
                    st.ref_low := sw4.price
                    st.ref_low_bar := sw4.bar_idx
                    for k = s1 to s4
                        SwingPoint swK = swings.get(k)
                        swK.cls := CLS_MAJOR
                    success := true

    if not success and count >= 8
        SwingPoint firstSw = swings.get(0)
        SwingPoint lastSw = swings.get(count - 1)
        if lastSw.price > firstSw.price
            st.trend := TREND_BULLISH
            int slIdx = findLastSwingLowBefore(lastSw.bar_idx + 1)
            int shIdx = findLastSwingHighBefore(lastSw.bar_idx + 1)
            if slIdx >= 0
                st.strong_low := swings.get(slIdx).price
                st.strong_low_bar := swings.get(slIdx).bar_idx
                st.strong_low_idx := slIdx
            if shIdx >= 0
                st.ref_high := swings.get(shIdx).price
                st.ref_high_bar := swings.get(shIdx).bar_idx
        else
            st.trend := TREND_BEARISH
            int shIdx = findLastSwingHighBefore(lastSw.bar_idx + 1)
            int slIdx = findLastSwingLowBefore(lastSw.bar_idx + 1)
            if shIdx >= 0
                st.strong_high := swings.get(shIdx).price
                st.strong_high_bar := swings.get(shIdx).bar_idx
                st.strong_high_idx := shIdx
            if slIdx >= 0
                st.ref_low := swings.get(slIdx).price
                st.ref_low_bar := swings.get(slIdx).bar_idx
        for k = 0 to count - 1
            SwingPoint swK = swings.get(k)
            swK.cls := CLS_MAJOR
        success := true

    success

// ═══════════════════════════════════════════════════════════════════
// ═══ BOS / CHOCH LINE DRAWING                                   ═══
// ═══════════════════════════════════════════════════════════════════
// Draws horizontal lines on the chart to mark BOS and CHOCH events.
//   - BOS lines: dashed, 1px thick, with "BOS" label at midpoint
//   - CHOCH lines: solid, 2px thick (more prominent), with "CHoCH" label
// Lines extend from the broken level's bar to the break bar.

drawBOSLine(int barFrom, float priceLevel, int barTo, bool isBullish) =>
    if i_show_bos and barFrom >= 0 and barTo >= 0
        color clr = isBullish ? i_col_bos_bull : i_col_bos_bear
        line ln = line.new(barFrom, priceLevel, barTo, priceLevel, xloc.bar_index, extend.none, clr, line.style_dashed, 1)
        addManagedLine(managed_bos_lines, ln, i_max_bos_objects)
        int midBar = math.round((barFrom + barTo) / 2)
        label lbl = label.new(midBar, priceLevel, "BOS", xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.tiny, text.align_center)
        addManagedLabel(managed_bos_labels, lbl, i_max_bos_objects)

drawCHOCHLine(int barFrom, float priceLevel, int barTo, bool newTrendBullish) =>
    if i_show_choch and barFrom >= 0 and barTo >= 0
        color clr = newTrendBullish ? i_col_choch_bull : i_col_choch_bear
        line ln = line.new(barFrom, priceLevel, barTo, priceLevel, xloc.bar_index, extend.none, clr, line.style_solid, 2)
        addManagedLine(managed_choch_lines, ln, i_max_choch_objects)
        int midBar = math.round((barFrom + barTo) / 2)
        label lbl = label.new(midBar, priceLevel, "CHoCH", xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.small, text.align_center)
        addManagedLabel(managed_choch_labels, lbl, i_max_choch_objects)

// Draw/update the Strong High or Strong Low dotted horizontal line.
// These lines extend to the right edge of the chart and show where
// CHOCH would trigger. Old line is deleted before drawing new one.
drawStrongLevel(bool isLow, int barFrom, float price) =>
    if i_show_strong and not na(price) and barFrom >= 0
        color clr = isLow ? i_col_hl : i_col_bear_major
        if isLow
            if not na(st.strong_low_line)
                line.delete(st.strong_low_line)
            st.strong_low_line := line.new(barFrom, price, bar_index, price, xloc.bar_index, extend.right, clr, line.style_dotted, 1)
        else
            if not na(st.strong_high_line)
                line.delete(st.strong_high_line)
            st.strong_high_line := line.new(barFrom, price, bar_index, price, xloc.bar_index, extend.right, clr, line.style_dotted, 1)

// ═══════════════════════════════════════════════════════════════════
// ═══ ZONE DRAWING                                               ═══
// ═══════════════════════════════════════════════════════════════════
// Premium/Discount zones divide the current structural range in half:
//   - Premium (upper half, red) = expensive area, smart money sells here
//   - Discount (lower half, green) = cheap area, smart money buys here
//   - Equilibrium (midpoint, cyan dashed line) = the dividing line
//
// The range is defined by:
//   - Bullish trend: range = Strong Low to Ref High (last HH)
//   - Bearish trend: range = Ref Low (last LL) to Strong High
//
// Zones are recalculated whenever BOS or CHOCH changes the range.

updateZones() =>
    if not na(st.premium_box)
        box.delete(st.premium_box)
        st.premium_box := na
    if not na(st.discount_box)
        box.delete(st.discount_box)
        st.discount_box := na
    if not na(st.eq_line)
        line.delete(st.eq_line)
        st.eq_line := na

    int rangeStartBar = -1
    if st.trend == TREND_BULLISH
        st.range_high := st.ref_high
        st.range_low := st.strong_low
        rangeStartBar := st.strong_low_bar
    else if st.trend == TREND_BEARISH
        st.range_high := st.strong_high
        st.range_low := st.ref_low
        rangeStartBar := st.strong_high_bar

    if not na(st.range_high) and not na(st.range_low) and rangeStartBar >= 0
        st.equilibrium := (st.range_high + st.range_low) / 2.0
        if i_show_pd
            st.premium_box := box.new(rangeStartBar, st.range_high, bar_index, st.equilibrium, color(na), 0, line.style_solid, extend.none, xloc.bar_index, color.new(i_col_premium, 93))
            st.discount_box := box.new(rangeStartBar, st.equilibrium, bar_index, st.range_low, color(na), 0, line.style_solid, extend.none, xloc.bar_index, color.new(i_col_discount, 93))
        if i_show_eq
            st.eq_line := line.new(rangeStartBar, st.equilibrium, bar_index, st.equilibrium, xloc.bar_index, extend.right, i_col_eq_line, line.style_dashed, 1)

// OTE (Optimal Trade Entry) zone: Fibonacci 0.618 to 0.786 retracement.
// This is the "sweet spot" for entering trades in the trend direction.
// In a bullish trend: OTE is a pullback zone below the HH.
// In a bearish trend: OTE is a bounce zone above the LL.
updateOTE(bool isBullish) =>
    if not na(st.ote_box)
        box.delete(st.ote_box)
        st.ote_box := na
    if not na(st.ote_label)
        label.delete(st.ote_label)
        st.ote_label := na

    if i_show_ote
        float swHigh = na
        float swLow = na
        int oteStart = -1

        if isBullish
            swLow := st.strong_low
            swHigh := st.ref_high
            oteStart := st.strong_low_bar
        else
            swHigh := st.strong_high
            swLow := st.ref_low
            oteStart := st.strong_high_bar

        if not na(swHigh) and not na(swLow) and oteStart >= 0
            float rng = swHigh - swLow
            if rng > 0
                if isBullish
                    st.ote_top := swHigh - rng * 0.618
                    st.ote_bottom := swHigh - rng * 0.786
                else
                    st.ote_top := swLow + rng * 0.786
                    st.ote_bottom := swLow + rng * 0.618

                st.ote_box := box.new(oteStart, st.ote_top, bar_index, st.ote_bottom, i_col_ote, 1, line.style_solid, extend.none, xloc.bar_index, color.new(i_col_ote, 90))
                int midBar = math.round((oteStart + bar_index) / 2)
                float midPrice = (st.ote_top + st.ote_bottom) / 2.0
                st.ote_label := label.new(midBar, midPrice, "OTE", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_ote, size.small, text.align_center)

clearOTE() =>
    if not na(st.ote_box)
        box.delete(st.ote_box)
        st.ote_box := na
    if not na(st.ote_label)
        label.delete(st.ote_label)
        st.ote_label := na
    st.ote_top := na
    st.ote_bottom := na

// ═══════════════════════════════════════════════════════════════════
// ═══ ORDER BLOCK DETECTION                                      ═══
// ═══════════════════════════════════════════════════════════════════

// Check if any FVG (3-candle gap) exists from fromBar to toBar (inclusive range)
// A 3-candle FVG at position j means: candle j, candle j+1 (impulse), candle j+2
// For bullish: low[j+2] > high[j] (gap up — candle 3's low above candle 1's high)
// For bearish: high[j+2] < low[j] (gap down — candle 3's high below candle 1's low)
// The search extends up to toBar to catch FVGs that start before and end at/after BOS.
hasFVGBetween(int fromBar, int toBar, bool isBullish) =>
    bool result = false
    if toBar >= fromBar
        for j = fromBar to toBar
            int off0 = bar_index - j
            int off2 = bar_index - (j + 2)
            if off0 >= 0 and off2 >= 0 and off0 < bar_index and off2 < bar_index
                if isBullish
                    if low[off2] > high[off0]
                        result := true
                        break
                else
                    if high[off2] < low[off0]
                        result := true
                        break
    result

// Check if an OB already exists at the given bar
obExistsAtBar(int barIdx) =>
    bool found = false
    if all_obs.size() > 0
        for i = 0 to all_obs.size() - 1
            if all_obs.get(i).ob_bar == barIdx
                found := true
                break
    found

// Check if price already overlapped the OB zone between ob_bar+4 and current bar.
// Skips the first 3 candles after the OB candle (the impulse move that forms the
// FVG/displacement pattern). Only candles AFTER the impulse are checked.
// Bullish OB: any candle low penetrating >= threshold into the zone = mitigated.
// Bearish OB: any candle high penetrating >= threshold into the zone = mitigated.
checkImmediateOBMitigation(OBData ob) =>
    bool mitigated = false
    if i_ob_imm_mit_pct > 0.0 and ob.state == "active"
        float zoneDepth = ob.top - ob.bottom
        if zoneDepth > 0
            float threshold = zoneDepth * i_ob_imm_mit_pct
            int startBar = ob.ob_bar + 4
            int endBar = bar_index
            if endBar > startBar
                for j = startBar to endBar
                    int offset = bar_index - j
                    if offset >= 0 and offset < bar_index
                        if ob.direction == 1
                            // Bullish OB: check if candle low dipped into zone
                            float candleLow = low[offset]
                            if candleLow <= ob.top
                                float penetration = ob.top - math.max(candleLow, ob.bottom)
                                if penetration >= threshold
                                    mitigated := true
                                    break
                        else
                            // Bearish OB: check if candle high pushed into zone
                            float candleHigh = high[offset]
                            if candleHigh >= ob.bottom
                                float penetration = math.min(candleHigh, ob.top) - ob.bottom
                                if penetration >= threshold
                                    mitigated := true
                                    break
        if mitigated
            ob.state := "tested"
            st.alert_ob_mitigated := true
            if i_debug_ob
                log.warning("OB bar={0} dir={1} → IMMEDIATELY MITIGATED (price overlapped zone before confirmation)", ob.ob_bar, ob.direction)
    true

// Create an OB and add to storage
createOB(int dir, float obTop, float obBottom, int obBar, int src, float bosLevel) =>
    if not obExistsAtBar(obBar)
        OBData ob = OBData.new(dir, obTop, obBottom, obBar, src, "active", bosLevel)
        all_obs.push(ob)
        if i_debug_ob
            log.info("NEW OB: bar={0} dir={1} src={2} top={3} bot={4} bos_level={5}", obBar, dir, src, obTop, obBottom, bosLevel)
        if all_obs.size() > i_max_stored_ob
            OBData old = all_obs.shift()
            if not na(old.ob_box)
                box.delete(old.ob_box)
            if not na(old.ob_label)
                label.delete(old.ob_label)
        if dir == 1
            st.alert_ob_bull := true
        else
            st.alert_ob_bear := true
        // Immediate mitigation check: scan bars between OB candle and now
        checkImmediateOBMitigation(ob)

// Detect OB at a BOS/CHOCH event (Mode A)
// The HL/LH swing point IS the OB. Validation: there must be at least one FVG
// between the HL/LH bar and the BOS break bar (impulsive move confirmation).
// obBar/obHigh/obLow = the HL (bullish) or LH (bearish) swing point.
detectBOSLinkedOB(bool isBullish, int breakBar, int src, int obBar, float obHigh, float obLow, float bosLevel) =>
    if i_show_ob and (i_ob_mode == "BOS/CHOCH" or i_ob_mode == "Both")
        if obBar >= 0 and not na(obHigh) and not na(obLow)
            if hasFVGBetween(obBar, breakBar, isBullish)
                if isBullish
                    createOB(1, obHigh, obLow, obBar, src, bosLevel)
                else
                    createOB(-1, obHigh, obLow, obBar, src, bosLevel)

// Detect standalone displacement OBs (every bar, Mode B)
// Uses gap + sweep pattern: OB candle must have a price gap AND a local
// extremum (sweep). Checks both bar[2] and bar[3] as candidate OB candles.
// Bullish OB: upward gap (high[idx] < low[0]) + low sweep (low[idx] < neighbors)
// Bearish OB: downward gap (low[idx] > high[0]) + high sweep (high[idx] > neighbors)
detectStandaloneOBs() =>
    if i_show_ob and (i_ob_mode == "Displacement" or i_ob_mode == "Both")
        if bar_index > 4
            // --- Bullish OB detection (demand zone) ---
            // Check bar[2] as candidate bullish OB
            bool bullGap2 = high[2] < low[0] and high[2] < high[0]
            bool bullSweep2 = low[2] < low[1] and low[2] < low[3]
            if bullGap2 and bullSweep2
                int obBar2 = bar_index - 2
                createOB(1, high[2], low[2], obBar2, 3, na)
            // Check bar[3] as candidate bullish OB
            bool bullGap3 = high[3] < low[0] and high[3] < high[0]
            bool bullSweep3 = low[3] < low[2] and low[3] < low[4]
            if bullGap3 and bullSweep3
                int obBar3 = bar_index - 3
                createOB(1, high[3], low[3], obBar3, 3, na)

            // --- Bearish OB detection (supply zone) ---
            // Check bar[2] as candidate bearish OB
            bool bearGap2 = low[2] > high[0] and low[2] > low[0]
            bool bearSweep2 = high[2] > high[1] and high[2] > high[3]
            if bearGap2 and bearSweep2
                int obBar2 = bar_index - 2
                createOB(-1, high[2], low[2], obBar2, 3, na)
            // Check bar[3] as candidate bearish OB
            bool bearGap3 = low[3] > high[0] and low[3] > low[0]
            bool bearSweep3 = high[3] > high[2] and high[3] > high[4]
            if bearGap3 and bearSweep3
                int obBar3 = bar_index - 3
                createOB(-1, high[3], low[3], obBar3, 3, na)

// ═══════════════════════════════════════════════════════════════════
// ═══ FAIR VALUE GAP DETECTION                                   ═══
// ═══════════════════════════════════════════════════════════════════

// Detect Fair Value Gaps (standard 3-candle pattern)
detectFVGs() =>
    if i_show_fvg and bar_index > 3
        float atrVal = nz(ta.atr(14))
        float minGap = i_fvg_min_atr_mult > 0 ? atrVal * i_fvg_min_atr_mult : 0.0

        // Bullish FVG: low[0] > high[2] (gap between candle 0's low and candle 2's high)
        if low[0] > high[2]
            float gapSize = low[0] - high[2]
            if gapSize > minGap
                FVGData fvg = FVGData.new(1, low[0], high[2], bar_index - 1, 0.0, false, false)
                all_fvgs.push(fvg)
                if all_fvgs.size() > i_max_stored_fvg
                    FVGData old = all_fvgs.shift()
                    if not na(old.fvg_box)
                        box.delete(old.fvg_box)
                    if not na(old.fvg_label)
                        label.delete(old.fvg_label)
                st.alert_fvg_bull := true

        // Bearish FVG: high[0] < low[2] (gap between candle 0's high and candle 2's low)
        if high[0] < low[2]
            float gapSize = low[2] - high[0]
            if gapSize > minGap
                FVGData fvg = FVGData.new(-1, low[2], high[0], bar_index - 1, 0.0, false, false)
                all_fvgs.push(fvg)
                if all_fvgs.size() > i_max_stored_fvg
                    FVGData old = all_fvgs.shift()
                    if not na(old.fvg_box)
                        box.delete(old.fvg_box)
                    if not na(old.fvg_label)
                        label.delete(old.fvg_label)
                st.alert_fvg_bear := true

// ═══════════════════════════════════════════════════════════════════
// ═══ OB & FVG DRAWING HELPERS                                  ═══
// ═══════════════════════════════════════════════════════════════════

// Helper: delete OB drawing objects (defined here so mitigation can use it)
clearOBDrawing(OBData ob) =>
    if not na(ob.ob_box)
        box.delete(ob.ob_box)
        ob.ob_box := na
    if not na(ob.ob_label)
        label.delete(ob.ob_label)
        ob.ob_label := na
    true

// ═══════════════════════════════════════════════════════════════════
// ═══ OB & FVG MITIGATION TRACKING                              ═══
// ═══════════════════════════════════════════════════════════════════

// Update OB state machine: active → tested → breaker → reversed
// State transitions:
//   active + price touches zone → tested (simple mitigation)
//   active (Mode A) + internal pullback confirmed + price touches zone → tested (pullback mitigation)
//   active/tested + close breaks through OB → breaker (Mode A) or removed (Mode B)
//   breaker + swing forms after + price tests zone → tested (breaker mitigation)
//   breaker + close breaks back through → reversed (final state)
updateOBMitigation() =>
    if all_obs.size() > 0
        for i = 0 to all_obs.size() - 1
            OBData ob = all_obs.get(i)
            // Skip final state
            if ob.state == "reversed"
                continue

            // ── Check breaker → tested or reversed ──
            if ob.state == "breaker"
                // First check: breaker reversed (close breaks back through)
                if ob.direction == 1  // Breaker Resistance: reversed when close > top
                    if close > ob.top
                        ob.state := "reversed"
                        clearOBDrawing(ob)
                        continue
                else  // Breaker Support: reversed when close < bottom
                    if close < ob.bottom
                        ob.state := "reversed"
                        clearOBDrawing(ob)
                        continue

                // Second check: swing formed after breaker? (track for breaker mitigation)
                if not ob.swing_after_breaker and ob.breaker_bar >= 0
                    // Check if any major or internal swing formed after the breaker bar
                    if ob.direction == 1
                        // Bull OB became breaker resistance — need a swing low after
                        if st.last_any_sl_bar > ob.breaker_bar
                            ob.swing_after_breaker := true
                    else
                        // Bear OB became breaker support — need a swing high after
                        if st.last_any_sh_bar > ob.breaker_bar
                            ob.swing_after_breaker := true

                // Third check: breaker tested by price after swing → becomes tested (mitigated)
                if ob.swing_after_breaker
                    if ob.direction == 1  // Breaker Resistance tested when high reaches zone
                        if high >= ob.bottom and high <= ob.top
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                    else  // Breaker Support tested when low reaches zone
                        if low <= ob.top and low >= ob.bottom
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                continue

            // ── Check active/tested → breaker (or removed for Mode B) ──
            if ob.state == "active" or ob.state == "tested"
                bool broken = false
                if ob.direction == 1  // Bullish OB broken when close < bottom
                    broken := close < ob.bottom
                else  // Bearish OB broken when close > top
                    broken := close > ob.top
                if broken
                    if (ob.source == 1 or ob.source == 2) and not ob.was_breaker
                        // Mode A: becomes breaker (role reversal) — first time only
                        ob.state := "breaker"
                        ob.breaker_bar := bar_index
                        ob.swing_after_breaker := false
                        ob.was_breaker := true
                        clearOBDrawing(ob)
                    else
                        // Mode B or already-was-breaker: final removal
                        ob.state := "reversed"
                        clearOBDrawing(ob)
                    st.alert_ob_mitigated := true
                    continue

            // ── Check active → tested (two paths) ──
            if ob.state == "active"
                // Debug: log active OB state on each bar
                if i_debug_ob and barstate.isconfirmed and ob.source != 3
                    log.info("OB bar={0} dir={1} src={2} top={3} bot={4} bos={5} pullback={6} | low={7} high={8} | iSH_bar={9} iSH_px={10}",
                         ob.ob_bar, ob.direction, ob.source,
                         ob.top, ob.bottom, ob.bos_level, ob.pullback_confirmed,
                         low, high, st.last_internal_sh_bar, st.last_internal_sh_price)

                // Path 1 (Mode A only): Internal pullback confirmation + zone touch
                // Bull OB: internal high after OB bar with price < BOS level → then low touches zone
                // Bear OB: internal low after OB bar with price > BOS level → then high touches zone
                if (ob.source == 1 or ob.source == 2) and not na(ob.bos_level) and not ob.pullback_confirmed
                    if ob.direction == 1
                        // Check for first internal high after OB bar, below BOS level
                        if st.last_internal_sh_bar > ob.ob_bar and not na(st.last_internal_sh_price)
                            if st.last_internal_sh_price < ob.bos_level
                                ob.pullback_confirmed := true
                                if i_debug_ob
                                    log.warning("OB bar={0} PULLBACK CONFIRMED: iSH={1} < bos={2}", ob.ob_bar, st.last_internal_sh_price, ob.bos_level)
                    else
                        // Check for first internal low after OB bar, above BOS level
                        if st.last_internal_sl_bar > ob.ob_bar and not na(st.last_internal_sl_price)
                            if st.last_internal_sl_price > ob.bos_level
                                ob.pullback_confirmed := true
                                if i_debug_ob
                                    log.warning("OB bar={0} PULLBACK CONFIRMED: iSL={1} > bos={2}", ob.ob_bar, st.last_internal_sl_price, ob.bos_level)

                // Path 1 trigger: pullback confirmed + price touches zone
                if ob.pullback_confirmed
                    if ob.direction == 1
                        if low <= ob.top and low >= ob.bottom
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                            if i_debug_ob
                                log.warning("OB bar={0} → TESTED via Path 1 (pullback)", ob.ob_bar)
                            continue
                    else
                        if high >= ob.bottom and high <= ob.top
                            ob.state := "tested"
                            st.alert_ob_mitigated := true
                            clearOBDrawing(ob)
                            if i_debug_ob
                                log.warning("OB bar={0} → TESTED via Path 1 (pullback)", ob.ob_bar)
                            continue

                // Path 2 (all OBs): Simple zone touch = tested
                if ob.direction == 1  // Bullish OB: tested when low touches zone
                    if low <= ob.top and low >= ob.bottom
                        ob.state := "tested"
                        st.alert_ob_mitigated := true
                        clearOBDrawing(ob)
                        if i_debug_ob
                            log.warning("OB bar={0} → TESTED via Path 2 (simple touch)", ob.ob_bar)
                else  // Bearish OB: tested when high touches zone
                    if high >= ob.bottom and high <= ob.top
                        ob.state := "tested"
                        st.alert_ob_mitigated := true
                        clearOBDrawing(ob)
                        if i_debug_ob
                            log.warning("OB bar={0} → TESTED via Path 2 (simple touch)", ob.ob_bar)

// Update FVG fill tracking
updateFVGMitigation() =>
    if all_fvgs.size() > 0
        for i = 0 to all_fvgs.size() - 1
            FVGData fvg = all_fvgs.get(i)
            if not fvg.broken
                float gapSize = fvg.top - fvg.bottom
                if gapSize > 0
                    if fvg.direction == 1  // bullish FVG
                        if low < fvg.top
                            float fillDepth = fvg.top - math.max(low, fvg.bottom)
                            float pct = fillDepth / gapSize
                            if pct > fvg.fill_pct
                                fvg.fill_pct := pct
                            if fvg.fill_pct >= i_fvg_fill_pct and not fvg.filled
                                fvg.filled := true
                                st.alert_fvg_filled := true
                        if close < fvg.bottom
                            fvg.broken := true
                    else  // bearish FVG
                        if high > fvg.bottom
                            float fillDepth = math.min(high, fvg.top) - fvg.bottom
                            float pct = fillDepth / gapSize
                            if pct > fvg.fill_pct
                                fvg.fill_pct := pct
                            if fvg.fill_pct >= i_fvg_fill_pct and not fvg.filled
                                fvg.filled := true
                                st.alert_fvg_filled := true
                        if close > fvg.top
                            fvg.broken := true

// ═══════════════════════════════════════════════════════════════════
// ═══ OB & FVG PROXIMITY DISPLAY                                ═══
// ═══════════════════════════════════════════════════════════════════

// Helper: delete FVG drawing objects
clearFVGDrawing(FVGData fvg) =>
    if not na(fvg.fvg_box)
        box.delete(fvg.fvg_box)
        fvg.fvg_box := na
    if not na(fvg.fvg_label)
        label.delete(fvg.fvg_label)
        fvg.fvg_label := na
    true

// Helper: draw or update a single OB box+label
// Clamps left edge to avoid "too far from current bar" error (TradingView limit ~5000 bars)
drawSingleOB(OBData ob, color clr) =>
    int leftBar = math.max(ob.ob_bar, bar_index - 4999)
    if na(ob.ob_box)
        ob.ob_box := box.new(leftBar, ob.top, bar_index, ob.bottom, clr, 1, line.style_solid, extend.none, xloc.bar_index, color.new(clr, 90))
        string srcTxt = ""
        if ob.state == "breaker"
            srcTxt := ob.direction == 1 ? "Breaker R" : "Breaker S"
        else if ob.state == "tested"
            string base = ob.source == 1 ? "OB (BOS)" : ob.source == 2 ? "OB (CHoCH)" : "OB (Disp)"
            srcTxt := base + " ✓"
        else
            srcTxt := ob.source == 1 ? "OB (BOS)" : ob.source == 2 ? "OB (CHoCH)" : "OB (Disp)"
        ob.ob_label := label.new(leftBar, (ob.top + ob.bottom) / 2.0, srcTxt, xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.tiny, text.align_left)
    else
        box.set_right(ob.ob_box, bar_index)
        box.set_bgcolor(ob.ob_box, color.new(clr, 90))
        box.set_border_color(ob.ob_box, clr)
        if not na(ob.ob_label)
            label.set_textcolor(ob.ob_label, clr)
    true

// Helper: draw or update a single FVG box+label
// Same bar index clamping as OBs
drawSingleFVG(FVGData fvg, color clr) =>
    int leftBar = math.max(fvg.fvg_bar, bar_index - 4999)
    if na(fvg.fvg_box)
        fvg.fvg_box := box.new(leftBar, fvg.top, bar_index, fvg.bottom, clr, 1, line.style_solid, extend.none, xloc.bar_index, color.new(clr, 90))
        fvg.fvg_label := label.new(leftBar, (fvg.top + fvg.bottom) / 2.0, "FVG", xloc.bar_index, yloc.price, color(na), label.style_none, clr, size.tiny, text.align_left)
    else
        box.set_right(fvg.fvg_box, bar_index)
        box.set_bgcolor(fvg.fvg_box, color.new(clr, 90))
        box.set_border_color(fvg.fvg_box, clr)
        if not na(fvg.fvg_label)
            label.set_textcolor(fvg.fvg_label, clr)
    true

// Check if index is in the visible set
isInVisibleSet(array<int> visible, int idx) =>
    bool found = false
    if visible.size() > 0
        for v = 0 to visible.size() - 1
            if visible.get(v) == idx
                found := true
                break
    found

// Select N closest indices by distance
selectNClosest(array<int> indices, array<float> distances, int maxN) =>
    array<int> result = array.new<int>()
    if indices.size() > 0
        // Work on a copy of distances so we don't mutate the original
        array<float> dCopy = distances.copy()
        for n = 0 to math.min(maxN, indices.size()) - 1
            float minDist = 1e18
            int minIdx = -1
            for j = 0 to indices.size() - 1
                if dCopy.get(j) < minDist
                    minDist := dCopy.get(j)
                    minIdx := j
            if minIdx >= 0
                result.push(indices.get(minIdx))
                dCopy.set(minIdx, 1e18)
    result

// Draw the N closest OBs to current price, per direction (bull/bear independently).
// Active OBs get priority. Then tested (mitigated). Then breakers.
// Reversed OBs are never shown.
drawProximityOBs() =>
    if all_obs.size() > 0
        if not i_show_ob
            for i = 0 to all_obs.size() - 1
                clearOBDrawing(all_obs.get(i))
        else
            // Separate into priority tiers × direction (4 buckets)
            array<int> bullActiveIdx = array.new<int>()
            array<float> bullActiveDist = array.new<float>()
            array<int> bullSecondIdx = array.new<int>()
            array<float> bullSecondDist = array.new<float>()
            array<int> bearActiveIdx = array.new<int>()
            array<float> bearActiveDist = array.new<float>()
            array<int> bearSecondIdx = array.new<int>()
            array<float> bearSecondDist = array.new<float>()

            for i = 0 to all_obs.size() - 1
                OBData ob = all_obs.get(i)
                bool eligible = true
                bool isSecondary = false

                if ob.state == "reversed"
                    eligible := false
                else if ob.state == "breaker"
                    if not i_show_breaker_ob
                        eligible := false
                    if eligible
                        isSecondary := true
                else if ob.state == "tested"
                    if not i_show_mitigated_ob
                        eligible := false
                    if eligible
                        isSecondary := true
                else
                    // "active" state — primary
                    if ob.direction == 1 and not i_show_bull_ob
                        eligible := false
                    if eligible and ob.direction == -1 and not i_show_bear_ob
                        eligible := false

                if not eligible
                    clearOBDrawing(ob)
                else
                    float mid = (ob.top + ob.bottom) / 2.0
                    float dist = math.abs(close - mid)
                    if ob.direction == 1
                        if isSecondary
                            bullSecondIdx.push(i)
                            bullSecondDist.push(dist)
                        else
                            bullActiveIdx.push(i)
                            bullActiveDist.push(dist)
                    else
                        if isSecondary
                            bearSecondIdx.push(i)
                            bearSecondDist.push(dist)
                        else
                            bearActiveIdx.push(i)
                            bearActiveDist.push(dist)

            // Select N closest per direction: active first, then secondary
            array<int> bullVisible = selectNClosest(bullActiveIdx, bullActiveDist, i_max_visible_ob)
            int bullRemaining = i_max_visible_ob - bullVisible.size()
            if bullRemaining > 0 and bullSecondIdx.size() > 0
                array<int> bsv = selectNClosest(bullSecondIdx, bullSecondDist, bullRemaining)
                if bsv.size() > 0
                    for s = 0 to bsv.size() - 1
                        bullVisible.push(bsv.get(s))

            array<int> bearVisible = selectNClosest(bearActiveIdx, bearActiveDist, i_max_visible_ob)
            int bearRemaining = i_max_visible_ob - bearVisible.size()
            if bearRemaining > 0 and bearSecondIdx.size() > 0
                array<int> bsv2 = selectNClosest(bearSecondIdx, bearSecondDist, bearRemaining)
                if bsv2.size() > 0
                    for s = 0 to bsv2.size() - 1
                        bearVisible.push(bsv2.get(s))

            // Merge both visible sets
            array<int> visible = array.new<int>()
            if bullVisible.size() > 0
                for s = 0 to bullVisible.size() - 1
                    visible.push(bullVisible.get(s))
            if bearVisible.size() > 0
                for s = 0 to bearVisible.size() - 1
                    visible.push(bearVisible.get(s))

            // Draw visible, hide others
            for i = 0 to all_obs.size() - 1
                OBData ob = all_obs.get(i)
                if isInVisibleSet(visible, i)
                    color clr = i_col_ob_bull
                    if ob.state == "breaker"
                        // Breaker: bull OB → resistance (purple), bear OB → support (cyan)
                        clr := ob.direction == 1 ? i_col_breaker_resist : i_col_breaker_support
                    else if ob.state == "tested"
                        clr := i_col_ob_mitigated
                    else
                        clr := ob.direction == 1 ? i_col_ob_bull : i_col_ob_bear
                    drawSingleOB(ob, clr)
                else
                    clearOBDrawing(ob)
    true

// Draw the N closest FVGs to current price, per direction (bull/bear independently).
drawProximityFVGs() =>
    if all_fvgs.size() > 0
        if not i_show_fvg
            for i = 0 to all_fvgs.size() - 1
                clearFVGDrawing(all_fvgs.get(i))
        else
            array<int> bullIdx = array.new<int>()
            array<float> bullDist = array.new<float>()
            array<int> bearIdx = array.new<int>()
            array<float> bearDist = array.new<float>()
            for i = 0 to all_fvgs.size() - 1
                FVGData fvg = all_fvgs.get(i)
                bool eligible = true
                if fvg.broken
                    eligible := false
                if eligible and fvg.filled and not i_show_filled_fvg
                    eligible := false
                if eligible and fvg.direction == 1 and not i_show_bull_fvg
                    eligible := false
                if eligible and fvg.direction == -1 and not i_show_bear_fvg
                    eligible := false
                if not eligible
                    clearFVGDrawing(fvg)
                else
                    float mid = (fvg.top + fvg.bottom) / 2.0
                    float dist = math.abs(close - mid)
                    if fvg.direction == 1
                        bullIdx.push(i)
                        bullDist.push(dist)
                    else
                        bearIdx.push(i)
                        bearDist.push(dist)

            array<int> bullVisible = selectNClosest(bullIdx, bullDist, i_max_visible_fvg)
            array<int> bearVisible = selectNClosest(bearIdx, bearDist, i_max_visible_fvg)

            // Merge both visible sets
            array<int> visible = array.new<int>()
            if bullVisible.size() > 0
                for s = 0 to bullVisible.size() - 1
                    visible.push(bullVisible.get(s))
            if bearVisible.size() > 0
                for s = 0 to bearVisible.size() - 1
                    visible.push(bearVisible.get(s))

            for i = 0 to all_fvgs.size() - 1
                FVGData fvg = all_fvgs.get(i)
                if isInVisibleSet(visible, i)
                    color clr = fvg.filled ? i_col_fvg_filled : (fvg.direction == 1 ? i_col_fvg_bull : i_col_fvg_bear)
                    drawSingleFVG(fvg, clr)
                else
                    clearFVGDrawing(fvg)
    true

// ═══════════════════════════════════════════════════════════════════
// ═══ FIRE BOS                                                   ═══
// ═══════════════════════════════════════════════════════════════════
// Called when price breaks above ref_high (bullish BOS) or below
// ref_low (bearish BOS). This confirms the trend is continuing.
//
// What happens when BOS fires:
//   1. Draw a BOS line at the broken level
//   2. Find the HL/LH using BAR-BASED search (scans every bar's
//      actual low/high, not just swing points — more accurate)
//   3. Update the Strong Low/High to the HL/LH price
//   4. If the HL/LH bar has a swing, relabel it as Major
//   4. If the HL/LH bar is NOT a swing, create a standalone label
//   6. Update Premium/Discount zones and OTE
//   7. Set alert flag

fireBullishBOS(int breakBar) =>
    drawBOSLine(st.ref_high_bar, st.ref_high, breakBar, true)
    st.pending_bull_bos := true
    st.pending_bull_bos_bar := breakBar

    // Find HL: bar with lowest low in BOS range (not just swings)
    [hlBar, hlPrice] = findLowestBarLowBetween(st.ref_high_bar, breakBar)
    if hlBar >= 0 and not na(hlPrice)
        st.strong_low := hlPrice
        st.strong_low_bar := hlBar
        int hlSwIdx = findSwingAtBar(hlBar, SWING_LOW)
        st.strong_low_idx := hlSwIdx
        if hlSwIdx >= 0
            SwingPoint hlSw = swings.get(hlSwIdx)
            if hlSw.cls != CLS_MAJOR
                relabelSwing(hlSw, CLS_MAJOR, 0)
        else
            createSwingLabel(hlBar, hlPrice, SWING_LOW, CLS_MAJOR, 0)
        drawStrongLevel(true, st.strong_low_bar, st.strong_low)

    updateZones()
    updateOTE(true)
    // Bullish BOS OB: HL candle is the bullish OB (hlBar found above)
    int hlOff = hlBar >= 0 ? bar_index - hlBar : -1
    float hlTop = hlOff >= 0 ? high[hlOff] : na
    detectBOSLinkedOB(true, breakBar, 1, hlBar, hlTop, hlPrice, st.ref_high)
    st.alert_bull_bos := true

fireBearishBOS(int breakBar) =>
    drawBOSLine(st.ref_low_bar, st.ref_low, breakBar, false)
    st.pending_bear_bos := true
    st.pending_bear_bos_bar := breakBar

    // Find LH: bar with highest high in BOS range (not just swings)
    [lhBar, lhPrice] = findHighestBarHighBetween(st.ref_low_bar, breakBar)
    if lhBar >= 0 and not na(lhPrice)
        st.strong_high := lhPrice
        st.strong_high_bar := lhBar
        int lhSwIdx = findSwingAtBar(lhBar, SWING_HIGH)
        st.strong_high_idx := lhSwIdx
        if lhSwIdx >= 0
            SwingPoint lhSw = swings.get(lhSwIdx)
            if lhSw.cls != CLS_MAJOR
                relabelSwing(lhSw, CLS_MAJOR, 0)
        else
            createSwingLabel(lhBar, lhPrice, SWING_HIGH, CLS_MAJOR, 0)
        drawStrongLevel(false, st.strong_high_bar, st.strong_high)

    updateZones()
    updateOTE(false)
    // Bearish BOS OB: LH candle is the bearish OB (lhBar found above)
    int lhOff = lhBar >= 0 ? bar_index - lhBar : -1
    float lhBottom = lhOff >= 0 ? low[lhOff] : na
    detectBOSLinkedOB(false, breakBar, 1, lhBar, lhPrice, lhBottom, st.ref_low)
    st.alert_bear_bos := true

// ═══════════════════════════════════════════════════════════════════
// ═══ CHOCH PROCESSING                                           ═══
// ═══════════════════════════════════════════════════════════════════
// CHOCH (Change of Character) = the first sign of a trend reversal.
//
// processBearishCHOCH: price broke below the Strong Low in a bull
// trend → trend is now BEARISH. What happens:
//   1. Draw CHOCH line at the Strong Low level
//   2. Flip trend to bearish
//   3. The old ref_high (last HH) becomes the new Strong High
//      (this is now the CHOCH level for the bearish trend)
//   4. Find the first reference low for the new bearish trend
//   5. Re-evaluate: if a BOS was pending (HH hadn't confirmed yet),
//      find the actual HH and correct the HL using bar-based search
//   6. Clear all bullish state (Strong Low, ref_high, pending BOS)
//   7. Set choch_ref_pending = true (waiting for first swing in new trend)
//
// processBullishCHOCH: mirror logic for breaking above Strong High.

processBearishCHOCH(int breakBar) =>
    drawCHOCHLine(st.strong_low_bar, st.strong_low, breakBar, false)

    st.trend := TREND_BEARISH

    // Strong high = structural HH from bullish trend (ref_high)
    if not na(st.ref_high)
        st.strong_high := st.ref_high
        st.strong_high_bar := st.ref_high_bar
        st.strong_high_idx := -1
        for k = swings.size() - 1 to 0
            SwingPoint sw = swings.get(k)
            if sw.swing_type == SWING_HIGH and sw.bar_idx == st.ref_high_bar
                st.strong_high_idx := k
                sw.cls := CLS_MAJOR
                break
        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
    else
        int newShIdx = findLastSwingHighBefore(breakBar)
        if newShIdx >= 0
            SwingPoint sw = swings.get(newShIdx)
            sw.cls := CLS_MAJOR
            st.strong_high := sw.price
            st.strong_high_bar := sw.bar_idx
            st.strong_high_idx := newShIdx
            drawStrongLevel(false, st.strong_high_bar, st.strong_high)

    int newSlIdx = findLastSwingLowBefore(breakBar + 1)
    if newSlIdx >= 0
        SwingPoint sw = swings.get(newSlIdx)
        st.ref_low := sw.price
        st.ref_low_bar := sw.bar_idx
        if sw.cls != CLS_MAJOR
            relabelSwing(sw, CLS_MAJOR, 0)

    // Re-evaluation (MQL5 lines 1226-1259): if a bullish BOS was pending
    // (HH not yet confirmed due to swing_length delay), find the actual HH
    // and correct HL using the full range before clearing the pending state.
    if st.pending_bull_bos and st.ref_high_bar >= 0
        // Find actual HH: highest swing high between old ref_high and CHOCH break
        int actualHh = findHighestSwingHighBetween(st.ref_high_bar, breakBar + 1)
        int hhBar = actualHh >= 0 ? swings.get(actualHh).bar_idx : breakBar

        // Re-evaluate HL: bar with lowest low between old ref_high and actual HH
        [betterHlBar, betterHlPrice] = findLowestBarLowBetween(st.ref_high_bar, hhBar + 1)
        if betterHlBar >= 0 and not na(betterHlPrice) and (na(st.strong_low) or betterHlPrice < st.strong_low)
            st.strong_low := betterHlPrice
            st.strong_low_bar := betterHlBar
            int betterHlSwIdx = findSwingAtBar(betterHlBar, SWING_LOW)
            st.strong_low_idx := betterHlSwIdx
            if betterHlSwIdx >= 0
                SwingPoint hlSw = swings.get(betterHlSwIdx)
                if hlSw.cls != CLS_MAJOR
                    relabelSwing(hlSw, CLS_MAJOR, TREND_BULLISH)
            else
                createSwingLabel(betterHlBar, betterHlPrice, SWING_LOW, CLS_MAJOR, TREND_BULLISH)

        // Label actual HH if not already major (use old BULLISH context → "HH")
        // Also update strong_high if the actual HH is higher than what was set
        // from ref_high — this ensures Premium/Discount zones use the true HH.
        if actualHh >= 0
            SwingPoint hhSw = swings.get(actualHh)
            if hhSw.cls != CLS_MAJOR
                relabelSwing(hhSw, CLS_MAJOR, TREND_BULLISH)
            if hhSw.price > st.strong_high or na(st.strong_high)
                st.strong_high := hhSw.price
                st.strong_high_bar := hhSw.bar_idx
                st.strong_high_idx := actualHh
                drawStrongLevel(false, st.strong_high_bar, st.strong_high)

    // Bearish CHOCH OB: LH (highest bar between strong_low and break) is the bearish OB
    // Must find BEFORE clearing bullish state (strong_low_bar gets reset below)
    [chochLhBar, chochLhHigh] = findHighestBarHighBetween(st.strong_low_bar, breakBar)
    int chochLhOff = chochLhBar >= 0 ? bar_index - chochLhBar : -1
    float chochLhLow = chochLhOff >= 0 ? low[chochLhOff] : na
    // Save BOS level before clearing state (strong_low is the level that was broken)
    float chochBosLevel = st.strong_low

    // Clear bullish state
    st.strong_low := na
    st.strong_low_bar := -1
    st.strong_low_idx := -1
    st.ref_high := na
    st.ref_high_bar := -1
    if not na(st.strong_low_line)
        line.delete(st.strong_low_line)
        st.strong_low_line := na
    st.pending_bull_bos := false
    st.pending_bull_bos_bar := -1
    st.choch_ref_pending := true
    st.choch_break_bar := breakBar

    clearOTE()
    updateZones()
    detectBOSLinkedOB(false, breakBar, 2, chochLhBar, chochLhHigh, chochLhLow, chochBosLevel)
    st.alert_bear_choch := true

processBullishCHOCH(int breakBar) =>
    // Draw CHOCH line at strong_high
    drawCHOCHLine(st.strong_high_bar, st.strong_high, breakBar, true)

    st.trend := TREND_BULLISH

    // Strong low = structural LL from bearish trend (ref_low)
    if not na(st.ref_low)
        st.strong_low := st.ref_low
        st.strong_low_bar := st.ref_low_bar
        st.strong_low_idx := -1
        for k = swings.size() - 1 to 0
            SwingPoint sw = swings.get(k)
            if sw.swing_type == SWING_LOW and sw.bar_idx == st.ref_low_bar
                st.strong_low_idx := k
                sw.cls := CLS_MAJOR
                break
        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
    else
        int newSlIdx = findLastSwingLowBefore(breakBar)
        if newSlIdx >= 0
            SwingPoint sw = swings.get(newSlIdx)
            sw.cls := CLS_MAJOR
            st.strong_low := sw.price
            st.strong_low_bar := sw.bar_idx
            st.strong_low_idx := newSlIdx
            drawStrongLevel(true, st.strong_low_bar, st.strong_low)

    int newShIdx = findLastSwingHighBefore(breakBar + 1)
    if newShIdx >= 0
        SwingPoint sw = swings.get(newShIdx)
        st.ref_high := sw.price
        st.ref_high_bar := sw.bar_idx
        if sw.cls != CLS_MAJOR
            relabelSwing(sw, CLS_MAJOR, 0)

    // Re-evaluation (MQL5 lines 1343-1378): if a bearish BOS was pending
    // (LL not yet confirmed due to swing_length delay), find the actual LL
    // and correct LH using the full range before clearing the pending state.
    if st.pending_bear_bos and st.ref_low_bar >= 0
        // Find actual LL: lowest swing low between old ref_low and CHOCH break
        int actualLl = findLowestSwingLowBetween(st.ref_low_bar, breakBar + 1)
        int llBar = actualLl >= 0 ? swings.get(actualLl).bar_idx : breakBar

        // Re-evaluate LH: bar with highest high between old ref_low and actual LL
        [betterLhBar, betterLhPrice] = findHighestBarHighBetween(st.ref_low_bar, llBar + 1)
        if betterLhBar >= 0 and not na(betterLhPrice) and (na(st.strong_high) or betterLhPrice > st.strong_high)
            st.strong_high := betterLhPrice
            st.strong_high_bar := betterLhBar
            int betterLhSwIdx = findSwingAtBar(betterLhBar, SWING_HIGH)
            st.strong_high_idx := betterLhSwIdx
            if betterLhSwIdx >= 0
                SwingPoint lhSw = swings.get(betterLhSwIdx)
                if lhSw.cls != CLS_MAJOR
                    relabelSwing(lhSw, CLS_MAJOR, TREND_BEARISH)
            else
                createSwingLabel(betterLhBar, betterLhPrice, SWING_HIGH, CLS_MAJOR, TREND_BEARISH)

        // Label actual LL if not already major (use old BEARISH context → "LL")
        // Also update strong_low if the actual LL is lower than what was set
        // from ref_low — this ensures Premium/Discount zones use the true LL.
        if actualLl >= 0
            SwingPoint llSw = swings.get(actualLl)
            if llSw.cls != CLS_MAJOR
                relabelSwing(llSw, CLS_MAJOR, TREND_BEARISH)
            if llSw.price < st.strong_low or na(st.strong_low)
                st.strong_low := llSw.price
                st.strong_low_bar := llSw.bar_idx
                st.strong_low_idx := actualLl
                drawStrongLevel(true, st.strong_low_bar, st.strong_low)

    // Bullish CHOCH OB: HL (lowest bar between strong_high and break) is the bullish OB
    // Must find BEFORE clearing bearish state (strong_high_bar gets reset below)
    [chochHlBar, chochHlLow] = findLowestBarLowBetween(st.strong_high_bar, breakBar)
    int chochHlOff = chochHlBar >= 0 ? bar_index - chochHlBar : -1
    float chochHlHigh = chochHlOff >= 0 ? high[chochHlOff] : na
    // Save BOS level before clearing state (strong_high is the level that was broken)
    float chochBosLevel = st.strong_high

    // Clear bearish state
    st.strong_high := na
    st.strong_high_bar := -1
    st.strong_high_idx := -1
    st.ref_low := na
    st.ref_low_bar := -1
    if not na(st.strong_high_line)
        line.delete(st.strong_high_line)
        st.strong_high_line := na
    st.pending_bear_bos := false
    st.pending_bear_bos_bar := -1
    st.choch_ref_pending := true
    st.choch_break_bar := breakBar

    clearOTE()
    updateZones()
    detectBOSLinkedOB(true, breakBar, 2, chochHlBar, chochHlHigh, chochHlLow, chochBosLevel)
    st.alert_bull_choch := true

// ═══════════════════════════════════════════════════════════════════
// ═══ STATE MACHINE — SWING CLASSIFICATION                       ═══
// ═══════════════════════════════════════════════════════════════════
// This is the CORE LOGIC of the indicator. When a new swing is
// detected, this function decides what it means for the trend.
//
// THREE PHASES OF PROCESSING (in order):
//
// Phase A: CHOCH REFERENCE HANDLING (after a trend change)
//   After CHOCH, we're waiting for the first swing in the new trend
//   direction. That swing becomes the new reference level (ref_high
//   or ref_low) — the level that BOS needs to break for continuation.
//   - Also handles "Late Swings": swings from the OLD trend that
//     confirm late due to swing_length delay. If a late HH or LL
//     exceeds the strong level, it's the real extreme that CHOCH
//     should have used → we update the strong level accordingly.
//
// Phase B: NORMAL CLASSIFICATION (ongoing trend)
//   In a BULLISH trend:
//     - Swing High above ref_high → HH (Higher High) = trend continues
//       → fire BOS, update ref_high, promote the HL between them
//     - Swing High below ref_high → iH (internal high, not significant)
//     - Swing Low → iL (internal low, until BOS promotes it to HL)
//
//   In a BEARISH trend:
//     - Swing Low below ref_low → LL (Lower Low) = trend continues
//       → fire BOS, update ref_low, promote the LH between them
//     - Swing Low above ref_low → iL (internal low, not significant)
//     - Swing High → iH (internal high, until BOS promotes it to LH)

processSwingInStateMachine(int swingIdx, int currentBar) =>
    if st.initialized and swingIdx >= 0 and swingIdx < swings.size()
        SwingPoint sw = swings.get(swingIdx)
        int swType = sw.swing_type
        int swBar = sw.bar_idx

        // ── CHOCH reference handling (matching MQL5) ──
        // After CHOCH, the first swing in the new trend direction sets the reference
        // WITHOUT firing BOS. Clear choch_break_bar here (MQL5 pattern).
        bool chochHandled = false
        if st.choch_ref_pending
            if st.trend == TREND_BULLISH and swType == SWING_HIGH
                st.ref_high := sw.price
                st.ref_high_bar := sw.bar_idx
                sw.cls := CLS_INTERNAL
                st.choch_ref_pending := false
                st.choch_break_bar := -1
                st.pending_bull_bos := false
                st.pending_bull_bos_bar := -1
                updateZones()
                chochHandled := true
            else if st.trend == TREND_BEARISH and swType == SWING_LOW
                st.ref_low := sw.price
                st.ref_low_bar := sw.bar_idx
                sw.cls := CLS_INTERNAL
                st.choch_ref_pending := false
                st.choch_break_bar := -1
                st.pending_bear_bos := false
                st.pending_bear_bos_bar := -1
                updateZones()
                chochHandled := true

            // ── LATE SWING HANDLER (algorithm fix, not in MQL5) ──
            // WHY THIS EXISTS: Swings take swing_length bars to confirm. If CHOCH
            // fires on bar 100 but the real HH was at bar 98, it won't be detected
            // until bar 98 + swing_length. By that time the trend has already flipped,
            // so the HH would be misclassified as an internal swing in the new trend.
            //
            // FIX: If a swing from the old trend confirms late AND its price exceeds
            // the current strong level, we recognize it as the real HH/LL from the
            // old trend, update the strong level, and label it correctly.
            else if st.trend == TREND_BEARISH and swType == SWING_HIGH and not na(st.strong_high) and sw.price > st.strong_high
                // Late HH from old bullish trend — this is higher than the current
                // strong_high, so it's the real HH that CHOCH should reference
                sw.cls := CLS_MAJOR
                int prevStrongHighBar = st.strong_high_bar
                st.strong_high := sw.price
                st.strong_high_bar := sw.bar_idx
                st.strong_high_idx := swingIdx
                drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                // Label as HH (old bullish context — this swing was in the bull trend)
                relabelSwing(sw, CLS_MAJOR, TREND_BULLISH)
                // Find correct HL: bar with lowest low between old strong_high and this new HH
                [lateHlBar, lateHlPrice] = findLowestBarLowBetween(prevStrongHighBar, sw.bar_idx)
                if lateHlBar >= 0 and not na(lateHlPrice)
                    int lateHlSwIdx = findSwingAtBar(lateHlBar, SWING_LOW)
                    if lateHlSwIdx >= 0
                        SwingPoint hlSw = swings.get(lateHlSwIdx)
                        if hlSw.cls != CLS_MAJOR
                            relabelSwing(hlSw, CLS_MAJOR, TREND_BULLISH)
                    else
                        createSwingLabel(lateHlBar, lateHlPrice, SWING_LOW, CLS_MAJOR, TREND_BULLISH)
                chochHandled := true
                // DON'T clear choch_ref_pending — still need first swing in new trend

            else if st.trend == TREND_BULLISH and swType == SWING_LOW and not na(st.strong_low) and sw.price < st.strong_low
                // Late LL from old bearish trend — lower than current strong_low
                sw.cls := CLS_MAJOR
                int prevStrongLowBar = st.strong_low_bar
                st.strong_low := sw.price
                st.strong_low_bar := sw.bar_idx
                st.strong_low_idx := swingIdx
                drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                // Label as LL (old bearish context — this swing was in the bear trend)
                relabelSwing(sw, CLS_MAJOR, TREND_BEARISH)
                // Find correct LH: bar with highest high between old strong_low and this new LL
                [lateLhBar, lateLhPrice] = findHighestBarHighBetween(prevStrongLowBar, sw.bar_idx)
                if lateLhBar >= 0 and not na(lateLhPrice)
                    int lateLhSwIdx = findSwingAtBar(lateLhBar, SWING_HIGH)
                    if lateLhSwIdx >= 0
                        SwingPoint lhSw = swings.get(lateLhSwIdx)
                        if lhSw.cls != CLS_MAJOR
                            relabelSwing(lhSw, CLS_MAJOR, TREND_BEARISH)
                    else
                        createSwingLabel(lateLhBar, lateLhPrice, SWING_HIGH, CLS_MAJOR, TREND_BEARISH)
                chochHandled := true
                // DON'T clear choch_ref_pending — still need first swing in new trend

        // ── Normal classification (matching MQL5 ProcessSwingInStateMachine) ──
        if not chochHandled
            if st.trend == TREND_BULLISH
                if swType == SWING_HIGH
                    if not na(st.ref_high) and sw.price > st.ref_high
                        // HH confirmed
                        // If BOS line wasn't drawn yet, find actual break bar and draw
                        if not st.pending_bull_bos
                            int brk = -1
                            for j = st.ref_high_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakAbove(st.ref_high, close[offset], high[offset])
                                    brk := j
                                    break
                            if brk < 0
                                brk := swBar
                            fireBullishBOS(brk)

                        sw.cls := CLS_MAJOR

                        // Promote HL: bar with lowest low between old ref_high and this HH
                        [hlBar, hlPrice] = findLowestBarLowBetween(st.ref_high_bar, swBar)
                        if hlBar >= 0 and not na(hlPrice)
                            st.strong_low := hlPrice
                            st.strong_low_bar := hlBar
                            int hlSwIdx = findSwingAtBar(hlBar, SWING_LOW)
                            st.strong_low_idx := hlSwIdx
                            if hlSwIdx >= 0
                                SwingPoint hlSw = swings.get(hlSwIdx)
                                if hlSw.cls != CLS_MAJOR
                                    relabelSwing(hlSw, CLS_MAJOR, 0)
                            else
                                createSwingLabel(hlBar, hlPrice, SWING_LOW, CLS_MAJOR, 0)
                            drawStrongLevel(true, st.strong_low_bar, st.strong_low)

                        // Update ref_high to this HH
                        st.ref_high := sw.price
                        st.ref_high_bar := swBar
                        st.pending_bull_bos := false
                        st.pending_bull_bos_bar := -1

                        // Recalculate zones with the NEW ref_high (the actual HH price)
                        // fireBullishBOS() already called updateZones() but used the OLD
                        // ref_high (the broken level). Now ref_high is the actual HH,
                        // so zones need to be redrawn with the correct range.
                        updateZones()
                        updateOTE(true)

                        // Retroactive: check if bars after new ref already broke above it
                        if st.ref_high_bar + 1 <= currentBar
                            for j = st.ref_high_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakAbove(st.ref_high, close[offset], high[offset])
                                    fireBullishBOS(j)
                                    break
                        // (void terminator for type compatibility)
                        sw.cls := CLS_MAJOR
                    else
                        sw.cls := CLS_INTERNAL
                else
                    sw.cls := CLS_INTERNAL
            else if st.trend == TREND_BEARISH
                if swType == SWING_LOW
                    if not na(st.ref_low) and sw.price < st.ref_low
                        // LL confirmed
                        // If BOS line wasn't drawn yet, find actual break bar and draw
                        if not st.pending_bear_bos
                            int brk = -1
                            for j = st.ref_low_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakBelow(st.ref_low, close[offset], low[offset])
                                    brk := j
                                    break
                            if brk < 0
                                brk := swBar
                            fireBearishBOS(brk)

                        sw.cls := CLS_MAJOR

                        // Promote LH: bar with highest high between old ref_low and this LL
                        [lhBar, lhPrice] = findHighestBarHighBetween(st.ref_low_bar, swBar)
                        if lhBar >= 0 and not na(lhPrice)
                            st.strong_high := lhPrice
                            st.strong_high_bar := lhBar
                            int lhSwIdx = findSwingAtBar(lhBar, SWING_HIGH)
                            st.strong_high_idx := lhSwIdx
                            if lhSwIdx >= 0
                                SwingPoint lhSw = swings.get(lhSwIdx)
                                if lhSw.cls != CLS_MAJOR
                                    relabelSwing(lhSw, CLS_MAJOR, 0)
                            else
                                createSwingLabel(lhBar, lhPrice, SWING_HIGH, CLS_MAJOR, 0)
                            drawStrongLevel(false, st.strong_high_bar, st.strong_high)

                        // Update ref_low to this LL
                        st.ref_low := sw.price
                        st.ref_low_bar := swBar
                        st.pending_bear_bos := false
                        st.pending_bear_bos_bar := -1

                        // Recalculate zones with the NEW ref_low (the actual LL price)
                        // fireBearishBOS() already called updateZones() but used the OLD
                        // ref_low (the broken level). Now ref_low is the actual LL,
                        // so zones need to be redrawn with the correct range.
                        updateZones()
                        updateOTE(false)

                        // Retroactive: check if bars after new ref already broke below it
                        if st.ref_low_bar + 1 <= currentBar
                            for j = st.ref_low_bar + 1 to currentBar
                                int offset = bar_index - j
                                if offset >= 0 and checkBreakBelow(st.ref_low, close[offset], low[offset])
                                    fireBearishBOS(j)
                                    break
                        // (void terminator for type compatibility)
                        sw.cls := CLS_MAJOR
                    else
                        sw.cls := CLS_INTERNAL
                else
                    sw.cls := CLS_INTERNAL
            else
                sw.cls := CLS_INTERNAL

// ═══════════════════════════════════════════════════════════════════
// ═══ LIQUIDITY DETECTION                                        ═══
// ═══════════════════════════════════════════════════════════════════
// EQUAL HIGHS/LOWS: When 2+ swing highs (or lows) form at nearly
// the same price, it creates a "liquidity pool" — a cluster of
// stop-loss orders from traders who entered at those levels.
// Smart money often drives price to these pools to grab the
// liquidity before reversing.
//
// DETECTION: We compare each swing's price to every other swing of
// the same type. If they're within a threshold (ATR-based, controlled
// by "EQ Threshold" setting), they count as "equal". When the
// required number of touches is met, we draw a dashed line.
//
// SWEEPS: When price briefly spikes through an EQH/EQL level with
// the wick but closes back on the other side, it's a "liquidity
// sweep" — smart money grabbed the stops and reversed. An arrow
// marker is placed at the sweep bar.

scanLiquidityPools(bool doScan) =>
    float atrVal = ta.atr(14)
    if i_show_liq and not na(atrVal) and doScan
        float eqThreshold = atrVal * i_eq_atr_mult

        // Delete old pool objects
        if liq_pools.size() > 0
            for i = 0 to liq_pools.size() - 1
                LiquidityPool pool = liq_pools.get(i)
                if not na(pool.pool_line)
                    line.delete(pool.pool_line)
                if not na(pool.pool_label)
                    label.delete(pool.pool_label)
            liq_pools.clear()

        int count = swings.size()

        // Scan swing highs for BSL (Equal Highs)
        for i = count - 1 to 0
            SwingPoint swI = swings.get(i)
            if swI.swing_type == SWING_HIGH
                bool alreadyInPool = false
                if liq_pools.size() > 0
                    for p = 0 to liq_pools.size() - 1
                        LiquidityPool existingPool = liq_pools.get(p)
                        if existingPool.pool_type == SWING_HIGH and math.abs(swI.price - existingPool.level) <= eqThreshold
                            alreadyInPool := true
                            break
                if not alreadyInPool
                    int touchCount = 0
                    float priceSum = 0.0
                    int firstBar = swI.bar_idx
                    for j = 0 to count - 1
                        SwingPoint swJ = swings.get(j)
                        if swJ.swing_type == SWING_HIGH and math.abs(swI.price - swJ.price) <= eqThreshold
                            touchCount += 1
                            priceSum += swJ.price
                            if swJ.bar_idx < firstBar
                                firstBar := swJ.bar_idx
                    if touchCount >= i_eq_min_touches
                        float level = priceSum / touchCount
                        // Clamp draw start to stay within Pine's xloc.bar_index limit.
                        // The hard ceiling is the indicator's max_bars_back; the user-
                        // configurable input lets you shorten further if needed.
                        int drawStart = math.max(firstBar, bar_index - i_liq_max_lookback)
                        line pLine = line.new(drawStart, level, bar_index, level, xloc.bar_index, extend.right, i_col_bsl, line.style_dashed, 1)
                        label pLabel = label.new(drawStart, level, "EQH", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_bsl, size.tiny, text.align_center)
                        addManagedLine(managed_liq_lines, pLine, i_max_liq_objects)
                        addManagedLabel(managed_liq_labels, pLabel, i_max_liq_objects)
                        liq_pools.push(LiquidityPool.new(SWING_HIGH, level, firstBar, false, -1, pLine, pLabel))

        // Scan swing lows for SSL (Equal Lows)
        for i = count - 1 to 0
            SwingPoint swI = swings.get(i)
            if swI.swing_type == SWING_LOW
                bool alreadyInPool = false
                if liq_pools.size() > 0
                    for p = 0 to liq_pools.size() - 1
                        LiquidityPool existingPool = liq_pools.get(p)
                        if existingPool.pool_type == SWING_LOW and math.abs(swI.price - existingPool.level) <= eqThreshold
                            alreadyInPool := true
                            break
                if not alreadyInPool
                    int touchCount = 0
                    float priceSum = 0.0
                    int firstBar = swI.bar_idx
                    for j = 0 to count - 1
                        SwingPoint swJ = swings.get(j)
                        if swJ.swing_type == SWING_LOW and math.abs(swI.price - swJ.price) <= eqThreshold
                            touchCount += 1
                            priceSum += swJ.price
                            if swJ.bar_idx < firstBar
                                firstBar := swJ.bar_idx
                    if touchCount >= i_eq_min_touches
                        float level = priceSum / touchCount
                        // Clamp draw start to stay within Pine's xloc.bar_index limit.
                        int drawStart = math.max(firstBar, bar_index - i_liq_max_lookback)
                        line pLine = line.new(drawStart, level, bar_index, level, xloc.bar_index, extend.right, i_col_ssl, line.style_dashed, 1)
                        label pLabel = label.new(drawStart, level, "EQL", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_ssl, size.tiny, text.align_center)
                        addManagedLine(managed_liq_lines, pLine, i_max_liq_objects)
                        addManagedLabel(managed_liq_labels, pLabel, i_max_liq_objects)
                        liq_pools.push(LiquidityPool.new(SWING_LOW, level, firstBar, false, -1, pLine, pLabel))

checkLiquiditySweeps() =>
    if i_show_sweeps and liq_pools.size() > 0
        for p = 0 to liq_pools.size() - 1
            LiquidityPool pool = liq_pools.get(p)
            if not pool.swept
                if pool.pool_type == SWING_HIGH
                    if high > pool.level and close < pool.level
                        pool.swept := true
                        pool.swept_bar := bar_index
                        label sweepLbl = label.new(bar_index, high + nz(ta.atr(14)) * 0.3, "v", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_bsl, size.small, text.align_center)
                        addManagedLabel(managed_sweep_labels, sweepLbl, i_max_sweep_labels)
                        st.alert_bsl_sweep := true
                else
                    if low < pool.level and close > pool.level
                        pool.swept := true
                        pool.swept_bar := bar_index
                        label sweepLbl = label.new(bar_index, low - nz(ta.atr(14)) * 0.3, "^", xloc.bar_index, yloc.price, color(na), label.style_none, i_col_ssl, size.small, text.align_center)
                        addManagedLabel(managed_sweep_labels, sweepLbl, i_max_sweep_labels)
                        st.alert_ssl_sweep := true

// ═══════════════════════════════════════════════════════════════════
// ═══ MAIN LOGIC — RUNS EVERY BAR                                ═══
// ═══════════════════════════════════════════════════════════════════
// This is the entry point that runs on every bar of the chart.
// The processing order matters — it matches the MQL5 version:
//
//   STEP 1: CHECK FOR BREAKS (every bar)
//     - Check if current bar's price breaks any structural level
//     - CHOCH fires first (trend change is highest priority)
//     - Then BOS fires (trend continuation)
//     - This runs on EVERY bar for immediate detection
//
//   STEP 2: DETECT & CLASSIFY SWINGS (swing_length bars ago)
//     - ta.pivothigh/ta.pivotlow detect swings confirmed swing_length
//       bars ago (e.g., if swing_length=5, today's swing was actually
//       at bar_index - 5, confirmed because 5 bars on each side are lower)
//     - New swings are classified by the state machine
//     - Classification uses the CURRENT state (which may have been
//       updated by Step 1 on this same bar)
//
//   STEP 3: SCAN LIQUIDITY (only when new swings found)
//     - Re-scan for Equal Highs/Lows clusters
//     - Check for sweep events on current bar
//
//   STEP 4: EXTEND ZONES (every bar)
//     - Stretch Premium/Discount boxes and Strong level lines to
//       the current bar so they always reach the right edge of chart
//
//   STEP 5: ALERTS (confirmed bars only)
//     - Fire alerts for any BOS/CHOCH/sweep events detected this bar

// Reset per-bar alert flags (each bar starts fresh — no carry-over)
st.alert_bull_bos := false
st.alert_bear_bos := false
st.alert_bull_choch := false
st.alert_bear_choch := false
st.alert_bsl_sweep := false
st.alert_ssl_sweep := false
st.alert_ob_bull := false
st.alert_ob_bear := false
st.alert_ob_mitigated := false
st.alert_fvg_bull := false
st.alert_fvg_bear := false
st.alert_fvg_filled := false

// ═══════════════════════════════════════════════════════════════════
// ═══ SWING DETECTION — KAO-SOURCED (replaces ta.pivothigh/pivotlow) ═══
// ═══════════════════════════════════════════════════════════════════
// Compute the Kernel AO Oscillator (KAO) for this bar:
//   • Fast kernel regression on close - Slow kernel regression on close
//   • Positive = bull leg, Negative = bear leg
// Within each KAO range we track the running highest HIGH (during +osc)
// or lowest LOW (during -osc). When KAO crosses zero, the just-ended
// range's extreme becomes a finalized swing — emitted as ph or pl.
//
// ph/pl mirror the original `ta.pivothigh/pivotlow` outputs so the
// downstream state machine code can be reused unchanged.
//
// swingBar is the actual past bar where the high/low truly occurred
// (not the zero-cross bar), so labels anchor at the real swing point.

float kFast = kernels.rationalQuadratic(close, KAO_FAST_LOOKBACK, KAO_FAST_WEIGHT, KAO_FAST_REGSTART)
if KAO_FAST_SMOOTH
    kFast := ta.sma(kFast, KAO_FAST_SMOOTHLEN)
float kSlow = kernels.rationalQuadratic(close, KAO_SLOW_LOOKBACK, KAO_SLOW_WEIGHT, KAO_SLOW_REGSTART)
if KAO_SLOW_SMOOTH
    kSlow := ta.sma(kSlow, KAO_SLOW_SMOOTHLEN)
float osc = kFast - kSlow

// Running extremes within current KAO range — persist across bars via var
var float kao_lowestVal  = na
var float kao_highestVal = na
var int   kao_lowestBar  = na
var int   kao_highestBar = na

// Visual leg-drawing state (same approach as the standalone KAO_Swings indicator)
var int   kao_negativeStart    = na
var int   kao_positiveStart    = na
var int   kao_uplineRange      = 0
var int   kao_dwnlineRange     = 0
var line  kao_upline           = na
var line  kao_dwnline          = na
var int   kao_uplinePrevHigh   = na
var int   kao_dwnlinePrevLow   = na

// Detect zero-crosses BEFORE updating any state — so we can finalize the previous range
bool kao_bullishCross = osc > 0  and not na(osc[1]) and osc[1] <= 0
bool kao_bearishCross = osc < 0  and not na(osc[1]) and osc[1] >= 0

// ── Initialization on the very first bar with non-na osc ──
if osc < 0 and na(osc[1])
    kao_negativeStart := bar_index
    kao_lowestVal     := low
    kao_lowestBar     := bar_index
if osc > 0 and na(osc[1])
    kao_positiveStart := bar_index
    kao_highestVal    := high
    kao_highestBar    := bar_index

// ── On zero-cross: emit the just-ended range's extreme as ph/pl, then reset ──
// (these locals replace the original ta.pivothigh/pivotlow outputs)
float ph = na
float pl = na
int   swingBar = -1

if kao_bullishCross
    // Bear leg just ended — its lowest low is now a confirmed swing low
    if not na(kao_lowestVal)
        pl       := kao_lowestVal
        swingBar := kao_lowestBar
    // Start new positive range
    kao_positiveStart := bar_index
    kao_highestVal    := high
    kao_highestBar    := bar_index
if kao_bearishCross
    // Bull leg just ended — its highest high is now a confirmed swing high
    if not na(kao_highestVal)
        ph       := kao_highestVal
        swingBar := kao_highestBar
    // Start new negative range
    kao_negativeStart := bar_index
    kao_lowestVal     := low
    kao_lowestBar     := bar_index

// ── Update running min/max within current range ──
if osc < 0 and not na(osc[1])
    if low <= kao_lowestVal or na(kao_lowestVal)
        kao_lowestVal := low
        kao_lowestBar := bar_index
if osc > 0 and not na(osc[1])
    if high >= kao_highestVal or na(kao_highestVal)
        kao_highestVal := high
        kao_highestBar := bar_index

// ── Optional visual: draw the KAO swing legs on the price chart ──
if i_show_kao_legs
    // Bull leg active: line from prior bear's low up to current bull's high
    if not na(kao_negativeStart) and not na(kao_positiveStart) and kao_negativeStart < kao_positiveStart
        if kao_negativeStart != kao_uplineRange
            kao_upline := line.new(kao_lowestBar, kao_lowestVal, kao_highestBar, kao_highestVal,
                                   color=i_kao_leg_color, width=i_kao_leg_width)
            kao_uplineRange    := kao_negativeStart
            kao_uplinePrevHigh := kao_highestBar
        else if kao_highestBar != kao_uplinePrevHigh
            kao_upline.set_x2(kao_highestBar)
            kao_upline.set_y2(kao_highestVal)
            kao_uplinePrevHigh := kao_highestBar
    // Bear leg active: line from prior bull's high down to current bear's low
    if not na(kao_negativeStart) and not na(kao_positiveStart) and kao_positiveStart < kao_negativeStart
        if kao_positiveStart != kao_dwnlineRange
            kao_dwnline := line.new(kao_highestBar, kao_highestVal, kao_lowestBar, kao_lowestVal,
                                    color=i_kao_leg_color, width=i_kao_leg_width)
            kao_dwnlineRange   := kao_positiveStart
            kao_dwnlinePrevLow := kao_lowestBar
        else if kao_lowestBar != kao_dwnlinePrevLow
            kao_dwnline.set_x2(kao_lowestBar)
            kao_dwnline.set_y2(kao_lowestVal)
            kao_dwnlinePrevLow := kao_lowestBar

// ══════════════════════════════════════════════════════════════════
// KAO DIVERGENCE — swing-pair tracking + Logic 2 detection functions
// ══════════════════════════════════════════════════════════════════
// Logic 2 needs the bar indices of the two most recent KAO swing highs
// and the two most recent KAO swing lows. The original Kernel AO
// Divergence indicator tracked these inside its drawSwings() function
// (lines 412-424 of Kernel AO Divergence.txt). We replicate that logic
// here in global scope, sourcing the running extremes from our existing
// kao_lowestBar / kao_highestBar (which are updated bar-by-bar above).

var int divCurrLow     = 0
var int divCurrHigh    = 0
var int divPrevLow     = 0
var int divPrevLowHigh = 0
var int divPrevHigh    = 0
var int divPrevHighLow = 0

// History references hoisted to unconditional global scope — accessing
// kao_lowestBar[1] / kao_highestBar[1] inside a conditional block was
// fragmenting the history buffer and returning na on early bars, which
// prevented divPrevLow / divPrevHigh from ever being populated.
int klbPrev = kao_lowestBar[1]
int khbPrev = kao_highestBar[1]

if not na(kao_lowestBar) and not na(kao_highestBar)
    divCurrLow  := kao_lowestBar
    divCurrHigh := kao_highestBar
    // Update previous low when we are on a down-leg (lowestBar confirmed
    // after highestBar) and the candidate is genuinely new.
    if kao_lowestBar >= kao_highestBar and not na(klbPrev) and divPrevLow != klbPrev and divPrevLowHigh != kao_highestBar
        divPrevLow     := klbPrev
        divPrevLowHigh := kao_highestBar
    // Mirror for highs on the up-leg.
    if kao_highestBar >= kao_lowestBar and not na(khbPrev) and divPrevHigh != khbPrev and divPrevHighLow != kao_lowestBar
        divPrevHigh     := khbPrev
        divPrevHighLow  := kao_lowestBar

// Range-scan helpers (inlined replacements for aoDiv.findLowestAo / findHighestAo).
// Scan the global `osc` series between bar index `startBar` and bar index
// `bar_index - endOffset`, in EITHER direction, returning the min / max
// non-na value (or na if no valid samples in range). The two endpoints can
// be passed in either order — e.g. findLowestOsc(currHighBar, prevLow)
// has startBar NEWER than endBar (the down-leg scan goes backwards in time),
// while findLowestOsc(rangeStart, 0) has startBar OLDER. The original
// aoDiv library accepted both orderings; matching that contract here.
findLowestOsc(int startBar, int endOffset) =>
    float result = na
    int endBar = bar_index - endOffset
    int lo = math.min(startBar, endBar)
    int hi = math.max(startBar, endBar)
    if hi >= lo
        for j = lo to hi
            int offset = bar_index - j
            if offset >= 0
                float v = osc[offset]
                if not na(v) and (na(result) or v < result)
                    result := v
    result

findHighestOsc(int startBar, int endOffset) =>
    float result = na
    int endBar = bar_index - endOffset
    int lo = math.min(startBar, endBar)
    int hi = math.max(startBar, endBar)
    if hi >= lo
        for j = lo to hi
            int offset = bar_index - j
            if offset >= 0
                float v = osc[offset]
                if not na(v) and (na(result) or v > result)
                    result := v
    result

// Logic 2: regular OR hidden bullish divergence on KAO oscillator.
// Adapted from isKernelBullDiv in Kernel AO Divergence.txt (v5 → v6).
// `regColor` is used when isHidden=false, `hidColor` when isHidden=true.
// var state (rangeStart, regLine/hidLine) is shared across calls — safe
// because reg-path writes only to regLine and hid-path only to hidLine.
isKernelBullDiv(int currHighBar, int prevHighBar, int currLowBar, int prevLowBar, color regColor, color hidColor, bool isHidden) =>
    int prevHigh = bar_index - prevHighBar
    int currHigh = bar_index - currHighBar
    int prevLow  = bar_index - prevLowBar
    int currLow  = bar_index - currLowBar

    bool isDivergence = false

    // Track the start of the current negative AO range (the down-leg we are inside)
    var int rangeStart = bar_index
    if not na(osc[1]) and osc[1] > 0 and osc < 0
        rangeStart := bar_index

    var line hidLine = na
    var int  hidLineStart = 0
    var line regLine = na
    var int  regLineStart = 0

    // Lowest osc value in the AO range between the highs/lows of interest
    float lowest1 = findLowestOsc(currHighBar, prevLow)
    float lowest2 = findLowestOsc(rangeStart,  0)

    // Regular bullish divergence: price lower-low + osc higher-low (lowest1 < lowest2)
    if low[currLow] < low[prevLow] and currLowBar >= currHighBar and not isHidden
        if lowest1 < lowest2
            isDivergence := true
            if prevLowBar == regLineStart
                line.delete(regLine)
            regLine := line.new(time[prevLow], low[prevLow], time[currLow], low[currLow], color = regColor, xloc = xloc.bar_time, width = 1)
            regLineStart := prevLowBar

    // Hidden bullish divergence: price higher-low + osc lower-low (lowest1 > lowest2)
    if low[currLow] > low[prevLow] and currLowBar >= currHighBar and isHidden
        if lowest1 > lowest2
            isDivergence := true
            if prevLowBar == hidLineStart
                line.delete(hidLine)
            hidLine := line.new(time[prevLow], low[prevLow], time[currLow], low[currLow], color = hidColor, xloc = xloc.bar_time, width = 1)
            hidLineStart := prevLowBar

    isDivergence

// Logic 2: regular OR hidden bearish divergence on KAO oscillator.
// Adapted from isKernelBearDiv in Kernel AO Divergence.txt (v5 → v6).
isKernelBearDiv(int currHighBar, int prevHighBar, int currLowBar, int prevLowBar, color regColor, color hidColor, bool isHidden) =>
    int prevHigh = bar_index - prevHighBar
    int currHigh = bar_index - currHighBar
    int prevLow  = bar_index - prevLowBar
    int currLow  = bar_index - currLowBar

    bool isDivergence = false

    var line hidLine = na
    var int  hidLineStart = 0
    var line regLine = na
    var int  regLineStart = 0

    // Track the start of the current positive AO range (the up-leg we are inside)
    var int rangeStart = bar_index
    if not na(osc[1]) and osc[1] < 0 and osc > 0
        rangeStart := bar_index

    float highest1 = findHighestOsc(currLowBar, prevHigh)
    float highest2 = findHighestOsc(rangeStart, 0)

    // Regular bearish divergence: price higher-high + osc lower-high (highest1 > highest2)
    if high[currHigh] > high[prevHigh] and currLowBar < currHighBar and not isHidden
        if highest1 > highest2
            isDivergence := true
            if prevHighBar == regLineStart
                line.delete(regLine)
            regLine := line.new(time[prevHigh], high[prevHigh], time[currHigh], high[currHigh], color = regColor, xloc = xloc.bar_time, width = 1)
            regLineStart := prevHighBar

    // Hidden bearish divergence: price lower-high + osc higher-high (highest1 < highest2)
    if high[currHigh] < high[prevHigh] and currLowBar < currHighBar and isHidden
        if highest1 < highest2
            isDivergence := true
            if prevHighBar == hidLineStart
                line.delete(hidLine)
            hidLine := line.new(time[prevHigh], high[prevHigh], time[currHigh], high[currHigh], color = hidColor, xloc = xloc.bar_time, width = 1)
            hidLineStart := prevHighBar

    isDivergence

// ══════════════════════════════════════════════════════════════════
// STEP 1: Per-bar break detection (CHOCH + BOS)
// Check if THIS bar's price action breaks any structural level.
// CHOCH is checked first because a trend change takes priority
// over trend continuation (BOS).
// ══════════════════════════════════════════════════════════════════
if st.initialized
    // CHOCH CHECK: In a bull trend, if price breaks BELOW the Strong Low,
    // it signals a potential reversal to bearish (Change of Character)
    if st.trend == TREND_BULLISH and not na(st.strong_low)
        if checkBreakBelow(st.strong_low, close, low) and bar_index != st.last_choch_bar
            st.last_choch_bar := bar_index
            processBearishCHOCH(bar_index)

    // CHOCH CHECK: In a bear trend, if price breaks ABOVE the Strong High,
    // it signals a potential reversal to bullish
    if st.trend == TREND_BEARISH and not na(st.strong_high)
        if checkBreakAbove(st.strong_high, close, high) and bar_index != st.last_choch_bar
            st.last_choch_bar := bar_index
            processBullishCHOCH(bar_index)

    // BOS CHECK: In a bull trend, if price breaks ABOVE the last HH (ref_high),
    // the trend is continuing (Break of Structure). Only fires if no BOS is
    // already pending and we're not waiting for CHOCH reference.
    if st.trend == TREND_BULLISH and not na(st.ref_high) and not st.pending_bull_bos and not st.choch_ref_pending
        if checkBreakAbove(st.ref_high, close, high) and bar_index != st.last_bos_bar
            st.last_bos_bar := bar_index
            fireBullishBOS(bar_index)

    // BOS CHECK: In a bear trend, if price breaks BELOW the last LL (ref_low),
    // the trend is continuing
    if st.trend == TREND_BEARISH and not na(st.ref_low) and not st.pending_bear_bos and not st.choch_ref_pending
        if checkBreakBelow(st.ref_low, close, low) and bar_index != st.last_bos_bar
            st.last_bos_bar := bar_index
            fireBearishBOS(bar_index)

// ══════════════════════════════════════════════════════════════════
// STEP 2: Swing detection + classification
// Detect new swings (confirmed swing_length bars ago) and classify
// them using the state machine. Note: Step 1 already ran, so the
// trend state is current. A swing confirmed here uses the latest
// trend direction for classification.
// ══════════════════════════════════════════════════════════════════
bool newSwingAdded = false

if not na(ph)
    int swIdx = addSwing(SWING_HIGH, ph, swingBar)
    if swIdx >= 0 and swIdx < swings.size()
        SwingPoint sw = swings.get(swIdx)
        if sw.cls == CLS_UNCLASSIFIED
            if not st.initialized
                if tryInitialize()
                    st.initialized := true
                    for k = 0 to swings.size() - 1
                        SwingPoint initSw = swings.get(k)
                        initSw.lbl := createSwingLabel(initSw.bar_idx, initSw.price, initSw.swing_type, initSw.cls, 0)
                    if not na(st.strong_low)
                        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                    if not na(st.strong_high)
                        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                    updateZones()
            else
                processSwingInStateMachine(swIdx, bar_index)
                // Skip relabel if processSwingInStateMachine already created a label
                // (e.g., late swing from old trend with specific trend context)
                if na(sw.lbl)
                    relabelSwing(sw, sw.cls, 0)
                // Track internal/major highs for OB mitigation logic
                if sw.cls == CLS_INTERNAL
                    st.last_internal_sh_bar := sw.bar_idx
                    st.last_internal_sh_price := sw.price
                if sw.cls == CLS_INTERNAL or sw.cls == CLS_MAJOR
                    st.last_any_sh_bar := sw.bar_idx
        newSwingAdded := true

if not na(pl)
    int swIdx = addSwing(SWING_LOW, pl, swingBar)
    if swIdx >= 0 and swIdx < swings.size()
        SwingPoint sw = swings.get(swIdx)
        if sw.cls == CLS_UNCLASSIFIED
            if not st.initialized
                if tryInitialize()
                    st.initialized := true
                    for k = 0 to swings.size() - 1
                        SwingPoint initSw = swings.get(k)
                        initSw.lbl := createSwingLabel(initSw.bar_idx, initSw.price, initSw.swing_type, initSw.cls, 0)
                    if not na(st.strong_low)
                        drawStrongLevel(true, st.strong_low_bar, st.strong_low)
                    if not na(st.strong_high)
                        drawStrongLevel(false, st.strong_high_bar, st.strong_high)
                    updateZones()
            else
                processSwingInStateMachine(swIdx, bar_index)
                if na(sw.lbl)
                    relabelSwing(sw, sw.cls, 0)
                // Track internal/major lows for OB mitigation logic
                if sw.cls == CLS_INTERNAL
                    st.last_internal_sl_bar := sw.bar_idx
                    st.last_internal_sl_price := sw.price
                if sw.cls == CLS_INTERNAL or sw.cls == CLS_MAJOR
                    st.last_any_sl_bar := sw.bar_idx
        newSwingAdded := true

// ── STEP 2.5: Order Blocks & Fair Value Gaps ──
detectStandaloneOBs()
detectFVGs()
updateOBMitigation()
updateFVGMitigation()
drawProximityOBs()
drawProximityFVGs()

// ── STEP 3: Liquidity detection ──
// Re-scan for Equal Highs/Lows only when new swings are added (efficiency).
// Sweep detection runs every bar since any bar could sweep a pool.
scanLiquidityPools(newSwingAdded)
checkLiquiditySweeps()

// ── STEP 4: Extend zone right edges to current bar ──
// Zones and strong level lines need to stretch to the right edge of
// the chart on every bar so they remain visible as the chart scrolls.
if not na(st.premium_box)
    box.set_right(st.premium_box, bar_index)
if not na(st.discount_box)
    box.set_right(st.discount_box, bar_index)
if not na(st.ote_box)
    box.set_right(st.ote_box, bar_index)
if not na(st.eq_line)
    line.set_x2(st.eq_line, bar_index)
if not na(st.strong_low_line)
    line.set_x2(st.strong_low_line, bar_index)
if not na(st.strong_high_line)
    line.set_x2(st.strong_high_line, bar_index)

// ── STEP 4.5: KAO Divergence detection ──
// Logic 2 (in-file algorithm) using divCurrHigh/divPrevHigh/divCurrLow/
// divPrevLow that were updated above from kao_lowestBar/kao_highestBar.
// Gate: divPrev* must be populated before calling — otherwise we would
// be diffing against bar 0 (the initial sentinel) and either silently
// fire spurious divergences or, on long charts where bar 0 is outside
// max_bars_back, silently fire none at all.
bool divReady = divPrevLow > 0 and divPrevHigh > 0 and divCurrLow > 0 and divCurrHigh > 0

if i_debug_div and barstate.isconfirmed
    log.info("DIV bar={0} divCurrLow={1} divPrevLow={2} divCurrHigh={3} divPrevHigh={4} divReady={5} osc={6,number,#.######}",
         bar_index, divCurrLow, divPrevLow, divCurrHigh, divPrevHigh, divReady, osc)

if i_div_kao_reg and divReady
    isKernelBearDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, false)
    isKernelBullDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, false)

if i_div_kao_hid and divReady
    isKernelBearDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, true)
    isKernelBullDiv(divCurrHigh, divPrevHigh, divCurrLow, divPrevLow, i_col_div_reg, i_col_div_hid, true)

// ── STEP 5: Trend background color ──
// Subtle green tint when bullish, subtle red tint when bearish.
// Transparency 96 = barely visible, just enough to see the trend at a glance.
bgcolor(st.trend == TREND_BULLISH ? color.new(color.green, 96) : st.trend == TREND_BEARISH ? color.new(color.red, 96) : na)

// ═══════════════════════════════════════════════════════════════════
// ═══ ALERTS                                                     ═══
// ═══════════════════════════════════════════════════════════════════
// Fire alerts only on confirmed bars (barstate.isconfirmed) to prevent
// false alerts from intra-bar price fluctuations. Users can set up
// TradingView alerts on this indicator to get notified of BOS, CHOCH,
// and liquidity sweep events in real-time.

if st.alert_bull_bos and barstate.isconfirmed
    alert("Bullish BOS on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_bear_bos and barstate.isconfirmed
    alert("Bearish BOS on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_bull_choch and barstate.isconfirmed
    alert("Bullish CHoCH on " + syminfo.ticker + " — potential reversal to bullish", alert.freq_once_per_bar_close)
if st.alert_bear_choch and barstate.isconfirmed
    alert("Bearish CHoCH on " + syminfo.ticker + " — potential reversal to bearish", alert.freq_once_per_bar_close)
if st.alert_bsl_sweep and barstate.isconfirmed
    alert("BSL Sweep on " + syminfo.ticker + " — buy-side liquidity swept", alert.freq_once_per_bar_close)
if st.alert_ssl_sweep and barstate.isconfirmed
    alert("SSL Sweep on " + syminfo.ticker + " — sell-side liquidity swept", alert.freq_once_per_bar_close)
if st.alert_ob_bull and barstate.isconfirmed
    alert("Bullish Order Block on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_ob_bear and barstate.isconfirmed
    alert("Bearish Order Block on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_ob_mitigated and barstate.isconfirmed
    alert("Order Block mitigated on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_fvg_bull and barstate.isconfirmed
    alert("Bullish FVG on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_fvg_bear and barstate.isconfirmed
    alert("Bearish FVG on " + syminfo.ticker, alert.freq_once_per_bar_close)
if st.alert_fvg_filled and barstate.isconfirmed
    alert("FVG filled on " + syminfo.ticker, alert.freq_once_per_bar_close)

// ═══════════════════════════════════════════════════════════════════
// ═══ DATA EXPORT (Hidden Plots)                                 ═══
// ═══════════════════════════════════════════════════════════════════
// These plots are invisible on the chart (display.none) but export
// the indicator's internal data so that other Pine Script strategies
// or indicators can read them. This allows building trading systems
// that use the SMC structure data for automated decision-making.

plot(st.trend, "Trend", display = display.none)                  // +1 bullish, -1 bearish, 0 undefined
plot(st.strong_low, "Strong Low", display = display.none)        // CHOCH level in bull trend
plot(st.strong_high, "Strong High", display = display.none)      // CHOCH level in bear trend
plot(st.ref_high, "Ref High", display = display.none)            // BOS level in bull trend (last HH)
plot(st.ref_low, "Ref Low", display = display.none)              // BOS level in bear trend (last LL)
plot(st.equilibrium, "Equilibrium", display = display.none)      // 50% midpoint of range
plot(st.ote_top, "OTE Top", display = display.none)              // Fib 0.618 level
plot(st.ote_bottom, "OTE Bottom", display = display.none)        // Fib 0.786 level
plot(not na(st.equilibrium) ? (close > st.equilibrium ? 1 : -1) : 0, "Zone", display = display.none)  // +1 premium, -1 discount
plot(all_obs.size(), "Active OB Count", display = display.none)
plot(all_fvgs.size(), "Active FVG Count", display = display.none)

// =========================================================
// PLACEHOLDERS (built up by later tasks)
// =========================================================
// =========================================================
// PORTED SECTION 4: Kernel Bollinger Band
// (verbatim from kbb_reference.pine; variable names prefixed kbb_*)
// =========================================================

// ── KBB Inputs ──
string kbb_kernelFastType         = input.string("Rational Quadratic", "KBB Kernel Type", options = ["Rational Quadratic", "Gaussian"], group = "KBB Fast Kernel Settings")
float  kbb_kernelFastWeight       = input.float(8, "KBB Rel Weight", 0, 50, step = 0.2, group = "KBB Fast Kernel Settings")
int    kbb_kernelFastLookback     = input.int(20, "KBB Lookback", 2, 500, group = "KBB Fast Kernel Settings")
int    kbb_kernelFastRegressionStart = input.int(25, "KBB Regression Start", 2, 400, group = "KBB Fast Kernel Settings")
bool   kbb_kernelFastSmooth       = input.bool(true, "KBB Smooth Line", inline = "KBBSmooth", group = "KBB Fast Kernel Settings")
int    kbb_kernelFastSmoothPeriod = input.int(4, "", 2, 200, inline = "KBBSmooth", group = "KBB Fast Kernel Settings")
int    kbb_length                 = input.int(20, minval = 1, title = "KBB Length", group = "KBB Bands")
float  kbb_src                    = input(close, title = "KBB Source", group = "KBB Bands")
float  kbb_mult                   = input.float(2.0, minval = 0.001, maxval = 50, title = "KBB StdDev", group = "KBB Bands")
int    kbb_offset                 = input.int(0, "KBB Offset", minval = -500, maxval = 500, group = "KBB Bands")

// ── KBB Kernel Calculation ──
float kernelFast = switch kbb_kernelFastType
    "Rational Quadratic" => kernels.rationalQuadratic(close, kbb_kernelFastLookback, kbb_kernelFastWeight, kbb_kernelFastRegressionStart)
    "Gaussian"           => kernels.gaussian(close, kbb_kernelFastLookback, kbb_kernelFastRegressionStart)

if kbb_kernelFastSmooth
    kernelFast := ta.sma(kernelFast, kbb_kernelFastSmoothPeriod)

// ── KBB Band Values ──
float kbb_basis = kernelFast
float kbb_dev   = kbb_mult * ta.stdev(kbb_src, kbb_length)
float kbb_upper = kbb_basis + kbb_dev
float kbb_lower = kbb_basis - kbb_dev

plot(kbb_basis, "kbb_basis", color = color.new(color.orange, 0), offset = kbb_offset)
plot(kbb_upper, "kbb_upper", color = color.new(color.aqua,   0), offset = kbb_offset)
plot(kbb_lower, "kbb_lower", color = color.new(color.aqua,   0), offset = kbb_offset)

// =========================================================
// STATE MACHINE — trend, leg extremes, re-entry gate
// =========================================================
// KAO variables used:
//   st.alert_bull_choch  — bullish CHoCH event (bool, true on bar of confirmation)
//                          set inside processBullishCHOCH(), reset each bar at line ~2194
//   st.alert_bear_choch  — bearish CHoCH event
//                          set inside processBearishCHOCH(), reset each bar at line ~2194
//   st.ref_high          — confirmed pivot high price (last HH in bull trend, BOS reference)
//   st.ref_low           — confirmed pivot low price (last LL in bear trend, BOS reference)
// Note: no KAO function modifications needed — flags are accessible at script scope via st.*

var int   trendDir    = 0           // +1 bull, -1 bear, 0 none
var float legHigh     = na
var float legLow      = na
var int   barsInTrend = 0
var bool  armed       = false       // re-entry gate

// Detect major CHoCH events from KAO ported code
bool chochUp   = st.alert_bull_choch
bool chochDown = st.alert_bear_choch

// Trend flip: opposite-direction major CHoCH resets the leg
if chochUp and trendDir != 1
    trendDir    := 1
    legHigh     := high
    legLow      := low
    barsInTrend := 0
    armed       := true
else if chochDown and trendDir != -1
    trendDir    := -1
    legHigh     := high
    legLow      := low
    barsInTrend := 0
    armed       := true
else if trendDir != 0
    legHigh     := math.max(nz(legHigh, high), high)
    legLow      := math.min(nz(legLow, low), low)
    barsInTrend := barsInTrend + 1

float legMid = (legHigh + legLow) / 2.0

// Re-arm logic (only re-arms while flat)
inputReArmExtreme = input.bool(true, "Re-arm on new HH/LL extreme", group = "Strategy")
inputReArmBasis   = input.bool(true, "Re-arm on basis touch",       group = "Strategy")

var float lastLegHigh = na
var float lastLegLow  = na
bool newExtreme       = false
if trendDir == 1 and not na(legHigh) and (na(lastLegHigh) or legHigh > lastLegHigh)
    newExtreme   := true
    lastLegHigh  := legHigh
if trendDir == -1 and not na(legLow) and (na(lastLegLow) or legLow < lastLegLow)
    newExtreme   := true
    lastLegLow   := legLow

bool basisTouch =
     (trendDir == 1  and low  <= kbb_basis) or
     (trendDir == -1 and high >= kbb_basis)

if strategy.position_size == 0 and not armed
    if (inputReArmExtreme and newExtreme) or (inputReArmBasis and basisTouch)
        armed := true

// Diagnostic plots (data window only)
plot(trendDir,    "trendDir",    color = na, display = display.data_window)
plot(legHigh,     "legHigh",     color = na, display = display.data_window)
plot(legLow,      "legLow",      color = na, display = display.data_window)
plot(legMid,      "legMid",      color = na, display = display.data_window)
plot(armed ? 1 : 0, "armed",     color = na, display = display.data_window)
plot(barsInTrend, "barsInTrend", color = na, display = display.data_window)

// Entry logic — Task 9
// Exit logic — Task 11
// Position sizing — Task 12
// Alerts — Task 14
// Visual layer — Task 15
